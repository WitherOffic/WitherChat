<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WitherChat.Desktop.ViewModels"
        xmlns:models="using:WitherChat.Desktop.Models"
        xmlns:controls="using:WitherChat.Desktop.Controls"
        xmlns:chrome="using:Avalonia.Controls.Chrome"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        x:Class="WitherChat.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        mc:Ignorable="d"
        d:DesignWidth="1100"
        d:DesignHeight="760"
        Width="1100"
        Height="760"
        MinWidth="860"
        MinHeight="560"
        Classes="wither-window"
        Classes.reduce-motion="{Binding ReduceMotion}"
        Icon="/Assets/WitherChat.ico"
        Title="WitherChat"
        WindowDecorations="None"
        Win32Properties.WindowCornerPreference="Round"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="42"
        CanResize="True"
        ClipToBounds="True"
        Background="{DynamicResource AppBackgroundBrush}"
        Topmost="{Binding AlwaysOnTop}">

    <Window.Resources>
        <DataTemplate x:Key="FullChatBadgeFallbackTemplate" x:DataType="vm:ChatBadgeItemViewModel">
            <Border Width="18" Height="18" CornerRadius="4"
                    Background="#332D3142" BorderBrush="#66707A94" BorderThickness="1">
                <Grid Margin="2">
                    <Path Data="M7,1 L12.5,3.5 V7.5 C12.5,10.7 10.2,13 7,14 C3.8,13 1.5,10.7 1.5,7.5 V3.5 Z"
                          IsVisible="{Binding IsModerator}"
                          Fill="#FF42D392" Stretch="Uniform" />
                    <Path Data="M4,7 L6.2,9.2 L10.5,4.8"
                          IsVisible="{Binding IsModerator}"
                          Stroke="#FF08150F" StrokeThickness="1.7" StrokeLineCap="Round"
                          StrokeJoin="Round" Stretch="Uniform" />
                    <Path Data="M7,1 L13,5.7 L7,14 L1,5.7 Z"
                          IsVisible="{Binding IsVip}"
                          Fill="#FFE44BB4" Stretch="Uniform" />
                    <Path Data="M7,0.8 L8.8,4.7 L13,5.2 L9.9,8.2 L10.8,12.5 L7,10.4 L3.2,12.5 L4.1,8.2 L1,5.2 L5.2,4.7 Z"
                          IsVisible="{Binding IsSubscription}"
                          Fill="#FFA970FF" Stretch="Uniform" />
                    <Path Data="M1,4 L4.2,7.5 L7,1.5 L9.8,7.5 L13,4 L11.8,12.5 H2.2 Z"
                          IsVisible="{Binding IsBroadcaster}"
                          Fill="#FFFF5A68" Stretch="Uniform" />
                    <Path Data="M8,0.8 L2,8.2 H6 L5.2,14 L12.5,5.5 H8.4 Z"
                          IsVisible="{Binding IsTurbo}"
                          Fill="#FFFFB84D" Stretch="Uniform" />
                    <Path Data="M2,3.2 Q2,1.5 3.7,1.5 H10.3 Q12,1.5 12,3.2 V10.8 Q12,12.5 10.3,12.5 H3.7 Q2,12.5 2,10.8 Z"
                          IsVisible="{Binding IsYouTube}"
                          Fill="#FFFF0033" Stretch="Uniform" />
                    <Path Data="M5.5,4.5 L10,7 L5.5,9.5 Z"
                          IsVisible="{Binding IsYouTube}"
                          Fill="White" Stretch="Uniform" />
                    <Path Data="M7,1 L12.5,4 V10 L7,13 L1.5,10 V4 Z"
                          IsVisible="{Binding IsGeneric}"
                          Stroke="#FF9CA9C8" StrokeThickness="1.4" StrokeJoin="Round"
                          Stretch="Uniform" />
                    <Ellipse Width="4" Height="4"
                             IsVisible="{Binding IsGeneric}"
                             Fill="#FF9CA9C8"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>

    <Grid x:Name="WindowVisualRoot"
          Background="{DynamicResource AppBackgroundBrush}"
          RenderTransformOrigin="50%,50%">
        <Ellipse Width="420" Height="420"
                 HorizontalAlignment="Left" VerticalAlignment="Top"
                 Margin="-220,-240,0,0" Opacity="0.16"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#664A7DFF" Offset="0" />
                    <GradientStop Color="#104A7DFF" Offset="0.62" />
                    <GradientStop Color="#004A7DFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Width="360" Height="360"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom"
                 Margin="0,0,-210,-210" Opacity="0.12"
                 IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush>
                    <GradientStop Color="#6678F0D2" Offset="0" />
                    <GradientStop Color="#1078F0D2" Offset="0.6" />
                    <GradientStop Color="#0078F0D2" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- A quiet, OBS-only caption: identity plus one menu, never the desktop avatar/header. -->
        <Border x:Name="ObsDockToolbar" IsVisible="False" Height="36" Margin="4,0"
                VerticalAlignment="Top" Background="{DynamicResource SurfaceBrush}" ZIndex="10">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="8,0,0,0">
                <StackPanel VerticalAlignment="Center" Spacing="1" ClipToBounds="True">
                    <TextBlock x:Name="ObsDockAccountText" Text="{Binding ObsDockAccountSummary}"
                               FontSize="12" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ObsDockAccountSummary}" />
                    <TextBlock x:Name="ObsDockChannelText" Text="{Binding ObsDockChannelSummary}"
                               FontSize="10" Foreground="{DynamicResource MutedTextBrush}"
                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ObsDockChannelSummary}" />
                </StackPanel>
                <Button x:Name="ObsDockMoreButton" Grid.Column="1" Classes="icon-button"
                        Width="32" Height="32" MinWidth="32" MinHeight="32" Padding="0"
                        AutomationProperties.AutomationId="ObsDockMoreButton"
                        AutomationProperties.Name="{Binding Texts.MoreTools}" ToolTip.Tip="{Binding Texts.MoreTools}">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedRight" FlyoutPresenterClasses="header-tools-flyout">
                            <Border x:Name="ObsDockMenuCard" Width="264" MaxHeight="232"
                                    Background="{DynamicResource MenuSurfaceBrush}" Padding="6"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                                <Grid RowDefinitions="Auto,*">
                                    <TextBlock Text="{Binding Texts.MoreTools}" Margin="8,4,8,6"
                                               FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                                    <ScrollViewer x:Name="ObsDockMenuScrollViewer" Grid.Row="1"
                                                  HorizontalScrollBarVisibility="Disabled"
                                                  VerticalScrollBarVisibility="Auto">
                                        <StackPanel Spacing="1">
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockChannelsButton"
                                            Command="{Binding ToggleChannelEditorCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.Channels}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockConnectButton"
                                            Command="{Binding OpenConnectPanelCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.ConnectTwitch}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockSettingsButton"
                                            Command="{Binding ToggleSettingsCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.Settings}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockFiltersButton"
                                            Command="{Binding ToggleFiltersCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.Filters}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockLogsButton"
                                            Command="{Binding OpenLogsCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.ChatLogs}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Border Height="1" Margin="6,5" Background="{DynamicResource BorderBrush}" />
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockDonationButton"
                                            Command="{Binding OpenDonationWindowCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.OpenDonationWindow}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockClipButton"
                                            ToolTip.Tip="{Binding TwitchClipButtonTip}"
                                            Command="{Binding CreateTwitchClipCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.CreateTwitchClip}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockEventsButton"
                                            Command="{Binding OpenStreamEventsCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.StreamEvents}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockMomentsButton"
                                            Command="{Binding OpenMomentsPanelCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.StreamMoments}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Border Height="1" Margin="6,5" Background="{DynamicResource BorderBrush}" IsVisible="{Binding CanModerateAny}" />
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockModerationButton"
                                            IsVisible="{Binding CanModerateAny}"
                                            Command="{Binding OpenModerationPanelCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.Moderation}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockProtectionButton"
                                            IsVisible="{Binding CanModerate}"
                                            Command="{Binding OpenProtectionPanelCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.StreamProtection}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Border Height="1" Margin="6,5" Background="{DynamicResource BorderBrush}" IsVisible="{Binding CanHeaderDisconnect}" />
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockReconnectButton"
                                            IsVisible="{Binding IsAccountConnected}"
                                            Command="{Binding ReconnectCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding Texts.Reconnect}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                    <Button Classes="header-overflow-item" Height="NaN" MinHeight="34" MinWidth="0" Padding="8,6"
                                            AutomationProperties.AutomationId="ObsDockDisconnectButton"
                                            IsVisible="{Binding CanHeaderDisconnect}"
                                            Command="{Binding HeaderDisconnectCommand}" Click="ObsDockMenuItem_OnClick">
                                        <TextBlock Text="{Binding HeaderDisconnectTip}" TextWrapping="Wrap" FontSize="13" />
                                    </Button>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Grid>
                            </Border>
                        </Flyout>
                    </Button.Flyout>
                    <Path Data="M3,5 H19 M3,11 H19 M3,17 H19" Width="16" Height="16"
                          Stroke="{DynamicResource SecondaryTextBrush}" StrokeThickness="1.6" Stretch="Uniform" />
                </Button>
            </Grid>
        </Border>

        <Border x:Name="TitleBarPanel"
                Height="42"
                VerticalAlignment="Top"
                chrome:WindowDecorationProperties.ElementRole="TitleBar"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1"
                PointerPressed="TitleBar_OnPointerPressed">
            <Grid>
                <Grid ColumnDefinitions="Auto,Auto"
                      HorizontalAlignment="{Binding WindowControlsAlignment}"
                      VerticalAlignment="Center" Margin="15,0">
                    <Grid Grid.Column="{Binding WindowControlsColumn}"
                          VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    FlowDirection="{Binding WindowControlsFlowDirection}"
                                    IsVisible="{Binding UseMacWindowControls}">
                            <Button Classes="traffic" Background="#FFFF5F57"
                                    AutomationProperties.AutomationId="CloseButtonMac"
                                    AutomationProperties.Name="{Binding CloseWindowTip}"
                                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                                    Click="CloseButton_OnClick"
                                    ToolTip.Tip="{Binding CloseWindowTip}" />
                            <Button Classes="traffic" Background="#FFFFBD2E"
                                    AutomationProperties.AutomationId="MinimizeButtonMac"
                                    AutomationProperties.Name="{Binding Texts.Minimize}"
                                    chrome:WindowDecorationProperties.ElementRole="User"
                                    Click="MinimizeButton_OnClick"
                                    ToolTip.Tip="{Binding Texts.Minimize}" />
                            <Button Classes="traffic" Background="#FF28C840"
                                    AutomationProperties.AutomationId="MaximizeButtonMac"
                                    AutomationProperties.Name="{Binding WindowMaximizeTip}"
                                    chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                                    Click="MaximizeButton_OnClick"
                                    ToolTip.Tip="{Binding WindowMaximizeTip}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal"
                                    FlowDirection="{Binding WindowControlsFlowDirection}"
                                    IsVisible="{Binding UseWindowsWindowControls}">
                            <Button Classes="caption close"
                                    AutomationProperties.AutomationId="CloseButtonWindows"
                                    AutomationProperties.Name="{Binding CloseWindowTip}"
                                    chrome:WindowDecorationProperties.ElementRole="CloseButton"
                                    Click="CloseButton_OnClick"
                                    ToolTip.Tip="{Binding CloseWindowTip}">
                                <Path Width="11" Height="11"
                                      Data="M1,1 L10,10 M10,1 L1,10"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.25" Stretch="Uniform" />
                            </Button>
                            <Button Classes="caption"
                                    AutomationProperties.AutomationId="MaximizeButtonWindows"
                                    AutomationProperties.Name="{Binding WindowMaximizeTip}"
                                    chrome:WindowDecorationProperties.ElementRole="MaximizeButton"
                                    Click="MaximizeButton_OnClick"
                                    ToolTip.Tip="{Binding WindowMaximizeTip}">
                                <Grid Width="11" Height="11">
                                <Path IsVisible="{Binding !IsWindowMaximized}"
                                      Data="M1,1 H10 V10 H1 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.1" Stretch="Uniform" />
                                <Path IsVisible="{Binding IsWindowMaximized}"
                                      Data="M1,3 H8 V10 H1 Z M3,1 H10 V8 H8 M3,3 V1"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.1" Stretch="Uniform" />
                                </Grid>
                            </Button>
                            <Button Classes="caption"
                                    AutomationProperties.AutomationId="MinimizeButtonWindows"
                                    AutomationProperties.Name="{Binding Texts.Minimize}"
                                    chrome:WindowDecorationProperties.ElementRole="User"
                                    Click="MinimizeButton_OnClick"
                                    ToolTip.Tip="{Binding Texts.Minimize}">
                                <Path Width="11" Height="1"
                                      Data="M0,0.5 H11"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                      StrokeThickness="1.1" Stretch="Fill" />
                            </Button>
                        </StackPanel>
                    </Grid>
                    <Button x:Name="CompactModeButton"
                            Grid.Column="{Binding CompactButtonColumn}"
                            Classes="icon-button"
                            chrome:WindowDecorationProperties.ElementRole="User"
                            AutomationProperties.AutomationId="CompactModeButton"
                            AutomationProperties.Name="{Binding CompactModeTip}"
                            Width="30" Height="28" MinWidth="30" MinHeight="28"
                            Margin="{Binding CompactButtonMargin}" Padding="0"
                            Click="CompactModeButton_OnClick"
                            ToolTip.Tip="{Binding CompactModeTip}">
                        <Grid Width="17" Height="17">
                            <Path IsVisible="{Binding !IsCompactMode}"
                                  Data="M2,2 L7,7 M7,3 V7 H3 M18,2 L13,7 M13,3 V7 H17 M2,18 L7,13 M3,13 H7 V17 M18,18 L13,13 M17,13 H13 V17"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.65" StrokeLineCap="Round"
                                  StrokeJoin="Round" Stretch="Uniform" />
                            <Path IsVisible="{Binding IsCompactMode}"
                                  Data="M7,7 L2,2 M3,7 H7 V3 M13,7 L18,2 M13,3 V7 H17 M7,13 L2,18 M3,13 H7 V17 M13,13 L18,18 M13,17 V13 H17"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.65" StrokeLineCap="Round"
                                  StrokeJoin="Round" Stretch="Uniform" />
                        </Grid>
                    </Button>
                </Grid>
                <TextBlock Text="WitherChat"
                           IsVisible="{Binding !IsCompactMode}"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           FontSize="12"
                           FontWeight="SemiBold"
                           IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Border BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                IsHitTestVisible="False" />

        <Grid x:Name="ChatLayoutRoot"
              Margin="{Binding ChatLayoutMargin}"
              RowDefinitions="Auto,Auto,Auto,10,*,Auto,Auto">
            <Border x:Name="HeaderPanel"
                    Grid.Row="0" Classes="card" Padding="12,8"
                    IsVisible="{Binding ShowHeaderPanel}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Button Grid.Column="0"
                            Classes="header-account"
                            AutomationProperties.AutomationId="ChannelSwitcherButton"
                            AutomationProperties.Name="{Binding Texts.Channels}"
                            Command="{Binding ToggleChannelEditorCommand}"
                            ToolTip.Tip="{Binding Texts.Channels}">
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="30" Height="30" Margin="0,0,8,0">
                                <Border CornerRadius="15"
                                        Background="{DynamicResource ButtonBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1">
                                    <TextBlock Text="{Binding AvatarInitial}"
                                               FontSize="13" FontWeight="SemiBold"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                                <Image Source="{Binding HeaderProfileImageResource.Image}"
                                       IsVisible="{Binding HeaderProfileImageResource.HasImage}"
                                       Width="30" Height="30" Stretch="UniformToFill">
                                    <Image.Clip>
                                        <EllipseGeometry Center="15,15" RadiusX="15" RadiusY="15" />
                                    </Image.Clip>
                                </Image>
                            </Grid>
                            <StackPanel Margin="0,0,4,0" Spacing="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HeaderTitle}"
                                           FontSize="16" FontWeight="SemiBold"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           MaxWidth="180"
                                           TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Text="{Binding HeaderSubtitle}"
                                               FontSize="10"
                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                               MaxWidth="105"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding ActiveChannelLabel}"
                                               FontSize="10"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               MaxWidth="135"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Text="{Binding SharedChatStatusLabel}"
                                           IsVisible="{Binding IsSharedChatActive}"
                                           FontSize="10"
                                           Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <Border Grid.Column="1" Classes="status-strip"
                            AutomationProperties.AutomationId="HeaderStatusStrip"
                            HorizontalAlignment="Center" VerticalAlignment="Center"
                            Margin="10,0">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        ToolTip.Tip="{Binding StatusDetail}">
                                <Grid Width="13" Height="8" VerticalAlignment="Center">
                                    <Ellipse Width="6" Height="6" HorizontalAlignment="Left"
                                             Fill="{Binding ApiConnectionBrush}"
                                             ToolTip.Tip="{Binding AuthStatus}" />
                                    <Ellipse Width="6" Height="6" HorizontalAlignment="Right"
                                             Fill="{Binding ConnectionBrush}"
                                             ToolTip.Tip="{Binding StatusDetail}" />
                                </Grid>
                                <TextBlock Text="Twitch" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}" />
                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        ToolTip.Tip="{Binding StatusDetail}">
                                <Ellipse Width="6" Height="6" Fill="{Binding StreamIndicatorBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="{Binding StreamStatusText}"
                                           FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <TextBlock Text="{Binding StreamViewerText}"
                                           IsVisible="{Binding IsStreamLive}"
                                           FontSize="11" Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Border Width="1" Height="16" Background="{DynamicResource BorderBrush}"
                                    IsVisible="{Binding IsYouTubeConnected}" />
                            <StackPanel Orientation="Horizontal" Spacing="5"
                                        IsVisible="{Binding IsYouTubeConnected}"
                                        ToolTip.Tip="{Binding YouTubeStatus}">
                                <Ellipse Width="6" Height="6" Fill="{Binding YouTubeStatusBrush}"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="YouTube" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Classes="header-tools-strip"
                            AutomationProperties.AutomationId="HeaderToolsStrip">
                    <StackPanel x:Name="HeaderToolsPanel"
                                Orientation="Horizontal"
                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                Spacing="2">
                        <Button Classes="icon-button"
                                AutomationProperties.AutomationId="ChatLogsButton"
                                AutomationProperties.Name="{Binding Texts.ChatLogs}"
                                Command="{Binding OpenLogsCommand}"
                                ToolTip.Tip="{Binding Texts.ChatLogs}">
                            <Path Data="M4,5 H20 V16 H10 L6,19 V16 H4 Z M8,9 H16 M8,12 H14"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  StrokeJoin="Round" Stretch="Uniform"
                                  RenderTransform="translate(0px, 2px)"
                                  Width="17" Height="17" />
                        </Button>
                        <Button Classes="icon-button"
                                AutomationProperties.AutomationId="CreateTwitchClipButton"
                                AutomationProperties.Name="{Binding TwitchClipButtonTip}"
                                IsVisible="{Binding IsAccountConnected}"
                                Command="{Binding CreateTwitchClipCommand}"
                                ToolTip.Tip="{Binding TwitchClipButtonTip}">
                            <Grid Width="18" Height="18">
                                <Path Data="M3,7 H21 V20 H3 Z M3,7 L6,2 H21 L18,7 Z M8,2 L5,7 M13,2 L10,7 M18,2 L15,7 M8,11 H16 M8,15 H14"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.45" StrokeLineCap="Round"
                                      StrokeJoin="Round" Stretch="Uniform" />
                                <Ellipse Width="6" Height="6" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Fill="{DynamicResource WarningBrush}"
                                         IsVisible="{Binding IsCreatingTwitchClip}" />
                            </Grid>
                        </Button>
                        <Button Classes="icon-button"
                                AutomationProperties.AutomationId="DonationAlertsButton"
                                AutomationProperties.Name="{Binding Texts.OpenDonationWindow}"
                                Command="{Binding OpenDonationWindowCommand}"
                                ToolTip.Tip="{Binding Texts.OpenDonationWindow}">
                            <Grid Width="20" Height="20">
                                <controls:DonationAlertsLogo Width="20" Height="20"
                                                             RenderTransform="translate(1px, 0px)" />
                                <Ellipse Width="7" Height="7" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Fill="#FF5C70"
                                         IsVisible="{Binding HasCurrentDonation}" />
                            </Grid>
                        </Button>
                        <Button Classes="primary"
                                AutomationProperties.AutomationId="ConnectButton"
                                IsVisible="{Binding CanAuthorize}"
                                Command="{Binding OpenConnectPanelCommand}"
                                Content="{Binding Texts.ConnectTwitch}" />
                        <Button Classes="primary"
                                IsVisible="{Binding IsAuthorizing}"
                                Command="{Binding CancelAuthorizationCommand}"
                                Content="{Binding Texts.CancelSignIn}" />
                        <Button Classes="icon-button"
                                AutomationProperties.AutomationId="FiltersButton"
                                AutomationProperties.Name="{Binding Texts.Filters}"
                                IsVisible="{Binding HasActiveChannel}"
                                Command="{Binding ToggleFiltersCommand}"
                                ToolTip.Tip="{Binding Texts.Filters}">
                            <Path Data="M10.5,4 A6.5,6.5 0 1 0 10.5,17 A6.5,6.5 0 1 0 10.5,4 M15.2,15.2 L20,20"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.65" StrokeLineCap="Round"
                                  StrokeJoin="Round" Stretch="Uniform"
                                  Width="17" Height="17" />
                        </Button>
                        <Button x:Name="HeaderMoreToolsButton"
                                Classes="icon-button"
                                AutomationProperties.AutomationId="HeaderMoreToolsButton"
                                AutomationProperties.Name="{Binding Texts.MoreTools}"
                                ToolTip.Tip="{Binding Texts.MoreTools}">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedRight"
                                        FlyoutPresenterClasses="header-tools-flyout">
                                    <Border x:Name="HeaderMoreToolsCard"
                                            Background="{DynamicResource MenuSurfaceBrush}"
                                            BorderBrush="{DynamicResource JumpLatestGlassBorderBrush}"
                                            BorderThickness="1" CornerRadius="16" Padding="7"
                                            RenderTransformOrigin="100%,0%"
                                            BoxShadow="0 16 38 2 #78000000">
                                        <StackPanel Spacing="3">
                                            <Button Classes="header-overflow-item" IsVisible="{Binding IsObsDockMode}"
                                                    AutomationProperties.AutomationId="ObsDockDonationMenuItem"
                                                    Content="{Binding Texts.OpenDonationWindow}" Command="{Binding OpenDonationWindowCommand}"
                                                    Click="HeaderMoreTool_OnClick" />
                                            <Button Classes="header-overflow-item" IsVisible="{Binding IsObsDockMode}"
                                                    AutomationProperties.AutomationId="ObsDockClipMenuItem"
                                                    Content="{Binding Texts.CreateTwitchClip}" ToolTip.Tip="{Binding TwitchClipButtonTip}"
                                                    Command="{Binding CreateTwitchClipCommand}"
                                                    Click="HeaderMoreTool_OnClick" />
                                            <TextBlock Text="{Binding Texts.MoreTools}"
                                                       Margin="10,5,10,4" FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <Button Classes="header-overflow-item"
                                                    AutomationProperties.AutomationId="MoreStreamEventsItem"
                                                    Command="{Binding OpenStreamEventsCommand}"
                                                    Click="HeaderMoreTool_OnClick">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="9"
                                                      VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="14"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="#1F9F8CFF">
                                                        <Path Data="M9,2 C6.4,2 4.5,4 4.5,6.8 V10.5 L2.8,13 H15.2 L13.5,10.5 V6.8 C13.5,4 11.6,2 9,2 M7,15 H11"
                                                              Stroke="{DynamicResource AccentBrush}"
                                                              StrokeThickness="1.35" StrokeLineCap="Round"
                                                              StrokeJoin="Round" Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Texts.StreamEvents}"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                                </Grid>
                                            </Button>
                                            <Button Classes="header-overflow-item"
                                                    AutomationProperties.AutomationId="MoreProtectionItem"
                                                    IsVisible="{Binding CanModerate}"
                                                    Command="{Binding OpenProtectionPanelCommand}"
                                                    Click="HeaderMoreTool_OnClick">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="9"
                                                      VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="14"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="#1F6FE7B4">
                                                        <Path Data="M12,2 L20,5 V10 C20,15.2 16.8,19 12,21 C7.2,19 4,15.2 4,10 V5 Z M13,5 L8,12 H12 L11,18 L16,10 H12 Z"
                                                              Stroke="{DynamicResource SuccessBrush}"
                                                              StrokeThickness="1.45" StrokeJoin="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Width="16" Height="16" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Texts.StreamProtection}"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                                </Grid>
                                            </Button>
                                            <Button Classes="header-overflow-item"
                                                    AutomationProperties.AutomationId="MoreStreamMomentsItem"
                                                    Command="{Binding OpenMomentsPanelCommand}"
                                                    Click="HeaderMoreTool_OnClick">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="9"
                                                      VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="14"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="#22F6C85F">
                                                        <Path Data="M3.5,1 H12.5 V15 L8,11.5 L3.5,15 Z"
                                                              Stroke="{DynamicResource WarningBrush}" StrokeThickness="1.5"
                                                              StrokeJoin="Round" Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Stretch="None" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Texts.StreamMoments}"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                                </Grid>
                                            </Button>
                                            <Button Classes="header-overflow-item"
                                                    AutomationProperties.AutomationId="MoreModerationItem"
                                                    IsVisible="{Binding CanModerateAny}"
                                                    Command="{Binding OpenModerationPanelCommand}"
                                                    Click="HeaderMoreTool_OnClick">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="9"
                                                      VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="14"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="#207DB4FF">
                                                        <Path Data="M12,3 L20,6 V11 C20,16 16.5,19.5 12,21 C7.5,19.5 4,16 4,11 V6 Z M9,12 L11,14 L15.5,9"
                                                              Stroke="#7DB4FF" StrokeThickness="1.6"
                                                              StrokeLineCap="Round" StrokeJoin="Round"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Width="16" Height="16" Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Texts.Moderation}"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                                </Grid>
                                            </Button>
                                            <Border Height="1" Margin="9,4"
                                                    IsVisible="{Binding CanHeaderDisconnect}"
                                                    Background="{DynamicResource BorderBrush}" />
                                            <Button Classes="header-overflow-item"
                                                    AutomationProperties.AutomationId="MoreReconnectItem"
                                                    IsVisible="{Binding IsAccountConnected}"
                                                    Command="{Binding ReconnectCommand}"
                                                    Click="HeaderMoreTool_OnClick">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="9"
                                                      VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="14"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="{DynamicResource JumpLatestGlassBrush}">
                                                        <Path Data="M19,8 A8,8 0 1 0 20,14 M19,4 V9 H14"
                                                              Stroke="{DynamicResource SecondaryTextBrush}"
                                                              StrokeThickness="1.55" StrokeLineCap="Round"
                                                              StrokeJoin="Round" Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding Texts.Reconnect}"
                                                               VerticalAlignment="Center" FontWeight="SemiBold" />
                                                </Grid>
                                            </Button>
                                            <Button Classes="header-overflow-item"
                                                    AutomationProperties.AutomationId="MoreDisconnectItem"
                                                    IsVisible="{Binding CanHeaderDisconnect}"
                                                    Command="{Binding HeaderDisconnectCommand}"
                                                    Click="HeaderMoreTool_OnClick">
                                                <Grid ColumnDefinitions="30,*" ColumnSpacing="9"
                                                      VerticalAlignment="Center">
                                                    <Border Width="28" Height="28" CornerRadius="14"
                                                            HorizontalAlignment="Center" VerticalAlignment="Center"
                                                            Background="#20FF6B7A">
                                                        <Path Data="M5,4 H12 V8 M12,16 V20 H5 Z M10,12 H21 M17,8 L21,12 L17,16"
                                                              Stroke="{DynamicResource DangerBrush}"
                                                              StrokeThickness="1.55" StrokeLineCap="Round"
                                                              StrokeJoin="Round" Width="16" Height="16"
                                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                                              Stretch="Uniform" />
                                                    </Border>
                                                    <TextBlock Grid.Column="1" Text="{Binding HeaderDisconnectTip}"
                                                               VerticalAlignment="Center" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource DangerBrush}" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </Flyout>
                            </Button.Flyout>
                            <Grid Width="18" Height="18">
                                <StackPanel Orientation="Horizontal" Spacing="3"
                                            HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <Ellipse Width="3" Height="3" Fill="{DynamicResource SecondaryTextBrush}" />
                                    <Ellipse Width="3" Height="3" Fill="{DynamicResource SecondaryTextBrush}" />
                                    <Ellipse Width="3" Height="3" Fill="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Ellipse Width="6" Height="6" HorizontalAlignment="Right"
                                         VerticalAlignment="Top" Fill="{DynamicResource DonationAccentBrush}"
                                         IsVisible="{Binding HasHeaderOverflowActivity}" />
                            </Grid>
                        </Button>
                        <Button Classes="icon-button"
                                AutomationProperties.AutomationId="SettingsButton"
                                AutomationProperties.Name="{Binding Texts.Settings}"
                                Command="{Binding ToggleSettingsCommand}"
                                ToolTip.Tip="{Binding Texts.Settings}">
                            <Path Data="M4,7 H8 M12,7 H20 M10,5 V9 M4,12 H14 M18,12 H20 M16,10 V14 M4,17 H6 M10,17 H20 M8,15 V19"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.65" StrokeLineCap="Round"
                                  StrokeJoin="Round" Stretch="Uniform"
                                  Width="17" Height="17" />
                        </Button>
                    </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Button Grid.Row="1" Classes="panel-toggle"
                    AutomationProperties.AutomationId="HeaderToggleButton"
                    AutomationProperties.Name="{Binding HeaderToggleTip}"
                    HorizontalAlignment="Center" Margin="0,2"
                    Click="HeaderToggleButton_OnClick"
                    IsVisible="{Binding ShowHeaderToggle}"
                    ToolTip.Tip="{Binding HeaderToggleTip}">
                <Grid Width="16" Height="10">
                    <Path IsVisible="{Binding IsHeaderExpanded}"
                          Data="M2,8 L8,2 L14,8"
                          Stroke="{DynamicResource SecondaryTextBrush}"
                          StrokeThickness="1.8" StrokeLineCap="Round"
                          StrokeJoin="Round" />
                    <Path IsVisible="{Binding !IsHeaderExpanded}"
                          Data="M2,2 L8,8 L14,2"
                          Stroke="{DynamicResource SecondaryTextBrush}"
                          StrokeThickness="1.8" StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Grid>
            </Button>

            <Border x:Name="MainFiltersPanel" Grid.Row="2" Classes="subtle-card" Padding="10"
                    Margin="0,2,0,0"
                    IsVisible="{Binding IsFiltersVisible}">
                <ScrollViewer x:Name="MainFiltersScrollViewer" HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Disabled">
                <StackPanel Spacing="8">
                    <WrapPanel VerticalAlignment="Center">
                        <TextBox x:Name="MainMessageSearchBox" Width="240" Height="40" Margin="0,0,10,0"
                                 AutomationProperties.AutomationId="MessageSearchInput"
                                 AutomationProperties.Name="{Binding Texts.SearchMessages}"
                                 Text="{Binding MessageSearchText}"
                                 PlaceholderText="{Binding Texts.SearchMessages}" />
                        <TextBox x:Name="MainUserFilterBox" Width="170" Height="40" Margin="0,0,10,0"
                                 AutomationProperties.AutomationId="UserFilterInput"
                                 AutomationProperties.Name="{Binding Texts.FilterByUser}"
                                 Text="{Binding UserFilter}"
                                 PlaceholderText="{Binding Texts.FilterByUser}" />
                        <Button Classes="tool" Content="A-" Margin="0,0,6,0"
                                AutomationProperties.Name="{Binding Texts.DecreaseFont}"
                                Command="{Binding DecreaseChatFontSizeCommand}"
                                ToolTip.Tip="{Binding Texts.DecreaseFont}" />
                        <Button Classes="tool" Content="A+" Margin="0,0,10,0"
                                AutomationProperties.Name="{Binding Texts.IncreaseFont}"
                                Command="{Binding IncreaseChatFontSizeCommand}"
                                ToolTip.Tip="{Binding Texts.IncreaseFont}" />
                        <CheckBox Content="{Binding Texts.TimeShort}"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding ShowTimestamps}"
                                  Margin="0,0,10,0" />
                        <Button Classes="tool" Content="{Binding Texts.ClearMessages}"
                                Command="{Binding ClearMessagesCommand}" />
                    </WrapPanel>
                    <ScrollViewer x:Name="SmartChatFiltersPanel"
                                  HorizontalScrollBarVisibility="Hidden"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{Binding Texts.SmartChatFilters}"
                                       VerticalAlignment="Center" Margin="2,0,4,0"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       ToolTip.Tip="{Binding Texts.SmartChatHelp}" />
                            <Button x:Name="SmartChatHelpButton" Classes="context-help"
                                    Content="?" Command="{Binding StartContextTutorialCommand}"
                                    CommandParameter="SmartChat"
                                    ToolTip.Tip="{Binding Texts.OpenSmartChatTutorial}"
                                    AutomationProperties.Name="{Binding Texts.OpenSmartChatTutorial}" />
                            <Button Classes="moderation-tab" Classes.selected="{Binding IsSmartChatAllSelected}"
                                    AutomationProperties.AutomationId="SmartChatAllButton"
                                    Content="{Binding Texts.SmartChatAll}" Command="{Binding SetChatViewModeCommand}" CommandParameter="0" />
                            <Button Classes="moderation-tab" Classes.selected="{Binding IsSmartChatQuestionsSelected}"
                                    AutomationProperties.AutomationId="SmartChatQuestionsButton"
                                    Content="{Binding Texts.SmartChatQuestions}" Command="{Binding SetChatViewModeCommand}" CommandParameter="1" />
                            <Button Classes="moderation-tab" Classes.selected="{Binding IsSmartChatMentionsSelected}"
                                    Content="{Binding Texts.SmartChatMentions}" Command="{Binding SetChatViewModeCommand}" CommandParameter="2" />
                            <Button Classes="moderation-tab" Classes.selected="{Binding IsSmartChatPaidSelected}"
                                    Content="{Binding Texts.SmartChatPaid}" Command="{Binding SetChatViewModeCommand}" CommandParameter="3" />
                            <Button Classes="moderation-tab" Classes.selected="{Binding IsSmartChatFirstSelected}"
                                    Content="{Binding Texts.SmartChatFirst}" Command="{Binding SetChatViewModeCommand}" CommandParameter="4" />
                            <Button Classes="moderation-tab" Classes.selected="{Binding IsSmartChatSuspiciousSelected}"
                                    Content="{Binding Texts.SmartChatSuspicious}" Command="{Binding SetChatViewModeCommand}" CommandParameter="5" />
                            <Button Classes="moderation-tab" Classes.selected="{Binding IsSmartChatRolesSelected}"
                                    Content="{Binding Texts.SmartChatRoles}" Command="{Binding SetChatViewModeCommand}" CommandParameter="6" />
                        </StackPanel>
                    </ScrollViewer>
                </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="ChatViewportCard"
                    Grid.Row="4" Classes="card" Padding="8"
                    AutomationProperties.AutomationId="ChatViewportCard">
                <Grid RowDefinitions="Auto,Auto,*">
                    <Border x:Name="PinnedMessageCard"
                            AutomationProperties.AutomationId="PinnedMessageCard"
                            Grid.Row="0"
                            IsVisible="{Binding ShowPinnedMessageCard}"
                            Margin="2,1,2,8" Padding="12,9"
                            CornerRadius="10"
                            Background="{DynamicResource ButtonBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1">
                        <Grid ColumnDefinitions="28,*">
                            <Path Grid.Column="0" Width="16" Height="16"
                                  HorizontalAlignment="Left" VerticalAlignment="Top"
                                  Margin="2,2,0,0"
                                  Data="M11,1 L15,5 L13,7 L16,10 L15,11 L11,8 L7,12 L8,16 L7,17 L5,13 L1,9 L2,8 L6,9 L10,5 L7,2 L8,1 Z"
                                  Fill="{DynamicResource AccentBrush}" Stretch="Uniform" />
                            <StackPanel Grid.Column="1">
                                <WrapPanel x:Name="PinnedHeaderPanel" Orientation="Horizontal">
                                    <TextBlock x:Name="PinnedMessageLabel" Text="{Binding Texts.PinnedMessage}"
                                               Margin="0,0,8,0"
                                               MaxWidth="{Binding #PinnedHeaderPanel.Bounds.Width}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock x:Name="PinnedMessageAuthorLabel" Text="{Binding PinnedCardAuthor}"
                                               MaxWidth="{Binding #PinnedHeaderPanel.Bounds.Width}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding PinnedCardAuthor}"
                                               FontWeight="SemiBold" />
                                </WrapPanel>
                                <TextBlock Text="{Binding PinnedCardText}"
                                           Foreground="{DynamicResource PrimaryTextBrush}"
                                           TextWrapping="Wrap"
                                           TextTrimming="CharacterEllipsis"
                                           MaxHeight="42" Margin="0,3,0,0"
                                           ToolTip.Tip="{Binding PinnedCardText}" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <ListBox x:Name="MessagesList"
                             Grid.Row="2"
                             Classes="chat-list"
                             Classes.compact="{Binding IsCompactMode}"
                             ItemsSource="{Binding VisibleMessages}"
                             IsVisible="{Binding ShowCombinedMessageList}"
                             SelectionMode="Single"
                             SelectionChanged="MessagesList_OnSelectionChanged"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.IsScrollChainingEnabled="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:ChatMessageItemViewModel">
                                <Grid RowDefinitions="Auto,Auto"
                                      ColumnDefinitions="Auto,Auto,Auto,*"
                                      Background="Transparent"
                                      VerticalAlignment="Center"
                                      PointerPressed="MessageRow_OnPointerPressed">
                                    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.ColumnSpan="4"
                                          ZIndex="5"
                                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowFullChatMetadata}">
                                        <Border IsVisible="{Binding IsSystemEvent}"
                                                Margin="0,1"
                                                Padding="10,8"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="3,1,1,1"
                                                CornerRadius="9">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,8,*,Auto">
                                            <Border Padding="5,2" CornerRadius="5"
                                                    Background="#334A7DFF"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="{Binding SystemEventPlatformMark}"
                                                           FontSize="8" FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                            <Grid Grid.Column="2" ColumnDefinitions="Auto,7,*">
                                                <TextBlock Text="{Binding SystemEventTitle}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Grid.Column="2" Text="{Binding UserLabel}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{Binding UserBrush}" />
                                            </Grid>
                                            <TextBlock Grid.Column="3" Text="{Binding SystemEventAmount}"
                                                       IsVisible="{Binding HasSystemEventAmount}"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource DonationAccentBrush}" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                                       Text="{Binding Text}"
                                                       IsVisible="{Binding HasText}"
                                                       Margin="0,4,0,0"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </Grid>
                                    <Grid.ContextMenu>
                                        <ContextMenu MinWidth="325"
                                                     MaxWidth="380"
                                                     Classes="viewer-menu"
                                                     Background="{DynamicResource PopupBrush}"
                                                     BorderBrush="{DynamicResource BorderStrongBrush}"
                                                     BorderThickness="1"
                                                     CornerRadius="14"
                                                     Padding="7"
                                                     Opening="MessageContextMenu_OnOpening"
                                                     Closing="MessageContextMenu_OnClosing">
                                            <ContextMenu.Styles>
                                                <Style Selector="MenuItem.viewer-profile-host">
                                                    <Setter Property="Padding" Value="2" />
                                                    <Setter Property="Margin" Value="0,0,0,5" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="MenuItem.viewer-action">
                                                    <Setter Property="MinHeight" Value="39" />
                                                    <Setter Property="Padding" Value="11,8" />
                                                    <Setter Property="Margin" Value="0,1" />
                                                    <Setter Property="CornerRadius" Value="9" />
                                                    <Setter Property="FontSize" Value="14" />
                                                    <Setter Property="Background" Value="Transparent" />
                                                </Style>
                                                <Style Selector="MenuItem.viewer-action:pointerover">
                                                    <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                </Style>
                                                <Style Selector="Separator.viewer-separator">
                                                    <Setter Property="Margin" Value="9,6" />
                                                    <Setter Property="Background" Value="{DynamicResource BorderStrongBrush}" />
                                                </Style>
                                            </ContextMenu.Styles>
                                            <MenuItem Classes="viewer-profile-host"
                                                      IsHitTestVisible="False">
                                                <MenuItem.Header>
                                                    <Border MinWidth="295"
                                                            AutomationProperties.AutomationId="MessageViewerProfileCard"
                                                            Background="{DynamicResource SurfaceRaisedBrush}"
                                                            BorderBrush="{DynamicResource BorderStrongBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="12"
                                                            Padding="12">
                                                        <Grid ColumnDefinitions="46,12,*">
                                                            <Border Width="46" Height="46" CornerRadius="23"
                                                                    Background="{DynamicResource ButtonBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    ClipToBounds="True">
                                                                <Grid>
                                                                    <TextBlock Text="{Binding AvatarInitial}"
                                                                               HorizontalAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="15"
                                                                               Foreground="{Binding UserBrush}" />
                                                                    <Image Source="{Binding ProfileImageResource.Image}"
                                                                           IsVisible="{Binding ProfileImageResource.HasImage}"
                                                                           Stretch="UniformToFill" />
                                                                </Grid>
                                                            </Border>
                                                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="3">
                                                                <StackPanel Orientation="Horizontal" Spacing="7">
                                                                    <TextBlock Text="{Binding UserLabel}"
                                                                               Foreground="{Binding UserBrush}"
                                                                               FontWeight="SemiBold"
                                                                               FontSize="14"
                                                                               VerticalAlignment="Center" />
                                                                    <ItemsControl ItemsSource="{Binding Badges}"
                                                                                  IsVisible="{Binding HasBadges}"
                                                                                  VerticalAlignment="Center">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <StackPanel Orientation="Horizontal" Spacing="3" />
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:ChatBadgeItemViewModel">
                                                                                <Image Source="{Binding ImageResource.Image}"
                                                                                       IsVisible="{Binding ImageResource.HasImage}"
                                                                                       Width="18" Height="18"
                                                                                       Stretch="Uniform"
                                                                                       AutomationProperties.Name="{Binding ToolTip}"
                                                                                       ToolTip.Tip="{Binding ToolTip}" />
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding LoginLabel}"
                                                                           FontSize="12"
                                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <Separator x:Name="MessageModerationSeparator"
                                                       Classes="viewer-separator"
                                                       IsVisible="{Binding Owner.CanModerateAny}" />
                                            <MenuItem x:Name="MessageDeleteMenuItem"
                                                      Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.DeleteMessage}"
                                                      IsVisible="{Binding Owner.CanModerateAny}"
                                                      Command="{Binding Owner.DeleteMessageCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M4,5 H16 M7,5 V3 H13 V5 M6,7 L7,17 H13 L14,7 M9,9 V15 M11,9 V15"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.5" StrokeLineCap="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="MessageBanMenuItem"
                                                      Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.BanUser}"
                                                      IsVisible="{Binding Owner.CanModerateAny}"
                                                      Command="{Binding Owner.BanUserCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M4,4 L16,16 M16,4 L4,16"
                                                          Stroke="{DynamicResource DangerBrush}"
                                                          StrokeThickness="1.8" StrokeLineCap="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="MessageTimeoutMenuItem"
                                                      Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.TimeoutTen}"
                                                      IsVisible="{Binding Owner.CanModerateAny}"
                                                      Command="{Binding Owner.TimeoutTenMinutesCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M10,3 A7,7 0 1 1 9.99,3 M10,6 V10 L13,12"
                                                          Stroke="{DynamicResource DangerBrush}"
                                                          StrokeThickness="1.6" StrokeLineCap="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="MessageCustomTimeoutMenuItem"
                                                      Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.CustomTimeout}"
                                                      IsVisible="{Binding Owner.CanModerateAny}"
                                                      Command="{Binding Owner.CustomTimeoutCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M10,3 A7,7 0 1 1 9.99,3 M10,6 V10 L14,10"
                                                          Stroke="{DynamicResource DangerBrush}"
                                                          StrokeThickness="1.6" StrokeLineCap="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem x:Name="MessageRemovePunishmentMenuItem"
                                                      Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.RemovePunishment}"
                                                      IsVisible="{Binding Owner.CanModerateAny}"
                                                      Command="{Binding Owner.RemovePunishmentCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M4,10 L8,14 L16,5"
                                                          Stroke="{DynamicResource SuccessBrush}"
                                                          StrokeThickness="1.8" StrokeLineCap="Round" StrokeJoin="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <Separator Classes="viewer-separator" />
                                            <MenuItem Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.RecentMessages}"
                                                      Command="{Binding Owner.ShowRecentMessagesCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M3,4 H17 V14 H8 L4,17 V14 H3 Z M6,7 H14 M6,10 H12"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.3" StrokeLineCap="Round" StrokeJoin="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.CopyUsername}"
                                                      Command="{Binding Owner.CopyUsernameCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M10,10 A4,4 0 1 0 9.99,10 M3,18 C3,14 6,12 10,12 C14,12 17,14 17,18"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.4" StrokeLineCap="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.CopyMessage}"
                                                      Command="{Binding Owner.CopyMessageCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M7,6 H16 V17 H7 Z M4,14 H3 V3 H12 V5"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.4" StrokeJoin="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Classes="viewer-action"
                                                      Header="{Binding Owner.Texts.SaveStreamMoment}"
                                                      Command="{Binding Owner.BeginSaveMomentCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M5,3 H15 V18 L10,14 L5,18 Z"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="1.5" StrokeJoin="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem Classes="viewer-action"
                                                      Header="{Binding OpenUserProfileLabel}"
                                                      Command="{Binding Owner.OpenUserOnTwitchCommand}"
                                                      CommandParameter="{Binding}">
                                                <MenuItem.Icon>
                                                    <Path Data="M8,4 H4 V16 H16 V12 M10,3 H17 V10 M17,3 L8,12"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.4" StrokeLineCap="Round" StrokeJoin="Round" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Grid.ContextMenu>
                                    <Grid Grid.Row="0" Grid.ColumnSpan="4"
                                          AutomationProperties.AutomationId="FullMessageReplyHost"
                                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowFullChatMetadata}">
                                        <Border Classes="reply-preview"
                                                IsVisible="{Binding HasReply}"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="2,0,0,0"
                                                CornerRadius="7" Padding="8,5" Margin="0,0,0,5">
                                        <ToolTip.Tip>
                                            <StackPanel MaxWidth="360" Spacing="5">
                                                <TextBlock Text="{Binding ReplyLabel}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource AccentBrush}" />
                                                <TextBlock Text="{Binding ReplyText}"
                                                           FontSize="12"
                                                           LineHeight="17"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource PrimaryTextBrush}" />
                                            </StackPanel>
                                        </ToolTip.Tip>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                            <TextBlock Text="{Binding ReplyLabel}" FontSize="10"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ReplyText}"
                                                       FontSize="10" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                        </Grid>
                                        </Border>
                                    </Grid>

                                    <TextBlock Grid.Row="1" Grid.Column="0"
                                               Text="{Binding TimeText}"
                                               IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowFullChatTimestamps}"
                                               FontSize="11"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               VerticalAlignment="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChatMetadataVerticalAlignment}"
                                               Margin="0,2,8,0" />

                                    <ItemsControl Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Badges}"
                                                  IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowFullChatBadges}"
                                                  VerticalAlignment="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChatMetadataVerticalAlignment}"
                                                  Margin="0,0,5,0">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" Spacing="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:ChatBadgeItemViewModel">
                                                <Grid Width="18" Height="18"
                                                      AutomationProperties.Name="{Binding ToolTip}"
                                                      ToolTip.Tip="{Binding ToolTip}">
                                                    <ContentControl Content="{Binding}"
                                                                    ContentTemplate="{StaticResource FullChatBadgeFallbackTemplate}"
                                                                    IsVisible="{Binding ShowStaticLabel}" />
                                                    <Grid IsVisible="{Binding HasImageResource}">
                                                        <ContentControl Content="{Binding}"
                                                                        ContentTemplate="{StaticResource FullChatBadgeFallbackTemplate}"
                                                                        IsVisible="{Binding ImageResource.ShowFallback}" />
                                                        <Image Source="{Binding ImageResource.Image}"
                                                               IsVisible="{Binding ImageResource.HasImage}"
                                                               Width="18" Height="18" Stretch="Uniform" />
                                                    </Grid>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal"
                                                IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowFullChatMetadata}"
                                                VerticalAlignment="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChatMetadataVerticalAlignment}">
                                        <Border IsVisible="{Binding IsPinned}"
                                                Background="{DynamicResource ButtonBrush}"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1" CornerRadius="5"
                                                Padding="4,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding PinnedLabel}"
                                                       FontSize="7" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <Border IsVisible="{Binding IsChannelPointRedemption}"
                                                Background="#334A7DFF"
                                                BorderBrush="{DynamicResource AccentBrush}"
                                                BorderThickness="1" CornerRadius="5"
                                                Padding="4,2" Margin="0,0,6,0"
                                                ToolTip.Tip="{Binding Message.RewardPrompt}">
                                            <TextBlock Text="{Binding ChannelPointsLabel}"
                                                       FontSize="7" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" />
                                        </Border>
                                        <Border IsVisible="{Binding IsSharedChatMessage}"
                                                Background="#2257E3B0"
                                                BorderBrush="{DynamicResource ConnectedBrush}"
                                                BorderThickness="1" CornerRadius="5"
                                                Padding="4,2" Margin="0,0,6,0">
                                            <TextBlock Text="{Binding SharedSourceLabel}"
                                                       FontSize="7" FontWeight="Bold"
                                                       Foreground="{DynamicResource ConnectedBrush}" />
                                        </Border>
                                    </StackPanel>

                                    <Grid Grid.Row="1" Grid.Column="2"
                                          AutomationProperties.AutomationId="CompactMessageBadgeHost"
                                          IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowCompactChatBadges}">
                                        <ItemsControl ItemsSource="{Binding CompactBadges}"
                                                      IsVisible="{Binding HasCompactBadges}"
                                                      VerticalAlignment="Center"
                                                      Margin="0,0,5,0">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal" Spacing="3" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ChatBadgeItemViewModel">
                                                    <Grid Width="18" Height="18"
                                                          AutomationProperties.Name="{Binding ToolTip}"
                                                          ToolTip.Tip="{Binding ToolTip}">
                                                        <Border IsVisible="{Binding IsYouTube}"
                                                                Width="18" Height="14"
                                                                CornerRadius="4"
                                                                Background="#FFFF0033"
                                                                VerticalAlignment="Center">
                                                            <Path Width="7" Height="8"
                                                                  Data="M2,1 L7,4 L2,7 Z"
                                                                  Fill="White"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                        </Border>
                                                        <Grid IsVisible="{Binding !IsYouTube}">
                                                            <Path IsVisible="{Binding ShowStaticLabel}"
                                                                  Width="16" Height="14"
                                                                  Data="M2,5 L5,8 L8,3 L11,8 L14,5 L13,13 H3 Z"
                                                                  Fill="{DynamicResource AccentBrush}"
                                                                  Stretch="Uniform"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center" />
                                                            <Grid IsVisible="{Binding HasImageResource}">
                                                                <Path IsVisible="{Binding ImageResource.ShowFallback}"
                                                                      Width="16" Height="14"
                                                                      Data="M2,5 L5,8 L8,3 L11,8 L14,5 L13,13 H3 Z"
                                                                      Fill="{DynamicResource AccentBrush}"
                                                                      Stretch="Uniform"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center" />
                                                                <Image Source="{Binding ImageResource.Image}"
                                                                       IsVisible="{Binding ImageResource.HasImage}"
                                                                       Width="18" Height="18"
                                                                       Stretch="Uniform" />
                                                            </Grid>
                                                        </Grid>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Grid>

                                    <StackPanel Grid.Row="1" Grid.Column="3" Spacing="3"
                                                VerticalAlignment="Center">
                                        <StackPanel Spacing="3" Opacity="{Binding ContentOpacity}">
                                            <controls:RichChatTextBlock Parts="{Binding Parts}"
                                                                        LinkClicked="RichChatTextBlock_OnLinkClicked"
                                                                        PrefixText="{Binding UserLabelWithColon}"
                                                                        PrefixBrush="{Binding UserBrush}"
                                                                        TextWrapping="Wrap"
                                                                        TextTrimming="CharacterEllipsis"
                                                                        MaxLines="{Binding MaxLines}"
                                                                        TextDecorations="{Binding ContentTextDecorations}"
                                                                        UseCompactEmotes="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).IsCompactMode}"
                                                                        FontSize="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ChatFontSize}"
                                                                        Foreground="{DynamicResource PrimaryTextBrush}"
                                                                        VerticalAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Spacing="3"
                                                    IsVisible="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowFullChatMetadata}">
                                            <Border IsVisible="{Binding IsModerated}"
                                                    HorizontalAlignment="Left"
                                                    Background="{DynamicResource ButtonBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1" CornerRadius="5"
                                                    Padding="5,2">
                                                <TextBlock Text="{Binding ModerationStatus}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                            </Border>
                                            <Button IsVisible="{Binding IsLong}"
                                                    Classes="ghost" HorizontalAlignment="Left"
                                                    Height="22" MinHeight="22" Padding="7,0"
                                                    Content="{Binding ExpandLabel}"
                                                    Command="{Binding ToggleExpandedCommand}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <Grid Grid.Row="2"
                          ColumnDefinitions="*,8,*"
                          IsVisible="{Binding ShowSplitMessageLists}"
                          AutomationProperties.AutomationId="SplitChatGrid">
                        <Border Grid.Column="0"
                                Classes="subtle-card"
                                Padding="0"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        Padding="10,7"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Width="7" Height="7" CornerRadius="4"
                                                Background="#A970FF"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Texts.TwitchChat}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="TwitchChatLatestButton" Grid.Column="2"
                                                Classes="ghost"
                                                AutomationProperties.AutomationId="TwitchChatLatestButton"
                                                AutomationProperties.Name="{Binding Texts.LatestMessages}"
                                                Width="28" Height="26" MinWidth="28" MinHeight="26"
                                                Padding="0"
                                                Click="TwitchChatLatestButton_OnClick"
                                                ToolTip.Tip="{Binding Texts.LatestMessages}"
                                                IsVisible="False">
                                            <Path Data="M3,6 L7,10 L11,6 M7,2 L7,10"
                                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="TwitchMessagesList"
                                         Grid.Row="1"
                                         Classes="chat-list"
                                         ItemsSource="{Binding TwitchVisibleMessages}"
                                         ItemTemplate="{Binding ItemTemplate, ElementName=MessagesList}"
                                         SelectionMode="Single"
                                         SelectionChanged="MessagesList_OnSelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                         ScrollViewer.IsScrollChainingEnabled="False">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Texts.NoTwitchMessages}"
                                           IsVisible="{Binding !HasTwitchVisibleMessages}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="18" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2"
                                Classes="subtle-card"
                                Padding="0"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        Padding="10,7"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Border Width="7" Height="7" CornerRadius="4"
                                                Background="#FF4E45"
                                                VerticalAlignment="Center"
                                                Margin="0,0,8,0" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding Texts.YouTubeChat}"
                                                   FontWeight="SemiBold"
                                                   VerticalAlignment="Center" />
                                        <Button x:Name="YouTubeChatLatestButton" Grid.Column="2"
                                                Classes="ghost"
                                                AutomationProperties.AutomationId="YouTubeChatLatestButton"
                                                AutomationProperties.Name="{Binding Texts.LatestMessages}"
                                                Width="28" Height="26" MinWidth="28" MinHeight="26"
                                                Padding="0"
                                                Click="YouTubeChatLatestButton_OnClick"
                                                ToolTip.Tip="{Binding Texts.LatestMessages}"
                                                IsVisible="False">
                                            <Path Data="M3,6 L7,10 L11,6 M7,2 L7,10"
                                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round"
                                                  Stretch="Uniform"
                                                  Width="14" Height="14" />
                                        </Button>
                                    </Grid>
                                </Border>
                                <ListBox x:Name="YouTubeMessagesList"
                                         Grid.Row="1"
                                         Classes="chat-list"
                                         ItemsSource="{Binding YouTubeVisibleMessages}"
                                         ItemTemplate="{Binding ItemTemplate, ElementName=MessagesList}"
                                         SelectionMode="Single"
                                         SelectionChanged="MessagesList_OnSelectionChanged"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                         ScrollViewer.IsScrollChainingEnabled="False">
                                    <ListBox.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <VirtualizingStackPanel />
                                        </ItemsPanelTemplate>
                                    </ListBox.ItemsPanel>
                                </ListBox>
                                <TextBlock Grid.Row="1"
                                           Text="{Binding Texts.NoYouTubeMessages}"
                                           IsVisible="{Binding !HasYouTubeVisibleMessages}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="18" />
                            </Grid>
                        </Border>
                    </Grid>

                    <Border Grid.Row="2"
                            ZIndex="12"
                            AutomationProperties.AutomationId="ChatMediaLoadingIndicator"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="10"
                            Padding="10,7"
                            CornerRadius="10"
                            Background="{DynamicResource SurfaceRaisedBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            IsHitTestVisible="False"
                            IsVisible="{Binding ShowFullChatMediaLoading}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <ProgressBar Width="34"
                                         Height="4"
                                         Margin="0,0,8,0"
                                         IsIndeterminate="True"
                                         Foreground="{DynamicResource AccentBrush}" />
                            <TextBlock Text="{Binding Texts.LoadingChatImages}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <controls:CompactLoadingBar Grid.Row="1"
                                                ZIndex="12"
                                                AutomationProperties.AutomationId="CompactChatMediaLoadingIndicator"
                                                Width="148"
                                                Height="28"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Margin="0,2,0,6"
                                                BackgroundBrush="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                TrackBrush="{DynamicResource ButtonBrush}"
                                                IndicatorBrush="{DynamicResource AccentBrush}"
                                                ReduceMotion="{Binding ReduceMotion}"
                                                IsHitTestVisible="False"
                                                IsVisible="{Binding ShowCompactChatMediaLoading}" />

                    <Border Grid.Row="2"
                            Classes="subtle-card"
                            Padding="{Binding ChatEmptyCardPadding}"
                            MaxWidth="580"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowChatEmptyState}">
                        <StackPanel>
                            <TextBlock Text="{Binding Texts.ChatEmptyTitle}"
                                       FontSize="{Binding ChatEmptyTitleSize}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center" />
                            <TextBlock Text="{Binding ChatEmptyText}"
                                       IsVisible="{Binding !IsObsDockMode}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="0,9,0,0" />
                        </StackPanel>
                    </Border>

                    <Border x:Name="WelcomeCard" Grid.Row="2"
                            Classes="subtle-card"
                            Padding="{Binding WelcomeCardPadding}"
                            Width="{Binding WelcomeCardWidth}"
                            MaxWidth="{Binding $parent[Grid].Bounds.Width}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsVisible="{Binding ShowWelcomeState}">
                        <ScrollViewer x:Name="WelcomeContentScrollViewer"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="WelcomeContent">
                            <TextBlock Text="WitherChat"
                                       FontSize="{Binding WelcomeTitleSize}"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center" />
                            <TextBlock Text="{Binding Texts.SignInHelp}"
                                       IsVisible="{Binding !IsObsDockMode}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       Margin="{Binding WelcomeDescriptionMargin}" />
                            <Button x:Name="WelcomeActionButton" Classes="primary"
                                    Content="{Binding WelcomeActionText}"
                                    Command="{Binding OpenConnectPanelCommand}"
                                    Margin="{Binding WelcomeActionMargin}"
                                    Width="210" MaxWidth="{Binding #WelcomeContent.Bounds.Width}"
                                    HorizontalAlignment="Center" />
                        </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border x:Name="MiddleScrollIndicator"
                            Grid.Row="2"
                            Width="32" Height="32"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            ZIndex="20"
                            IsVisible="False"
                            IsHitTestVisible="False"
                            CornerRadius="16"
                            Background="#B8202633"
                            BorderBrush="#A69AA4B8"
                            BorderThickness="1">
                        <Border.RenderTransform>
                            <TranslateTransform />
                        </Border.RenderTransform>
                        <Grid>
                            <Path Data="M6,7 L10,3 L14,7"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Top"
                                  Margin="0,5,0,0" />
                            <Ellipse Width="4" Height="4"
                                     Fill="{DynamicResource SecondaryTextBrush}"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center" />
                            <Path Data="M6,3 L10,7 L14,3"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Bottom"
                                  Margin="0,0,0,5" />
                        </Grid>
                    </Border>

                    <Grid x:Name="JumpToLatestContainer"
                          Grid.Row="2"
                          Width="44" Height="50"
                          Margin="0,0,10,10"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Bottom"
                          ZIndex="18"
                          IsVisible="{Binding ShowJumpToLatestButton}">
                        <Button AutomationProperties.AutomationId="JumpToLatestButton"
                                AutomationProperties.Name="{Binding Texts.LatestMessages}"
                                Width="40" Height="40"
                                MinWidth="40" MinHeight="40"
                                Padding="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Classes="icon-button jump-latest"
                                Classes.compact="{Binding IsCompactMode}"
                                IsVisible="{Binding ShowJumpToLatestButton}"
                                Command="{Binding ShowLatestCommand}"
                                ToolTip.Tip="{Binding Texts.LatestMessages}">
                            <Path Data="M3,7 L8,12 L13,7 M8,3 L8,12"
                                  Stroke="{DynamicResource PrimaryTextBrush}"
                                  StrokeThickness="1.8"
                                  StrokeLineCap="Round"
                                  StrokeJoin="Round"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Width="18" Height="18" />
                        </Button>
                        <Border HorizontalAlignment="Right"
                                VerticalAlignment="Top"
                                MinWidth="18" Height="18"
                                CornerRadius="9"
                                Background="{DynamicResource DangerBrush}"
                                IsVisible="{Binding HasUnreadMessages}"
                                IsHitTestVisible="False">
                            <TextBlock Text="{Binding UnreadCount}"
                                       Foreground="White"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="5,0" />
                        </Border>
                    </Grid>
                </Grid>
            </Border>

            <Button Grid.Row="5" Classes="panel-toggle"
                    AutomationProperties.AutomationId="ComposerToggleButton"
                    AutomationProperties.Name="{Binding ComposerToggleTip}"
                    HorizontalAlignment="Center" Margin="0,2"
                    IsVisible="{Binding ShowComposerToggle}"
                    Click="ComposerToggleButton_OnClick"
                    ToolTip.Tip="{Binding ComposerToggleTip}">
                <Grid Width="16" Height="10">
                    <Path IsVisible="{Binding IsComposerExpanded}"
                          Data="M2,2 L8,8 L14,2"
                          Stroke="{DynamicResource SecondaryTextBrush}"
                          StrokeThickness="1.8" StrokeLineCap="Round"
                          StrokeJoin="Round" />
                    <Path IsVisible="{Binding !IsComposerExpanded}"
                          Data="M2,8 L8,2 L14,8"
                          Stroke="{DynamicResource SecondaryTextBrush}"
                          StrokeThickness="1.8" StrokeLineCap="Round"
                          StrokeJoin="Round" />
                </Grid>
            </Button>

            <Grid x:Name="ComposerPanel"
                  Grid.Row="6" IsVisible="{Binding ShowComposerPanel}">
                <Border Classes="subtle-card composer-panel" Padding="{Binding ComposerCardPadding}" MinHeight="{Binding ComposerCardMinHeight}"
                        IsVisible="{Binding ShowMessageComposer}">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox x:Name="ComposerTextBox"
                                 Classes="composer"
                                 AutomationProperties.AutomationId="ComposerInput"
                                 AutomationProperties.Name="{Binding Texts.Chat}"
                                 Grid.Column="0" MinHeight="{Binding ComposerInputMinHeight}"
                                 Padding="{Binding ComposerInputPadding}"
                                 AcceptsReturn="False" TextWrapping="NoWrap"
                                 MaxLength="500"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden"
                                 ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 VerticalAlignment="Stretch"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding ComposerText}"
                                 IsEnabled="{Binding IsAccountConnected}"
                                 KeyDown="ComposerTextBox_OnKeyDown" />
                        <Button Grid.Column="1"
                                Classes="primary composer-send"
                                Width="{Binding ComposerSendSize}" Height="{Binding ComposerSendSize}"
                                MinWidth="{Binding ComposerSendSize}" MinHeight="{Binding ComposerSendSize}"
                                AutomationProperties.AutomationId="SendMessageButton"
                                AutomationProperties.Name="{Binding Texts.Send}"
                                Margin="8,0,0,0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Command="{Binding SendMessageCommand}"
                                ToolTip.Tip="{Binding Texts.Send}">
                            <Path Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"
                                  Width="20" Height="20"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransform="translate(1.5px, 0px)"
                                  Fill="#0B0D12"
                                  IsHitTestVisible="False" />
                        </Button>
                    </Grid>
                </Border>
                <Border Classes="subtle-card" Padding="14"
                        IsVisible="{Binding ShowReadOnlyComposerNotice}">
                    <TextBlock Text="{Binding ReadOnlyComposerNotice}"
                               Foreground="{DynamicResource MutedTextBrush}"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
                <Border x:Name="OnboardingComposerPreview"
                        Classes="subtle-card composer-panel"
                        Padding="8"
                        MinHeight="76"
                        IsHitTestVisible="False"
                        IsVisible="{Binding ShowOnboardingComposerPreview}">
                    <Grid ColumnDefinitions="*,Auto">
                        <Border Grid.Column="0"
                                MinHeight="56"
                                Padding="18,0"
                                CornerRadius="22"
                                Background="{DynamicResource ButtonBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="{Binding Texts.ComposerPlaceholder}"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </Border>
                        <Border Grid.Column="1"
                                Width="46"
                                Height="46"
                                Margin="8,0,0,0"
                                CornerRadius="23"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentGradientBrush}">
                            <Path Data="M2,21 L23,12 L2,3 L2,10 L17,12 L2,14 Z"
                                  Width="19" Height="19"
                                  Stretch="Uniform"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  RenderTransform="translate(1.5px, 0px)"
                                  Fill="#0B0D12" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <TextBlock Text="{Binding VersionLabel}"
                   IsVisible="{Binding !IsObsDockMode}"
                   HorizontalAlignment="Right"
                   VerticalAlignment="Bottom"
                   Margin="0,0,24,4"
                   Foreground="{DynamicResource MutedTextBrush}"
                   FontSize="11"
                   IsHitTestVisible="False" />

        <Border AutomationProperties.AutomationId="TwitchClipNotification"
                ZIndex="70"
                MaxWidth="380"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="16,16,16,88"
                Padding="16,14"
                CornerRadius="18"
                Background="{DynamicResource PopupBrush}"
                BorderBrush="{DynamicResource BorderStrongBrush}"
                BorderThickness="1"
                BoxShadow="0 14 36 2 #78000000"
                IsVisible="{Binding IsTwitchClipNotificationVisible}">
            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,*,Auto">
                <Border Width="34" Height="34" CornerRadius="17"
                        Background="#1F9146FF" VerticalAlignment="Top">
                    <Path Width="18" Height="18"
                          Data="M3,7 H21 V20 H3 Z M3,7 L6,2 H21 L18,7 Z M8,2 L5,7 M13,2 L10,7 M18,2 L15,7"
                          Stroke="#B99CFF" StrokeThickness="1.55"
                          StrokeLineCap="Round" StrokeJoin="Round"
                          Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="11,0,10,0" Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7" Height="7"
                                 VerticalAlignment="Center"
                                 Fill="{Binding TwitchClipNotificationBrush}" />
                        <TextBlock Text="{Binding TwitchClipStatusTitle}"
                                   FontWeight="SemiBold" FontSize="14" />
                    </StackPanel>
                    <TextBlock Text="{Binding TwitchClipStatusMessage}"
                               TextWrapping="Wrap" FontSize="11"
                               LineHeight="16"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="icon-button"
                        AutomationProperties.AutomationId="DismissTwitchClipNotificationButton"
                        AutomationProperties.Name="{Binding Texts.Close}"
                        Width="28" Height="28" MinWidth="28" MinHeight="28"
                        Command="{Binding DismissTwitchClipNotificationCommand}"
                        ToolTip.Tip="{Binding Texts.Close}">
                    <Path Data="M4,4 L14,14 M14,4 L4,14"
                          Width="12" Height="12"
                          Stroke="{DynamicResource SecondaryTextBrush}"
                          StrokeThickness="1.5" StrokeLineCap="Round" />
                </Button>
                <StackPanel Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                            Orientation="Horizontal" Spacing="8" Margin="11,12,0,0"
                            IsVisible="{Binding HasCreatedTwitchClip}">
                    <Button Classes="primary" MinHeight="34" Padding="14,6"
                            AutomationProperties.AutomationId="OpenCreatedTwitchClipButton"
                            Content="{Binding Texts.TwitchClipOpen}"
                            Command="{Binding OpenCreatedTwitchClipCommand}" />
                    <Button MinHeight="34" Padding="14,6"
                            AutomationProperties.AutomationId="CopyCreatedTwitchClipButton"
                            Content="{Binding Texts.TwitchClipCopyLink}"
                            Command="{Binding CopyCreatedTwitchClipLinkCommand}" />
                </StackPanel>
                <ProgressBar Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2"
                             Height="3" MinWidth="0" Margin="11,12,0,0"
                             IsIndeterminate="True"
                             IsVisible="{Binding IsCreatingTwitchClip}" />
            </Grid>
        </Border>

        <Border Background="Transparent"
                ZIndex="29"
                IsVisible="{Binding IsChannelEditorOpen}"
                PointerPressed="ChannelEditorDismissLayer_OnPointerPressed" />

        <Border x:Name="ChannelEditorCard" Width="330" MaxHeight="460"
                AutomationProperties.AutomationId="ChannelEditorCard"
                KeyboardNavigation.TabNavigation="Cycle"
                ZIndex="30"
                HorizontalAlignment="Left" VerticalAlignment="Top"
                Margin="16,76,0,0" Padding="14"
                Classes="card" Background="{DynamicResource PopupBrush}"
                IsVisible="False"
                Opacity="0">
            <ScrollViewer x:Name="ChannelEditorScrollViewer" MinHeight="0"
                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Grid ColumnDefinitions="*,Auto" Margin="2,0,0,10">
                    <TextBlock Text="{Binding Texts.Channels}"
                               FontSize="18" FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                    <Button x:Name="ChannelHelpButton" Grid.Column="1" Classes="context-help"
                            Content="?" Command="{Binding StartContextTutorialCommand}"
                            CommandParameter="Channels"
                            ToolTip.Tip="{Binding Texts.OpenChannelsTutorial}"
                            AutomationProperties.Name="{Binding Texts.OpenChannelsTutorial}"
                            AutomationProperties.AutomationId="ChannelHelpButton" />
                </Grid>
                <Border Classes="channel-row"
                        Margin="0,0,0,8"
                        Padding="12,10"
                        IsHitTestVisible="False"
                        IsVisible="{Binding ShowOnboardingChannelPreview}">
                    <Grid ColumnDefinitions="40,*,Auto">
                        <Border Width="34" Height="34"
                                CornerRadius="17"
                                Background="{DynamicResource AccentGradientBrush}">
                            <TextBlock Text="W"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontWeight="Bold"
                                       Foreground="#0B0D12" />
                        </Border>
                        <StackPanel Grid.Column="1"
                                    Margin="9,0,8,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="WitherChat"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="@witherchat"
                                       FontSize="10"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            <Border Background="{DynamicResource ButtonBrush}"
                                    CornerRadius="7"
                                    Padding="6,2"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{Binding Texts.MyChannel}"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontSize="10"
                                           FontWeight="SemiBold" />
                            </Border>
                        </StackPanel>
                        <Ellipse Grid.Column="2"
                                 Width="7" Height="7"
                                 Margin="12,0,4,0"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource SuccessBrush}" />
                    </Grid>
                </Border>
                <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Hidden">
                    <ItemsControl ItemsSource="{Binding SavedChannels}">
                    <ItemsControl.Styles>
                        <Style Selector="ContentPresenter">
                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ItemsControl.Styles>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="models:ChannelSessionViewModel">
                            <Border Classes="channel-row"
                                    Classes.selected="{Binding IsActive}"
                                    Margin="0,0,0,8"
                                    Padding="7">
                                <Grid ColumnDefinitions="*,40">
                                    <Button Background="Transparent" BorderBrush="Transparent"
                                            AutomationProperties.AutomationId="SavedChannelSelectButton"
                                            HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" Padding="5"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SwitchSavedChannelCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="40,*,Auto">
                                            <Border Width="34" Height="34" CornerRadius="17"
                                                    Background="{DynamicResource ButtonBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding AvatarInitial}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold" />
                                                    <Image Source="{Binding ProfileImageResource.Image}"
                                                           Stretch="UniformToFill"
                                                           IsVisible="{Binding ProfileImageResource.HasImage}" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="1"
                                                        Margin="9,0,8,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Label}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <Border Background="{DynamicResource ButtonBrush}"
                                                        CornerRadius="7"
                                                        Padding="6,2"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        IsVisible="{Binding IsPrimaryAccountChannel}">
                                                    <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.MyChannel}"
                                                               Foreground="{DynamicResource AccentBrush}"
                                                               FontSize="10"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2"
                                                        Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Center"
                                                        Spacing="6">
                                                <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Live}"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="10"
                                                           IsVisible="{Binding IsLive}" />
                                                <TextBlock Text="{Binding ViewerCount}"
                                                           Foreground="{DynamicResource DangerBrush}"
                                                           FontWeight="SemiBold"
                                                           FontSize="10"
                                                           IsVisible="{Binding HasViewerCount}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                    <Ellipse Grid.Column="1"
                                             Width="7" Height="7"
                                             HorizontalAlignment="Center"
                                             VerticalAlignment="Center"
                                             Fill="{DynamicResource SuccessBrush}"
                                             IsVisible="{Binding IsPrimaryAccountChannel}" />
                                    <Button Grid.Column="1" Classes="icon-button"
                                            AutomationProperties.Name="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.RemoveChannel}"
                                            Width="34" Height="34" MinWidth="34" MinHeight="34"
                                            Padding="0" Margin="0"
                                            IsVisible="{Binding CanRemove}"
                                            ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.RemoveChannel}"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).RemoveSavedChannelCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Data="M6,7 H18 M9,7 V5 H15 V7 M8,9 L9,19 H15 L16,9 M11,10 V17 M13,10 V17"
                                              Stroke="{DynamicResource SecondaryTextBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineCap="Round"
                                              StrokeJoin="Round"
                                              Width="16" Height="16"
                                              Stretch="Uniform" />
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
                <TextBlock Text="{Binding ChannelOperationError}"
                           IsVisible="{Binding HasChannelOperationError}"
                           AutomationProperties.AutomationId="ChannelOperationError"
                           Margin="2,4,2,6" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource DangerBrush}" />
                <Button x:Name="AddChannelButton" Classes="primary" Margin="0,4,0,0"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="AddChannelButton"
                        IsVisible="{Binding !IsAddingChannel}"
                        IsEnabled="{Binding CanAddSavedChannel}"
                        Content="{Binding Texts.AddChannel}"
                        Command="{Binding StartAddChannelCommand}" />
                <TextBlock Text="{Binding Texts.ChannelLimitReached}"
                           IsVisible="{Binding !CanAddSavedChannel}"
                           Margin="2,8,2,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Border Classes="subtle-card" Padding="10" Margin="0,4,0,0"
                        IsVisible="{Binding IsAddingChannel}">
                    <StackPanel Spacing="8">
                        <TextBox AutomationProperties.AutomationId="ChannelInput"
                                 AutomationProperties.Name="{Binding Texts.ChannelPlaceholder}"
                                 Text="{Binding ChannelDraft}"
                                 PlaceholderText="{Binding Texts.ChannelPlaceholder}"
                                 MaxLength="25" />
                        <ProgressBar IsIndeterminate="True" Height="2"
                                     IsVisible="{Binding IsChannelSearchBusy}" />
                        <ItemsControl ItemsSource="{Binding ChannelSearchResults}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ChannelSearchResultViewModel">
                                    <Button Background="Transparent" BorderBrush="Transparent"
                                            HorizontalContentAlignment="Stretch" Padding="6"
                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectChannelSearchResultCommand}"
                                            CommandParameter="{Binding}">
                                        <Grid ColumnDefinitions="40,10,*">
                                            <Border Width="40" Height="40" CornerRadius="20"
                                                    Background="{DynamicResource ButtonBrush}" ClipToBounds="True">
                                                <Image Source="{Binding Thumbnail.Image}" Stretch="UniformToFill"
                                                       IsVisible="{Binding Thumbnail.HasImage}" />
                                            </Border>
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                                <StackPanel Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding Login}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Live}"
                                                               FontSize="10" Foreground="{DynamicResource DangerBrush}"
                                                               IsVisible="{Binding IsLive}" />
                                                    <StackPanel Orientation="Horizontal" Spacing="3"
                                                                IsVisible="{Binding HasViewerCount}">
                                                        <Path Width="11" Height="8"
                                                              Stretch="Uniform"
                                                              Fill="{DynamicResource MutedTextBrush}"
                                                              Data="F0 M12,4 C5.5,4 1,12 1,12 C1,12 5.5,20 12,20 C18.5,20 23,12 23,12 C23,12 18.5,4 12,4 Z M12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 Z" />
                                                        <TextBlock Text="{Binding ViewerCount}" FontSize="10"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding GameName}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ChannelSearchStatus}" FontSize="11"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   IsVisible="{Binding HasChannelSearchStatus}" />
                        <Grid ColumnDefinitions="*,Auto,Auto">
                            <Button Grid.Column="1" Classes="tool" Margin="0,0,8,0"
                                    Content="{Binding Texts.Cancel}"
                                    Command="{Binding CancelAddChannelCommand}" />
                            <Button Grid.Column="2" Classes="primary"
                                    AutomationProperties.AutomationId="ConfirmAddChannelButton"
                                    IsEnabled="{Binding CanConfirmAddChannel}"
                                    Content="{Binding Texts.AddChannel}"
                                    Command="{Binding ConfirmAddChannelCommand}" />
                        </Grid>
                    </StackPanel>
                </Border>
            </StackPanel>
            </ScrollViewer>
        </Border>

        <Border x:Name="LogViewerOverlay"
                Background="#88000000"
                PointerPressed="LogViewerOverlay_OnPointerPressed"
                IsVisible="False">
            <Border x:Name="LogViewerCard" Width="1000" Height="680"
                    KeyboardNavigation.TabNavigation="Cycle"
                    MaxWidth="{Binding $parent[Window].Bounds.Width}"
                    MaxHeight="{Binding $parent[Window].Bounds.Height}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Classes="card" Padding="20"
                    Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,14,*">
                    <Grid x:Name="LogViewerHeader"
                          AutomationProperties.AutomationId="LogViewerHeader"
                          ColumnDefinitions="*,Auto,8,Auto,10,Auto">
                        <StackPanel x:Name="LogHeaderIdentity" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Texts.ChatLogs}"
                                       FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding ChatLogDirectory}"
                                       Margin="1,5,16,0" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Button x:Name="ChatLogsHelpButton" Grid.Column="1" Classes="context-help"
                                Content="?" Command="{Binding StartContextTutorialCommand}"
                                CommandParameter="Logs"
                                ToolTip.Tip="{Binding Texts.OpenLogsTutorial}"
                                AutomationProperties.Name="{Binding Texts.OpenLogsTutorial}"
                                AutomationProperties.AutomationId="ChatLogsHelpButton" />
                        <Button x:Name="OpenLogFolderButton" Grid.Column="3"
                                Classes="tool"
                                AutomationProperties.AutomationId="OpenLogFolderButton"
                                Command="{Binding OpenLogDirectoryCommand}"
                                VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                                <Path Data="M2,5 H8 L10,7 H20 V17 H2 Z"
                                      Width="16" Height="16"
                                      Stretch="Uniform"
                                      Stroke="{DynamicResource SecondaryTextBrush}"
                                      StrokeThickness="1.5"
                                      StrokeJoin="Round" />
                                <TextBlock x:Name="OpenLogFolderLabel" Text="{Binding Texts.OpenLogFolder}"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="CloseLogsButton" Grid.Column="5" Classes="icon-button log-close"
                                 AutomationProperties.AutomationId="CloseLogsButton"
                                 AutomationProperties.Name="{Binding Texts.Close}"
                                 Command="{Binding CloseLogsCommand}"
                                 ToolTip.Tip="{Binding Texts.Close}">
                            <Path Data="M3,3 L13,13 M13,3 L3,13"
                                  Stroke="{DynamicResource DangerBrush}"
                                  StrokeThickness="1.7" StrokeLineCap="Round"
                                  Stretch="Uniform"
                                  Width="16" Height="16" />
                        </Button>
                    </Grid>

                    <ScrollViewer x:Name="LogDockBodyScrollViewer" Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Disabled">
                    <Grid x:Name="LogViewerBodyGrid" ColumnDefinitions="250,14,*">
                        <Border x:Name="LogViewerSidebar"
                                AutomationProperties.AutomationId="LogViewerSidebar"
                                Classes="subtle-card" Padding="12">
                            <Grid RowDefinitions="Auto,150,1,10,*">
                                <TextBlock Text="{Binding Texts.Channels}"
                                           Margin="4,1,0,9"
                                           FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                <ListBox Grid.Row="1"
                                         Classes="log-navigation"
                                         AutomationProperties.AutomationId="LogChannelList"
                                         ItemsSource="{Binding ChatLogChannels}"
                                          SelectedItem="{Binding SelectedLogChannel}"
                                          Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="28,*" Margin="5,4">
                                                <Border Width="24" Height="24"
                                                        CornerRadius="12"
                                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1">
                                                    <TextBlock Text="#"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding}"
                                                           Margin="8,0,2,0"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <Border Grid.Row="2"
                                        Margin="4,0"
                                        Background="{DynamicResource BorderBrush}" />
                                <ListBox Grid.Row="4"
                                         Classes="log-navigation"
                                         AutomationProperties.AutomationId="LogFileList"
                                         ItemsSource="{Binding VisibleChatLogFiles}"
                                          SelectedItem="{Binding SelectedLogFile}"
                                          Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChatLogFileViewModel">
                                            <Grid ColumnDefinitions="32,*" Margin="5,5">
                                                <Border Width="28" Height="28"
                                                        CornerRadius="8"
                                                        VerticalAlignment="Top"
                                                        Background="{DynamicResource SurfaceRaisedBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1">
                                                    <Path Data="M3,5 H15 V16 H3 Z M6,3 V7 M12,3 V7 M3,8 H15"
                                                          Width="15" Height="15"
                                                          Stretch="Uniform"
                                                          Stroke="{DynamicResource AccentBrush}"
                                                          StrokeThickness="1.4"
                                                          StrokeLineCap="Round"
                                                          StrokeJoin="Round" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="8,0,2,0">
                                                    <TextBlock Text="{Binding DateText}"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Title}"
                                                               Margin="0,3,0,0"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource SecondaryTextBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding SizeText}"
                                                               Margin="0,2,0,0"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border x:Name="LogViewerContent"
                                Grid.Column="2"
                                AutomationProperties.AutomationId="LogViewerContent"
                                Classes="subtle-card"
                                Padding="0"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,1,Auto,1,*">
                                <Grid x:Name="LogSelectedHeaderGrid" Margin="18,16,18,14"
                                      ColumnDefinitions="*,Auto">
                                    <StackPanel x:Name="SelectedLogHeader"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedLogTitle}"
                                                   FontSize="19" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding SelectedLogMeta}"
                                                   Margin="0,5,12,0"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </StackPanel>
                                    <StackPanel x:Name="LogViewerActions"
                                                AutomationProperties.AutomationId="LogViewerActions"
                                                Grid.Column="1"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                Spacing="7">
                                        <Button Classes="tool"
                                                Content="{Binding Texts.ExportTxt}"
                                                Click="ExportLogTxt_OnClick" />
                                        <Button Classes="tool"
                                                Content="{Binding Texts.ExportJsonl}"
                                                Click="ExportLogJsonl_OnClick" />
                                        <Button Classes="danger log-delete"
                                                AutomationProperties.Name="{Binding Texts.DeleteLog}"
                                                Command="{Binding RequestDeleteLogCommand}"
                                                ToolTip.Tip="{Binding Texts.DeleteLog}">
                                            <Path Data="M4,5 H16 M7,5 V3 H13 V5 M6,7 V17 H14 V7 M9,9 V14 M11,9 V14"
                                                  Width="16" Height="16"
                                                  Stretch="Uniform"
                                                  Stroke="{DynamicResource DangerBrush}"
                                                  StrokeThickness="1.5"
                                                  StrokeLineCap="Round"
                                                  StrokeJoin="Round" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <Border Grid.Row="1"
                                        Background="{DynamicResource BorderBrush}" />

                                <Grid x:Name="LogViewerFilters" Grid.Row="2"
                                      Margin="14,12"
                                      ColumnDefinitions="2*,10,*,10,150">
                                    <TextBox AutomationProperties.AutomationId="LogSearchInput"
                                             AutomationProperties.Name="{Binding Texts.LogSearch}"
                                             PlaceholderText="{Binding Texts.LogSearch}"
                                              Text="{Binding LogSearchText}" />
                                    <TextBox Grid.Column="2"
                                             AutomationProperties.AutomationId="LogUserFilterInput"
                                             AutomationProperties.Name="{Binding Texts.FilterByUser}"
                                             PlaceholderText="{Binding Texts.FilterByUser}"
                                              Text="{Binding LogUserFilter}" />
                                    <ComboBox Grid.Column="4"
                                              AutomationProperties.AutomationId="LogRoleFilter"
                                              AutomationProperties.Name="{Binding Texts.AllRoles}"
                                              ItemsSource="{Binding LogRoleOptions}"
                                               SelectedItem="{Binding SelectedLogRoleOption}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SelectionOptionViewModel">
                                                <TextBlock Text="{Binding Label}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </Grid>

                                <Border Grid.Row="3"
                                        Background="{DynamicResource BorderBrush}" />

                                <ListBox x:Name="LogViewerEntries" Grid.Row="4"
                                         Classes="log-entries"
                                         AutomationProperties.AutomationId="LogEntriesList"
                                         ItemsSource="{Binding ChatLogEntries}"
                                          Background="Transparent"
                                          ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChatLogEntryViewModel">
                                            <Grid ColumnDefinitions="64,180,*"
                                                  Margin="14,9">
                                                <TextBlock Text="{Binding TimeText}"
                                                           FontSize="11"
                                                           VerticalAlignment="Top"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <Grid Grid.Column="1"
                                                      ColumnDefinitions="Auto,*"
                                                      Margin="4,0,12,0"
                                                      VerticalAlignment="Top">
                                                    <ItemsControl ItemsSource="{Binding Badges}"
                                                                  IsVisible="{Binding HasBadges}"
                                                                  Margin="0,0,5,0"
                                                                  VerticalAlignment="Center">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <StackPanel Orientation="Horizontal" Spacing="3" />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate x:DataType="vm:ChatBadgeItemViewModel">
                                                                <Grid Width="18" Height="18"
                                                                      AutomationProperties.Name="{Binding ToolTip}"
                                                                      ToolTip.Tip="{Binding ToolTip}">
                                                                    <TextBlock Text="{Binding Label}"
                                                                               IsVisible="{Binding ShowStaticLabel}"
                                                                               FontSize="7"
                                                                               FontWeight="Bold"
                                                                               TextAlignment="Center"
                                                                               VerticalAlignment="Center"
                                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                    <Grid IsVisible="{Binding HasImageResource}">
                                                                        <TextBlock Text="{Binding Label}"
                                                                                   IsVisible="{Binding ImageResource.ShowFallback}"
                                                                                   FontSize="7"
                                                                                   FontWeight="Bold"
                                                                                   TextAlignment="Center"
                                                                                   VerticalAlignment="Center"
                                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                        <Image Source="{Binding ImageResource.Image}"
                                                                               IsVisible="{Binding ImageResource.HasImage}"
                                                                               Width="18" Height="18"
                                                                               Stretch="Uniform" />
                                                                    </Grid>
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding User}"
                                                               Foreground="{Binding UserBrush}"
                                                               VerticalAlignment="Center"
                                                               FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                                <Grid Grid.Column="2">
                                                    <TextBlock Text="{Binding Text}"
                                                               IsVisible="{Binding !HasPresentation}"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource PrimaryTextBrush}"
                                                               VerticalAlignment="Top" />
                                                    <controls:RichChatTextBlock Parts="{Binding Parts}"
                                                                                IsVisible="{Binding HasPresentation}"
                                                                                TextWrapping="Wrap"
                                                                                Foreground="{DynamicResource PrimaryTextBrush}"
                                                                                VerticalAlignment="Top" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="4" Text="{Binding Texts.NoChatLogs}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="8"
                                           IsVisible="{Binding !HasChatLogFiles}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="StreamEventsOverlay"
                AutomationProperties.AutomationId="StreamEventsOverlay"
                Background="#88000000"
                IsVisible="{Binding IsStreamEventsOpen}">
            <Border x:Name="StreamEventsCard" Width="820" Height="620" MaxHeight="{Binding $parent[Window].Bounds.Height}"
                    KeyboardNavigation.TabNavigation="Cycle"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Classes="card" Padding="22"
                    Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,14,Auto,12,*">
                    <Grid ColumnDefinitions="*,Auto,8,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock Text="{Binding Texts.StreamEvents}"
                                       FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Texts.StreamEventsDescription}"
                                       MaxWidth="680" TextWrapping="Wrap"
                                       FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Button x:Name="EventsHelpButton" Grid.Column="1" Classes="context-help"
                                Content="?" Command="{Binding StartContextTutorialCommand}"
                                CommandParameter="Events"
                                ToolTip.Tip="{Binding Texts.OpenEventsTutorial}"
                                AutomationProperties.Name="{Binding Texts.OpenEventsTutorial}" />
                        <Button Grid.Column="3" Classes="icon-button"
                                AutomationProperties.AutomationId="CloseStreamEventsButton"
                                AutomationProperties.Name="{Binding Texts.Close}"
                                ToolTip.Tip="{Binding Texts.Close}"
                                Command="{Binding CloseStreamEventsCommand}">
                            <Path Data="M3,3 L11,11 M11,3 L3,11"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <WrapPanel x:Name="StreamEventFiltersPanel" Grid.Row="2">
                        <Button Margin="0,0,6,0" Classes.moderation-tab="True"
                                Classes.selected="{Binding IsAllStreamEventsSelected}"
                                Content="{Binding Texts.EventFilterAll}"
                                Command="{Binding SetStreamEventFilterCommand}"
                                CommandParameter="0" />
                        <Button Margin="0,0,6,0" Classes.moderation-tab="True"
                                Classes.selected="{Binding IsTwitchStreamEventsSelected}"
                                Content="{Binding Texts.EventFilterTwitch}"
                                Command="{Binding SetStreamEventFilterCommand}"
                                CommandParameter="1" />
                        <Button Margin="0,0,6,0" Classes.moderation-tab="True"
                                Classes.selected="{Binding IsYouTubeStreamEventsSelected}"
                                Content="{Binding Texts.EventFilterYouTube}"
                                Command="{Binding SetStreamEventFilterCommand}"
                                CommandParameter="2" />
                        <Button Margin="0" Classes.moderation-tab="True"
                                Classes.selected="{Binding IsPaidStreamEventsSelected}"
                                Content="{Binding Texts.EventFilterDonations}"
                                Command="{Binding SetStreamEventFilterCommand}"
                                CommandParameter="3" />
                    </WrapPanel>
                    <Border Grid.Row="4" Classes="subtle-card" Padding="8">
                        <Grid>
                            <ListBox ItemsSource="{Binding VisibleStreamEvents}"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StreamEventItemViewModel">
                                        <Border Margin="2,3" Padding="11,9"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="3,1,1,1" CornerRadius="9">
                                            <Grid RowDefinitions="Auto,Auto" ColumnDefinitions="Auto,10,*,Auto">
                                                <Border Padding="5,3" CornerRadius="5"
                                                        Background="#334A7DFF">
                                                    <TextBlock Text="{Binding PlatformMark}"
                                                               FontSize="8" FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Border>
                                                <Grid Grid.Column="2" ColumnDefinitions="Auto,7,*">
                                                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                                                    <TextBlock Grid.Column="2" Text="{Binding UserLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>
                                                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
                                                    <TextBlock Text="{Binding AmountLabel}"
                                                               IsVisible="{Binding HasAmount}"
                                                               FontWeight="Bold" Foreground="{DynamicResource DonationAccentBrush}" />
                                                    <TextBlock Text="{Binding TimeLabel}"
                                                               FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                                <TextBlock Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="2"
                                                           Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                                                           Margin="0,4,0,0" TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding Texts.NoStreamEvents}"
                                       TextWrapping="Wrap" TextAlignment="Center" Margin="8"
                                       IsVisible="{Binding !HasVisibleStreamEvents}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="ProtectionPanelOverlay"
                AutomationProperties.AutomationId="ProtectionPanelOverlay"
                Background="#88000000"
                IsVisible="{Binding IsProtectionPanelOpen}">
            <Border x:Name="ProtectionPanelCard" Width="820" Margin="20"
                    KeyboardNavigation.TabNavigation="Cycle"
                    MaxWidth="{Binding $parent[Window].Bounds.Width}"
                    MaxHeight="{Binding $parent[Window].Bounds.Height}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Classes="card" Padding="22"
                    Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,16,*">
                    <Grid AutomationProperties.AutomationId="ProtectionPanelFixedHeader"
                          ColumnDefinitions="36,12,*,12,36">
                        <Button x:Name="ProtectionHelpButton" Grid.Column="0" Classes="context-help"
                                Width="36" Height="36"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                Content="?" Command="{Binding StartContextTutorialCommand}"
                                CommandParameter="Protection"
                                ToolTip.Tip="{Binding Texts.OpenProtectionTutorial}"
                                AutomationProperties.Name="{Binding Texts.OpenProtectionTutorial}" />
                        <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Texts.StreamProtection}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       FontSize="24" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Texts.StreamProtectionDescription}"
                                       MaxWidth="560" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" FontSize="12"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Button Grid.Column="4" Classes="icon-button"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                AutomationProperties.AutomationId="CloseProtectionButton"
                                AutomationProperties.Name="{Binding Texts.Close}"
                                ToolTip.Tip="{Binding Texts.Close}"
                                Command="{Binding CloseProtectionPanelCommand}">
                            <Path Data="M3,3 L11,11 M11,3 L3,11"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="2"
                                  AutomationProperties.AutomationId="ProtectionPanelScrollViewer"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                    <Grid RowDefinitions="Auto,14,Auto,14,Auto">
                    <Grid ColumnDefinitions="*,14,*">
                    <Border x:Name="ProtectionTwitchSettingsCard" Grid.Column="0" Classes="subtle-card" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Texts.ProtectionTwitchSection}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold" />
                                <TextBlock AutomationProperties.AutomationId="ProtectionTwitchSectionDescription"
                                           Text="{Binding Texts.ProtectionTwitchSectionDescription}"
                                           MaxWidth="620" HorizontalAlignment="Center" TextAlignment="Center"
                                           TextWrapping="Wrap" FontSize="11"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                                <TextBlock Text="{Binding Texts.ProtectionTwitchPermissionHint}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource WarningBrush}" />
                            </StackPanel>

                            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,12,*,12,120">
                                    <CheckBox AutomationProperties.AutomationId="ProtectionSlowModeToggle"
                                              AutomationProperties.Name="{Binding Texts.ProtectionSlowMode}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ProtectionSlowMode}" />
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texts.ProtectionSlowMode}" FontWeight="SemiBold" />
                                        <TextBlock AutomationProperties.AutomationId="ProtectionSlowModeDescription"
                                                   Text="{Binding Texts.ProtectionSlowModeDescription}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texts.ProtectionSlowSeconds}"
                                                   HorizontalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                            <TextBox AutomationProperties.AutomationId="ProtectionSlowSecondsInput"
                                                     AutomationProperties.Name="{Binding Texts.ProtectionSlowSeconds}"
                                                     Width="72" MaxLength="3" HorizontalContentAlignment="Center"
                                                     IsEnabled="{Binding ProtectionSlowMode}"
                                                     Text="{Binding ProtectionSlowSeconds}" />
                                            <TextBlock Text="{Binding Texts.ProtectionSecondsShort}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,12,*">
                                    <CheckBox AutomationProperties.AutomationId="ProtectionSubscriberModeToggle"
                                              AutomationProperties.Name="{Binding Texts.ProtectionSubscriberMode}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ProtectionSubscriberMode}" />
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texts.ProtectionSubscriberMode}" FontWeight="SemiBold" />
                                        <TextBlock AutomationProperties.AutomationId="ProtectionSubscriberModeDescription"
                                                   Text="{Binding Texts.ProtectionSubscriberModeDescription}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,12,*,12,120">
                                    <CheckBox AutomationProperties.AutomationId="ProtectionFollowerModeToggle"
                                              AutomationProperties.Name="{Binding Texts.ProtectionFollowerMode}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding ProtectionFollowerMode}" />
                                    <StackPanel Grid.Column="2" Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texts.ProtectionFollowerMode}" FontWeight="SemiBold" />
                                        <TextBlock AutomationProperties.AutomationId="ProtectionFollowerModeDescription"
                                                   Text="{Binding Texts.ProtectionFollowerModeDescription}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="4" Spacing="3" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texts.ProtectionFollowerMinutes}"
                                                   HorizontalAlignment="Center" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="7">
                                            <TextBox AutomationProperties.AutomationId="ProtectionFollowerMinutesInput"
                                                     AutomationProperties.Name="{Binding Texts.ProtectionFollowerMinutes}"
                                                     Width="72" MaxLength="6" HorizontalContentAlignment="Center"
                                                     IsEnabled="{Binding ProtectionFollowerMode}"
                                                     Text="{Binding ProtectionFollowerMinutes}" />
                                            <TextBlock Text="{Binding Texts.ProtectionMinutesShort}"
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                    <Border x:Name="ProtectionLocalSettingsCard" Grid.Column="2" Classes="subtle-card" Padding="16">
                        <StackPanel Spacing="10">
                            <StackPanel Spacing="3" HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Texts.ProtectionLocalSection}"
                                           HorizontalAlignment="Center" TextAlignment="Center"
                                           FontSize="16" FontWeight="SemiBold" />
                            <TextBlock AutomationProperties.AutomationId="ProtectionLocalSectionDescription"
                                       Text="{Binding Texts.ProtectionLocalOnly}"
                                       MaxWidth="620" HorizontalAlignment="Center" TextAlignment="Center"
                                       TextWrapping="Wrap" FontSize="11"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                            </StackPanel>
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,12,*">
                                    <CheckBox AutomationProperties.AutomationId="ProtectionPauseDisplayToggle"
                                              AutomationProperties.Name="{Binding Texts.ProtectionPauseDisplay}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsChatDisplayPaused}" />
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="{Binding Texts.ProtectionPauseDisplay}" FontWeight="SemiBold" />
                                        <TextBlock AutomationProperties.AutomationId="ProtectionPauseDisplayDescription"
                                                   Text="{Binding Texts.ProtectionPauseDisplayDescription}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border Background="{DynamicResource InputBrush}" CornerRadius="10" Padding="12,9">
                                <Grid ColumnDefinitions="Auto,12,*">
                                    <CheckBox AutomationProperties.AutomationId="ProtectionSuppressObsToggle"
                                              AutomationProperties.Name="{Binding Texts.ProtectionSuppressObs}"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsObsChatSuppressed}" />
                                    <StackPanel Grid.Column="2" Spacing="2">
                                        <TextBlock Text="{Binding Texts.ProtectionSuppressObs}" FontWeight="SemiBold" />
                                        <TextBlock AutomationProperties.AutomationId="ProtectionSuppressObsDescription"
                                                   Text="{Binding Texts.ProtectionSuppressObsDescription}"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <TextBlock Text="{Binding ProtectionSuppressedLabel}"
                                       IsVisible="{Binding IsChatDisplayPaused}"
                                       HorizontalAlignment="Center" Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </Border>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="{Binding ProtectionStatus}"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border x:Name="ProtectionActionsPanel" Grid.Row="4" Classes="subtle-card" Padding="14">
                        <StackPanel Spacing="10">
                            <TextBlock Text="{Binding Texts.ProtectionActions}"
                                       HorizontalAlignment="Center" TextAlignment="Center"
                                       FontSize="16" FontWeight="SemiBold" />
                            <Grid ColumnDefinitions="*,12,*">
                                <Border Grid.Column="0" Background="{DynamicResource InputBrush}"
                                        CornerRadius="10" Padding="12">
                                    <Grid RowDefinitions="*,10,Auto">
                                        <TextBlock AutomationProperties.AutomationId="ProtectionClearChatHint"
                                                   Text="{Binding Texts.ProtectionClearChatHint}"
                                                   HorizontalAlignment="Stretch" TextAlignment="Left"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <Button Grid.Row="2" Classes="danger"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="ProtectionClearChatButton"
                                                Content="{Binding Texts.ProtectionClearChat}"
                                                Command="{Binding RequestClearChatCommand}"
                                                IsEnabled="{Binding CanApplyProtection}" />
                                    </Grid>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource InputBrush}"
                                        CornerRadius="10" Padding="12">
                                    <Grid RowDefinitions="*,10,Auto">
                                        <TextBlock AutomationProperties.AutomationId="ProtectionApplyHint"
                                                   Text="{Binding Texts.ProtectionApplyHint}"
                                                   HorizontalAlignment="Stretch" TextAlignment="Left"
                                                   TextWrapping="Wrap" FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <Button Grid.Row="2" Classes="primary"
                                                HorizontalAlignment="Stretch"
                                                AutomationProperties.AutomationId="ProtectionApplyButton"
                                                Content="{Binding Texts.ProtectionApply}"
                                                Command="{Binding ApplyProtectionCommand}"
                                                IsEnabled="{Binding CanApplyProtection}" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>

                </Grid>
                </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="ClearChatConfirmationOverlay"
                AutomationProperties.AutomationId="ClearChatConfirmationOverlay"
                ZIndex="90" Background="#99000000"
                IsVisible="{Binding IsClearChatConfirmationOpen}">
            <Border x:Name="ClearChatConfirmationCard"
                    AutomationProperties.AutomationId="ClearChatConfirmationCard"
                    KeyboardNavigation.TabNavigation="Cycle"
                    MaxWidth="460" MaxHeight="420"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Classes="card" Background="{DynamicResource PopupBrush}" Padding="24">
                <Grid RowDefinitions="*,14,Auto">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <TextBlock Text="{Binding Texts.ProtectionClearConfirm}"
                                   TextWrapping="Wrap" FontSize="17" FontWeight="SemiBold" />
                    </ScrollViewer>
                    <Grid Grid.Row="2" ColumnDefinitions="*,8,*">
                        <Button HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="CancelClearChatButton"
                                Command="{Binding CancelClearChatCommand}">
                            <TextBlock Text="{Binding Texts.Cancel}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                        <Button Grid.Column="2" Classes="danger" HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="ConfirmClearChatButton"
                                Command="{Binding ConfirmClearChatCommand}">
                            <TextBlock Text="{Binding Texts.ProtectionClearChat}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="MomentsPanelOverlay" Background="#88000000"
                AutomationProperties.AutomationId="MomentsPanelOverlay"
                IsVisible="{Binding IsMomentsPanelOpen}">
            <Border x:Name="MomentsPanelCard" Width="760" Height="600"
                    KeyboardNavigation.TabNavigation="Cycle"
                    MaxWidth="{Binding $parent[Window].Bounds.Width}"
                    MaxHeight="{Binding $parent[Window].Bounds.Height}"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Classes="card" Padding="22" Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,14,*,14,Auto">
                    <Grid ColumnDefinitions="*,Auto,8,Auto">
                        <StackPanel Spacing="4">
                            <TextBlock x:Name="MomentsPanelTitle" Text="{Binding Texts.StreamMoments}"
                                       FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="MomentsPanelDescription" Text="{Binding Texts.StreamMomentsDescription}" TextWrapping="Wrap"
                                       FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Button x:Name="MomentsHelpButton" Grid.Column="1" Classes="context-help"
                                Content="?" Command="{Binding StartContextTutorialCommand}"
                                CommandParameter="Moments"
                                ToolTip.Tip="{Binding Texts.OpenMomentsTutorial}"
                                AutomationProperties.Name="{Binding Texts.OpenMomentsTutorial}" />
                        <Button Grid.Column="3" Classes="icon-button"
                                AutomationProperties.AutomationId="CloseMomentsButton"
                                AutomationProperties.Name="{Binding Texts.Close}"
                                ToolTip.Tip="{Binding Texts.Close}"
                                Command="{Binding CloseMomentsPanelCommand}">
                            <Path Data="M3,3 L11,11 M11,3 L3,11"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6" StrokeLineCap="Round" Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Border x:Name="MomentsListCard" Grid.Row="2" Classes="subtle-card" Padding="8">
                        <Grid>
                            <ListBox ItemsSource="{Binding Moments}"
                                     Background="Transparent"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:StreamMomentItemViewModel">
                                        <Border Margin="2,3" Padding="12,10" CornerRadius="9"
                                                Background="{DynamicResource SurfaceRaisedBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                            <Grid RowDefinitions="Auto,Auto,Auto" ColumnDefinitions="*,Auto" SizeChanged="MomentRow_OnSizeChanged">
                                                <Grid ColumnDefinitions="Auto,8,Auto,8,*">
                                                    <TextBlock Text="{Binding Platform}" FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                    <TextBlock Grid.Column="2" Text="{Binding ChannelLabel}" ToolTip.Tip="{Binding ChannelLabel}"
                                                               MaxWidth="150" TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    <TextBlock Grid.Column="4" Text="{Binding UserLabel}" ToolTip.Tip="{Binding UserLabel}"
                                                               TextTrimming="CharacterEllipsis"
                                                               FontWeight="SemiBold" />
                                                </Grid>
                                                <TextBlock Grid.Column="1" Text="{Binding TimeLabel}" FontSize="10"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Text}"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Text}" Margin="0,5,0,0" />
                                                <TextBlock Grid.Row="2" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                                           TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Note}" Margin="0,5,0,0"
                                                           Foreground="{DynamicResource WarningBrush}" />
                                                <Button Grid.Row="2" Grid.Column="1" Classes="tool"
                                                        Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.DeleteMoment}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DeleteMomentCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding Texts.NoStreamMoments}"
                                       IsVisible="{Binding !HasStreamMoments}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="4" Spacing="8">
                        <TextBlock Text="{Binding MomentsStatus}" IsVisible="{Binding HasMomentsStatus}"
                                   TextWrapping="Wrap" MaxHeight="60" TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding MomentsStatus}" Foreground="{DynamicResource WarningBrush}" />
                        <Button x:Name="ExportMomentsButton" HorizontalAlignment="Right" Classes="primary"
                                Content="{Binding Texts.ExportMoments}"
                                IsEnabled="{Binding HasStreamMoments}" Click="ExportMoments_OnClick" />
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border Background="#99000000" IsVisible="{Binding IsMomentEditorOpen}"
                Margin="0,42,0,0" Padding="10"
                AutomationProperties.AutomationId="MomentEditorOverlay">
            <Border x:Name="MomentEditorCard"
                    AutomationProperties.AutomationId="MomentEditorCard"
                    KeyboardNavigation.TabNavigation="Cycle"
                    MaxWidth="480" MaxHeight="600"
                    HorizontalAlignment="Stretch" VerticalAlignment="Center"
                    Classes="card" Padding="20" Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,12,*,12,Auto">
                    <TextBlock Text="{Binding Texts.SaveStreamMoment}" FontSize="21"
                               FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ScrollViewer x:Name="MomentEditorScrollViewer" Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="12">
                            <TextBlock Text="{Binding MomentTarget.Text}" TextWrapping="Wrap" MaxHeight="100"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBox Text="{Binding MomentNote}" MaxLength="500" AcceptsReturn="True"
                                     IsEnabled="{Binding !IsMomentsSaving}"
                                     AutomationProperties.AutomationId="MomentNoteInput"
                                     AutomationProperties.Name="{Binding Texts.MomentNotePlaceholder}"
                                     MinHeight="80" MaxHeight="180"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                                     PlaceholderText="{Binding Texts.MomentNotePlaceholder}" />
                            <TextBlock Text="{Binding MomentsStatus}" IsVisible="{Binding HasMomentsStatus}"
                                       TextWrapping="Wrap" MaxHeight="80" TextTrimming="CharacterEllipsis"
                                       ToolTip.Tip="{Binding MomentsStatus}" Foreground="{DynamicResource WarningBrush}" />
                        </StackPanel>
                    </ScrollViewer>
                    <Grid x:Name="MomentActionsPanel" Grid.Row="4"
                          ColumnDefinitions="Auto,8,Auto" HorizontalAlignment="Right">
                        <Button x:Name="CancelMomentButton" HorizontalAlignment="Stretch"
                                Content="{Binding Texts.Cancel}" Command="{Binding CancelSaveMomentCommand}" />
                        <Button x:Name="SaveMomentButton" Grid.Column="2" Classes="primary"
                                HorizontalAlignment="Stretch" Content="{Binding Texts.SaveStreamMoment}"
                                Command="{Binding ConfirmSaveMomentCommand}" />
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="ModerationPanelOverlay"
                Margin="0,42,0,0" Padding="10"
                Background="#88000000"
                IsVisible="False">
            <Border x:Name="ModerationPanelCard" MaxWidth="900" MaxHeight="620"
                    KeyboardNavigation.TabNavigation="Cycle"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Classes="card" Padding="10"
                    Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,Auto,Auto,*,Auto">
                    <Grid x:Name="ModerationHeader" ColumnDefinitions="*,Auto,8,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Texts.Moderation}"
                                       FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ModerationChannelLabel}"
                                       Margin="1,3,0,0" FontSize="11" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Button x:Name="ModerationHelpButton" Grid.Column="1" Classes="context-help"
                                Content="?" Command="{Binding StartContextTutorialCommand}"
                                CommandParameter="Moderation"
                                ToolTip.Tip="{Binding Texts.OpenModerationTutorial}"
                                AutomationProperties.Name="{Binding Texts.OpenModerationTutorial}"
                                AutomationProperties.AutomationId="ModerationHelpButton" />
                        <Button Grid.Column="3" Classes="icon-button"
                                AutomationProperties.AutomationId="CloseModerationButton"
                                AutomationProperties.Name="{Binding Texts.Close}"
                                ToolTip.Tip="{Binding Texts.Close}"
                                Command="{Binding CloseModerationPanelCommand}">
                            <Path Data="M3,3 L11,11 M11,3 L3,11"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <StackPanel x:Name="ModerationPlatformTabsPanel" Grid.Row="1" Margin="0,8,0,0" Orientation="Horizontal" Spacing="6"
                                IsVisible="{Binding IsYouTubeConnected}">
                        <Button Classes.moderation-tab="True"
                                Classes.selected="{Binding IsTwitchModerationSelected}"
                                Content="{Binding Texts.TwitchModeration}"
                                IsEnabled="{Binding CanModerate}"
                                Command="{Binding ShowTwitchModerationCommand}" />
                        <Button Classes.moderation-tab="True"
                                Classes.selected="{Binding IsYouTubeModerationSelected}"
                                Content="{Binding Texts.YouTubeModeration}"
                                IsVisible="{Binding IsYouTubeConnected}"
                                IsEnabled="{Binding CanModerateYouTube}"
                                Command="{Binding ShowYouTubeModerationCommand}" />
                    </StackPanel>
                    <Grid Grid.Row="2" Margin="0,8,0,0" ColumnDefinitions="*,Auto"
                          IsVisible="{Binding IsTwitchModerationSelected}">
                        <ScrollViewer x:Name="ModerationTabsScrollViewer" IsVisible="{Binding !IsCompactMode}"
                                      HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ModerationTabsPanel" Orientation="Horizontal">
                            <Button Classes.moderation-tab="True"
                                    Classes.selected="{Binding IsAutoModSelected}"
                                    Content="{Binding Texts.AutoMod}"
                                    Command="{Binding ShowAutoModCommand}" />
                            <Button Classes.moderation-tab="True"
                                    Classes.selected="{Binding IsBannedUsersSelected}"
                                    Content="{Binding Texts.BannedUsers}"
                                    Command="{Binding ShowBannedUsersCommand}" />
                            <Button Classes.moderation-tab="True"
                                    Classes.selected="{Binding IsUnbanRequestsSelected}"
                                    Content="{Binding Texts.UnbanRequests}"
                                    Command="{Binding ShowUnbanRequestsCommand}" />
                        </StackPanel>
                        </ScrollViewer>
                        <ComboBox x:Name="CompactModerationSectionSelector"
                                  IsVisible="{Binding IsCompactMode}"
                                  SelectedIndex="{Binding ModerationPanelSection, Mode=TwoWay}"
                                  AutomationProperties.Name="{Binding Texts.Moderation}"
                                  HorizontalAlignment="Stretch">
                            <ComboBoxItem Content="{Binding Texts.AutoMod}" />
                            <ComboBoxItem Content="{Binding Texts.BannedUsersShort}" />
                            <ComboBoxItem Content="{Binding Texts.UnbanRequestsShort}" />
                        </ComboBox>
                        <Button Grid.Column="1"
                                Margin="6,0,0,0"
                                Content="{Binding Texts.Refresh}"
                                IsEnabled="{Binding !IsModerationPanelBusy}"
                                Command="{Binding RefreshModerationPanelCommand}" />
                    </Grid>
                    <TextBlock Grid.Row="2" Margin="0,8,0,0"
                               Text="{Binding Texts.YouTubeBansCreatedHere}"
                               IsVisible="{Binding IsYouTubeModerationSelected}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <Border x:Name="ModerationContentCard" Grid.Row="3" Margin="0,8,0,0" Classes="subtle-card" Padding="8">
                            <Grid>
                                <Grid IsVisible="{Binding IsTwitchModerationSelected}">
                                <Grid x:Name="AutoModPanel" IsVisible="{Binding IsAutoModSelected}">
                                <ListBox x:Name="AutoModMessagesList" ItemsSource="{Binding PendingAutoModMessages}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:HeldAutoModMessageViewModel">
                                            <Border Classes="subtle-card" Padding="12" Margin="2,2,2,8">
                                                <Border.ContextMenu>
                                                    <ContextMenu Opening="MessageContextMenu_OnOpening"
                                                                 Closing="MessageContextMenu_OnClosing">
                                                        <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.RecentMessages}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowRecentMessagesForAutoModCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.OpenOnTwitch}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenModerationUserOnTwitchCommand}"
                                                                  CommandParameter="{Binding Value.UserLogin}" />
                                                    </ContextMenu>
                                                </Border.ContextMenu>
                                                <Grid RowDefinitions="Auto,Auto,Auto,Auto">
                                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding UserLabel}" FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UserLabel}" />
                                                        <TextBlock Text="{Binding LoginLabel}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding ChannelLabel}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" FontSize="10"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                    </Grid>
                                                    <TextBlock Grid.Row="1" Text="{Binding MessageText}"
                                                               Margin="0,7,0,0" TextWrapping="Wrap" />
                                                    <StackPanel Grid.Row="2" Margin="0,9,0,0">
                                                        <TextBlock Text="{Binding CategoryLabel}" FontSize="10"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding ErrorMessage}" FontSize="10"
                                                                   Foreground="{DynamicResource DangerBrush}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <Grid Grid.Row="3" ColumnDefinitions="*,6,*"
                                                          Margin="0,8,0,0" IsEnabled="{Binding !IsBusy}">
                                                        <Button HorizontalAlignment="Stretch"
                                                                Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Allow}"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).AllowAutoModMessageCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Grid.Column="2" HorizontalAlignment="Stretch"
                                                                Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Deny}"
                                                                Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DenyAutoModMessageCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </Grid>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="AutoModEmptyState"
                                           Text="{Binding Texts.NoAutoModMessages}"
                                           IsVisible="{Binding ShowNoAutoModMessages}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
                                </Grid>
                                <Grid x:Name="BannedUsersPanel" IsVisible="{Binding IsBannedUsersSelected}"
                                      RowDefinitions="Auto,6,Auto,6,*">
                                    <Grid>
                                        <TextBox AutomationProperties.AutomationId="ModerationUserLoginInput"
                                                 AutomationProperties.Name="{Binding Texts.UserLogin}"
                                                 Height="36"
                                                 MaxLength="25"
                                                 Text="{Binding ModerationUserLogin}"
                                                 PlaceholderText="{Binding Texts.UserLogin}" />
                                    </Grid>
                                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8">
                                        <Button x:Name="BanByLoginButton" Classes="primary" Height="32" MinHeight="32" Padding="10,4"
                                                Content="{Binding Texts.BanShort}"
                                                ToolTip.Tip="{Binding Texts.BanUser}"
                                                IsEnabled="{Binding CanBanByLogin}"
                                                Command="{Binding BanByLoginCommand}" />
                                        <Button Height="32" MinHeight="32" Padding="10,4"
                                                Content="{Binding Texts.UnbanShort}"
                                                ToolTip.Tip="{Binding Texts.Unban}"
                                                IsEnabled="{Binding CanUnbanByLogin}"
                                                Command="{Binding UnbanByLoginCommand}" />
                                    </StackPanel>
                                <ListBox Grid.Row="4"
                                         x:Name="BannedUsersList"
                                         ItemsSource="{Binding BannedUsers}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:BannedUserViewModel">
                                            <Grid ColumnDefinitions="*,Auto" Margin="6,7">
                                                <Grid.ContextMenu>
                                                    <ContextMenu Opening="MessageContextMenu_OnOpening"
                                                                 Closing="MessageContextMenu_OnClosing">
                                                        <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.RecentMessages}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowRecentMessagesForBannedUserCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.OpenOnTwitch}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenModerationUserOnTwitchCommand}"
                                                                  CommandParameter="{Binding Value.UserLogin}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding UserLabel}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UserLabel}" />
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding LoginLabel}" FontSize="11"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <TextBlock Text="{Binding DurationLabel}" FontSize="11"
                                                                   TextWrapping="Wrap"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </StackPanel>
                                                    <TextBlock Text="{Binding Reason}" FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource MutedTextBrush}" />
                                                </StackPanel>
                                                <Button Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top"
                                                        IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanUnbanUsers}"
                                                        Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.UnbanShort}"
                                                        ToolTip.Tip="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Unban}"
                                                        Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UnbanListedUserCommand}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="4" Text="{Binding Texts.NoBannedUsers}"
                                           IsVisible="{Binding ShowNoBannedUsers}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
                                </Grid>
                                <Grid x:Name="UnbanRequestsPanel" IsVisible="{Binding IsUnbanRequestsSelected}"
                                      RowDefinitions="Auto,8,*">
                                    <WrapPanel x:Name="UnbanRequestFilters" Orientation="Horizontal">
                                        <Button Classes.moderation-tab="True"
                                                Classes.selected="{Binding IsPendingUnbanRequestsSelected}"
                                                Content="{Binding Texts.Pending}"
                                                Command="{Binding ShowPendingUnbanRequestsCommand}" />
                                        <Button Classes.moderation-tab="True"
                                                Classes.selected="{Binding IsApprovedUnbanRequestsSelected}"
                                                Content="{Binding Texts.Approved}"
                                                Command="{Binding ShowApprovedUnbanRequestsCommand}" />
                                        <Button Classes.moderation-tab="True"
                                                Classes.selected="{Binding IsDeniedUnbanRequestsSelected}"
                                                Content="{Binding Texts.Denied}"
                                                Command="{Binding ShowDeniedUnbanRequestsCommand}" />
                                    </WrapPanel>
                                <ListBox x:Name="UnbanRequestsList" Grid.Row="2"
                                         ItemsSource="{Binding VisibleUnbanRequests}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                         Background="Transparent">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="models:UnbanRequestViewModel">
                                            <Grid RowDefinitions="Auto,Auto" Margin="6,7">
                                                <Grid.ContextMenu>
                                                    <ContextMenu Opening="MessageContextMenu_OnOpening"
                                                                 Closing="MessageContextMenu_OnClosing">
                                                        <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.RecentMessages}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowRecentMessagesForUnbanRequestCommand}"
                                                                  CommandParameter="{Binding}" />
                                                        <MenuItem Header="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.OpenOnTwitch}"
                                                                  Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).OpenModerationUserOnTwitchCommand}"
                                                                  CommandParameter="{Binding Value.UserLogin}" />
                                                    </ContextMenu>
                                                </Grid.ContextMenu>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding UserLabel}" FontWeight="SemiBold"
                                                               TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding UserLabel}" />
                                                    <TextBlock Text="{Binding LoginLabel}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Text="{Binding Text}" Margin="0,4,0,0"
                                                               TextWrapping="Wrap" />
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding CreatedAtLabel}" FontSize="10"
                                                                   Margin="0,0,8,0"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                        <TextBlock Text="{Binding StatusLabel}" FontSize="10"
                                                                   Foreground="{DynamicResource AccentBrush}" />
                                                    </WrapPanel>
                                                    <TextBlock Text="{Binding ResolutionText}"
                                                               IsVisible="{Binding HasResolutionText}"
                                                               Margin="0,4,0,0"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                                <Grid Grid.Row="1" ColumnDefinitions="*,6,*" Margin="0,8,0,0"
                                                      IsVisible="{Binding CanResolve}"
                                                      IsEnabled="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).CanUnbanUsers}">
                                                    <Button HorizontalAlignment="Stretch"
                                                            Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Approve}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ApproveUnbanRequestCommand}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Grid.Column="2" HorizontalAlignment="Stretch"
                                                            Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Deny}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).DenyUnbanRequestCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Grid.Row="2" x:Name="UnbanRequestsEmptyState"
                                           Text="{Binding EmptyUnbanRequestsLabel}"
                                           IsVisible="{Binding ShowNoUnbanRequests}"
                                           TextWrapping="Wrap" TextAlignment="Center" Margin="12"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedTextBrush}" IsHitTestVisible="False" />
                                </Grid>
                                </Grid>
                                <Grid IsVisible="{Binding IsYouTubeModerationSelected}"
                                      RowDefinitions="Auto,12,*">
                                    <TextBlock Text="{Binding Texts.YouTubeBansApiNote}"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                    <ListBox Grid.Row="2"
                                             ItemsSource="{Binding YouTubeBans}"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                                             Background="Transparent">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate x:DataType="models:YouTubeChatBanViewModel">
                                                <Grid ColumnDefinitions="*,Auto" Margin="6,7">
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding UserLabel}" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding ChannelIdLabel}"
                                                                   FontSize="10"
                                                                   TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        <TextBlock Text="{Binding DurationLabel}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1"
                                                            Content="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Unban}"
                                                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).UnbanYouTubeUserCommand}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Grid.Row="2"
                                               Text="{Binding Texts.NoModerationItems}"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="8"
                                               IsVisible="{Binding !HasYouTubeBans}"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               Foreground="{DynamicResource MutedTextBrush}" />
                                </Grid>
                            </Grid>
                    </Border>
                    <TextBlock x:Name="ModerationPanelStatusLabel" Grid.Row="4" Margin="0,6,0,0"
                               Text="{Binding ModerationPanelStatus}" IsVisible="{Binding HasModerationPanelStatus}"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                </Grid>
            </Border>
        </Border>

        <Border ZIndex="80"
                AutomationProperties.AutomationId="RecentMessagesOverlay"
                Margin="0,42,0,0" Padding="10"
                Background="#A0000000"
                IsVisible="{Binding IsRecentMessagesOpen}">
            <Border x:Name="RecentMessagesCard"
                    AutomationProperties.AutomationId="RecentMessagesCard"
                    KeyboardNavigation.TabNavigation="Cycle"
                    MaxWidth="620" MaxHeight="460"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Classes="card"
                    Padding="14"
                    Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,12,*">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Texts.RecentMessages}"
                                       FontSize="21"
                                       TextTrimming="CharacterEllipsis"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding RecentMessagesUserLabel}"
                                       Margin="0,4,0,0"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="icon-button"
                                AutomationProperties.AutomationId="CloseRecentMessagesButton"
                                AutomationProperties.Name="{Binding Texts.Close}"
                                ToolTip.Tip="{Binding Texts.Close}"
                                Command="{Binding CloseRecentMessagesCommand}">
                            <Path Data="M3,3 L11,11 M11,3 L3,11"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6"
                                  StrokeLineCap="Round"
                                  Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <Border Grid.Row="2" Classes="subtle-card" Padding="8">
                        <Grid>
                            <ListBox AutomationProperties.AutomationId="RecentMessagesList"
                                     ItemsSource="{Binding RecentUserMessages}"
                                     Background="Transparent"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:RecentUserMessageViewModel">
                                        <StackPanel Spacing="4" Margin="4,7">
                                            <TextBlock Text="{Binding TimeText}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                            <TextBlock Text="{Binding Text}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock Text="{Binding Texts.NoRecentMessages}"
                                       IsVisible="{Binding ShowNoRecentMessages}"
                                       TextWrapping="Wrap" TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="DeleteLogOverlay"
                Background="#99000000"
                IsVisible="False">
            <Border x:Name="DeleteLogCard" Width="430" HorizontalAlignment="Center" VerticalAlignment="Center"
                    KeyboardNavigation.TabNavigation="Cycle"
                    Classes="card" Padding="24"
                    Background="{DynamicResource PopupBrush}">
                <StackPanel Spacing="16">
                    <TextBlock Text="{Binding Texts.DeleteLog}"
                               FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Texts.DeleteLogQuestion}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource SecondaryTextBrush}" />
                    <TextBlock Text="{Binding SelectedLogFile.Title}"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="{Binding Texts.StreamDate}"
                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                        <TextBlock x:Name="DeleteLogStreamDate"
                                   AutomationProperties.AutomationId="DeleteLogStreamDate"
                                   Text="{Binding SelectedLogFile.DateText}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource PrimaryTextBrush}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
                        <Button Content="{Binding Texts.Cancel}"
                                Command="{Binding CancelDeleteLogCommand}" />
                        <Button Classes="danger" Content="{Binding Texts.Delete}"
                                Command="{Binding ConfirmDeleteLogCommand}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>

        <Border x:Name="ModerationDialogOverlay"
                AutomationProperties.AutomationId="ModerationDialogOverlay"
                Margin="0,42,0,0" Padding="10"
                Background="#88000000"
                IsVisible="False">
            <Border x:Name="ModerationDialogCard" MaxWidth="520" MaxHeight="520"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    KeyboardNavigation.TabNavigation="Cycle"
                    Classes="card" Padding="12"
                    Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,8,*,8,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Texts.ModerationAction}"
                                       FontSize="20" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ModerationTargetLabel}"
                                       Margin="0,3,0,0" FontSize="13" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource AccentBrush}" />
                        </StackPanel>
                        <Button x:Name="CloseModerationDialogButton" Grid.Column="1" Classes="icon-button"
                                AutomationProperties.Name="{Binding Texts.Close}"
                                Command="{Binding CancelModerationCommand}"
                                ToolTip.Tip="{Binding Texts.Close}">
                            <Path Data="M5,5 L15,15 M15,5 L5,15"
                                  Stroke="{DynamicResource SecondaryTextBrush}"
                                  StrokeThickness="1.6" StrokeLineCap="Round"
                                  Width="14" Height="14" />
                        </Button>
                    </Grid>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"
                                  IsEnabled="{Binding !IsModerationBusy}"
                                  HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Texts.TimeoutDuration}"
                               FontSize="12" Foreground="{DynamicResource MutedTextBrush}" />
                    <WrapPanel>
                        <Button Content="{Binding Texts.PermanentBan}" Margin="0,0,7,7"
                                Command="{Binding SetModerationDurationCommand}" CommandParameter="0" />
                        <Button Content="{Binding Texts.OneMinute}" Margin="0,0,7,7"
                                Command="{Binding SetModerationDurationCommand}" CommandParameter="1" />
                        <Button Content="{Binding Texts.TenMinutes}" Margin="0,0,7,7"
                                Command="{Binding SetModerationDurationCommand}" CommandParameter="10" />
                        <Button Content="{Binding Texts.OneHour}" Margin="0,0,7,7"
                                Command="{Binding SetModerationDurationCommand}" CommandParameter="60" />
                        <Button Content="{Binding Texts.OneDay}" Margin="0,0,0,7"
                                Command="{Binding SetModerationDurationCommand}" CommandParameter="1440" />
                        <TextBlock Text="{Binding ModerationDurationLabel}"
                                   Margin="10,7,0,0" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                    </WrapPanel>
                    <TextBox Text="{Binding ModerationReason}"
                             AutomationProperties.AutomationId="ModerationReasonInput"
                             AutomationProperties.Name="{Binding Texts.ModerationReason}"
                             IsVisible="{Binding ShowModerationReason}"
                             MaxLength="500"
                             PlaceholderText="{Binding Texts.ModerationReason}" />
                    <TextBlock Text="{Binding ModerationActionError}" TextWrapping="Wrap"
                               Foreground="{DynamicResource DangerBrush}" />
                    </StackPanel>
                    </ScrollViewer>
                    <Grid Grid.Row="4" ColumnDefinitions="*,8,*" MaxWidth="340"
                          HorizontalAlignment="Stretch">
                        <Button Content="{Binding Texts.Cancel}"
                                HorizontalAlignment="Stretch"
                                IsEnabled="{Binding !IsModerationBusy}"
                                Command="{Binding CancelModerationCommand}" />
                        <Button x:Name="ConfirmModerationButton" Grid.Column="2" Classes="primary"
                                HorizontalAlignment="Stretch" Command="{Binding ConfirmModerationCommand}">
                            <TextBlock Text="{Binding ModerationConfirmLabel}" TextWrapping="Wrap" TextAlignment="Center" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="ConnectPanelOverlay"
                ZIndex="40"
                Background="#88000000"
                IsVisible="False"
                PointerPressed="ConnectPanelScrim_OnPointerPressed">
            <Border x:Name="ConnectPanelCard"
                    AutomationProperties.AutomationId="ConnectPanelCard"
                    KeyboardNavigation.TabNavigation="Cycle"
                    Width="940"
                    MaxWidth="940"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Stretch"
                    Margin="18"
                    Padding="24"
                    Classes="card"
                    Background="{DynamicResource PopupBrush}">
                <Grid MaxWidth="620"
                      HorizontalAlignment="Stretch"
                      RowDefinitions="Auto,16,*">
                    <Grid x:Name="ConnectPanelHeader" ColumnDefinitions="*,Auto,8,Auto" ColumnSpacing="8">
                        <StackPanel x:Name="ConnectHeaderText">
                            <TextBlock Text="{Binding Texts.ConnectTwitch}"
                                       FontSize="24"
                                       TextWrapping="Wrap"
                                       FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Texts.ConnectTwitchIntro}"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="1,7,0,0" />
                        </StackPanel>
                        <Button x:Name="ConnectHelpButton" Grid.Column="1" Classes="context-help"
                                Content="?" Command="{Binding StartContextTutorialCommand}"
                                CommandParameter="Connect"
                                ToolTip.Tip="{Binding Texts.OpenConnectTutorial}"
                                AutomationProperties.Name="{Binding Texts.OpenConnectTutorial}"
                                AutomationProperties.AutomationId="ConnectHelpButton" />
                        <Button x:Name="ConnectPanelBackButton" Grid.Column="3"
                                AutomationProperties.AutomationId="ConnectPanelBackButton"
                                VerticalAlignment="Top"
                                Content="{Binding Texts.Back}"
                                Command="{Binding CloseConnectPanelCommand}" />
                    </Grid>

                    <ScrollViewer x:Name="ConnectBodyScrollViewer" Grid.Row="2"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                    <Grid MinHeight="{Binding #ConnectBodyScrollViewer.Bounds.Height}"
                          RowDefinitions="Auto,12,*">
                        <Button x:Name="ConnectPanelSignIn" AutomationProperties.AutomationId="ConnectPanelSignIn"
                                IsVisible="{Binding !IsAccountConnected}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Stretch"
                                VerticalContentAlignment="Stretch"
                                MinHeight="84"
                                Padding="0"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                Command="{Binding SignInFromConnectPanelCommand}">
                            <Border Classes="subtle-card"
                                    HorizontalAlignment="Stretch"
                                    Padding="18">
                                <Grid ColumnDefinitions="52,*">
                                    <Border x:Name="ConnectPanelTwitchLogo"
                                            Width="40" Height="40" CornerRadius="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#18131F"
                                            BorderBrush="#4D9146FF"
                                            BorderThickness="1">
                                        <Viewbox Width="24" Height="28"
                                                 Stretch="Uniform"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="2400" Height="2800">
                                                <Path Fill="#9146FF"
                                                      Data="M500,0 L0,500 V2300 H600 V2800 L1100,2300 H1500 L2400,1400 V0 H500 Z" />
                                                <Path Fill="#FFFFFF"
                                                      Data="M2200,1300 L1800,1700 H1400 L1050,2050 V1700 H600 V200 H2200 Z" />
                                                <Rectangle Canvas.Left="1700" Canvas.Top="550"
                                                           Width="200" Height="600" Fill="#9146FF" />
                                                <Rectangle Canvas.Left="1150" Canvas.Top="550"
                                                           Width="200" Height="600" Fill="#9146FF" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texts.SignInWithTwitch}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   FontSize="15" />
                                        <TextBlock Text="{Binding Texts.FullAccessDescription}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Button>

                        <Border x:Name="ConnectWatchCard" Grid.Row="2"
                                Classes="subtle-card"
                                Padding="18">
                            <Grid RowDefinitions="Auto,14,Auto,12,*">
                                <Grid ColumnDefinitions="52,*">
                                    <Border x:Name="ConnectPanelWatchIcon"
                                            Width="40" Height="40" CornerRadius="20"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Background="#262F5AE8"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1">
                                        <Viewbox Width="22" Height="22"
                                                 Stretch="Uniform"
                                                 HorizontalAlignment="Center"
                                                 VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Data="F0 M12,4 C5.5,4 1,12 1,12 C1,12 5.5,20 12,20 C18.5,20 23,12 23,12 C23,12 18.5,4 12,4 Z M12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 Z"
                                                      Fill="{DynamicResource PrimaryTextBrush}" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="12,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Texts.WatchChannelWithoutSignIn}"
                                                   FontWeight="SemiBold"
                                                   TextWrapping="Wrap"
                                                   FontSize="15" />
                                        <TextBlock Text="{Binding Texts.WatchOnlyDescription}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0" />
                                    </StackPanel>
                                </Grid>

                                <Grid x:Name="ConnectChannelTabs" Grid.Row="2" ColumnDefinitions="*,10,*">
                                    <Button AutomationProperties.AutomationId="ConnectPanelManualTab"
                                            Classes.connect-channel-tab="True"
                                            Classes.selected="{Binding IsManualChannelTabSelected}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding ShowManualChannelTabCommand}">
                                        <TextBlock Text="{Binding Texts.ManualChannelTab}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Button>
                                    <Button Grid.Column="2"
                                            AutomationProperties.AutomationId="ConnectPanelFollowedTab"
                                            Classes.connect-channel-tab="True"
                                            Classes.selected="{Binding IsFollowedChannelsTabSelected}"
                                            HorizontalAlignment="Stretch"
                                            Command="{Binding ShowFollowedChannelsTabCommand}">
                                        <TextBlock Text="{Binding Texts.FollowedChannelsTab}"
                                                   TextAlignment="Center"
                                                   TextWrapping="Wrap" />
                                    </Button>
                                </Grid>

                                <Grid Grid.Row="4"
                                      RowDefinitions="Auto,14,Auto,Auto,Auto,*"
                                      IsVisible="{Binding IsManualChannelTabSelected}">
                                <Grid x:Name="ConnectManualInputRow" Grid.Row="2" ColumnDefinitions="*,12,Auto">
                                    <TextBox x:Name="ConnectPanelChannelInput" AutomationProperties.AutomationId="ConnectPanelChannelInput"
                                             AutomationProperties.Name="{Binding Texts.TwitchChannelName}"
                                             Height="42"
                                             MinHeight="42"
                                             MaxLength="25"
                                             Text="{Binding ConnectPanelChannel}"
                                             PlaceholderText="{Binding Texts.TwitchChannelName}"
                                             KeyDown="ConnectPanelChannel_OnKeyDown" />
                                    <Button x:Name="ConnectPanelWatchButton" Grid.Column="2"
                                            AutomationProperties.AutomationId="ConnectPanelWatchButton"
                                            Classes="primary"
                                            Width="128"
                                            Height="42"
                                            MinHeight="42"
                                            IsEnabled="{Binding CanWatchChannel}"
                                            Content="{Binding Texts.Connect}"
                                            Command="{Binding WatchChannelFromConnectPanelCommand}" />
                                </Grid>
                                <ProgressBar Grid.Row="3"
                                             Margin="2,8,2,0"
                                             Height="2"
                                             IsIndeterminate="True"
                                             IsVisible="{Binding IsChannelSearchBusy}" />
                                <Border Grid.Row="4"
                                        Margin="0,8,0,0"
                                        Padding="6"
                                        Classes="subtle-card"
                                        AutomationProperties.AutomationId="ConnectPanelSearchResults"
                                        IsVisible="{Binding HasChannelSearchResults}">
                                <ItemsControl ItemsSource="{Binding ChannelSearchResults}">
                                    <ItemsControl.Styles>
                                        <Style Selector="ContentPresenter">
                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        </Style>
                                    </ItemsControl.Styles>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="models:ChannelSearchResultViewModel">
                                            <Button Background="Transparent"
                                                    BorderBrush="Transparent"
                                                    HorizontalAlignment="Stretch"
                                                    HorizontalContentAlignment="Stretch"
                                                    MinHeight="58"
                                                    Padding="10,8"
                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectChannelSearchResultCommand}"
                                                    CommandParameter="{Binding}">
                                                <Grid ColumnDefinitions="40,12,*,16,112"
                                                                      SizeChanged="ChannelResultRow_OnSizeChanged">
                                                    <Border Width="40" Height="40" CornerRadius="20"
                                                            Background="{DynamicResource ButtonBrush}"
                                                            ClipToBounds="True">
                                                        <Image Source="{Binding Thumbnail.Image}"
                                                               Stretch="UniformToFill"
                                                               IsVisible="{Binding Thumbnail.HasImage}" />
                                                    </Border>
                                                    <StackPanel Grid.Column="2"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding DisplayName}"
                                                                   FontWeight="SemiBold"
                                                                   TextTrimming="CharacterEllipsis" />
                                                        <Grid ColumnDefinitions="Auto,7,*">
                                                            <TextBlock Text="{Binding LoginLabel}" MaxWidth="180"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LoginLabel}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                            <TextBlock Grid.Column="2" Text="{Binding GameName}" ToolTip.Tip="{Binding GameName}"
                                                                       FontSize="10"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                        </Grid>
                                                    </StackPanel>
                                                    <Grid Grid.Column="4"
                                                          RowDefinitions="Auto,Auto"
                                                          VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="5"
                                                                    HorizontalAlignment="Right">
                                                            <Ellipse Width="7" Height="7"
                                                                     Fill="{DynamicResource DangerBrush}"
                                                                     IsVisible="{Binding IsLive}" />
                                                            <Ellipse Width="7" Height="7"
                                                                     Fill="{DynamicResource MutedTextBrush}"
                                                                     IsVisible="{Binding !IsLive}" />
                                                            <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Live}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource DangerBrush}"
                                                                       IsVisible="{Binding IsLive}" />
                                                            <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Offline}"
                                                                       FontSize="10"
                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                       IsVisible="{Binding !IsLive}" />
                                                        </StackPanel>
                                                        <StackPanel Grid.Row="1"
                                                                    Orientation="Horizontal"
                                                                    Spacing="4"
                                                                    Margin="0,3,0,0"
                                                                    HorizontalAlignment="Right"
                                                                    IsVisible="{Binding HasViewerCount}">
                                                                <Path Width="11" Height="8"
                                                                      Stretch="Uniform"
                                                                      Fill="{DynamicResource MutedTextBrush}"
                                                                      Data="F0 M12,4 C5.5,4 1,12 1,12 C1,12 5.5,20 12,20 C18.5,20 23,12 23,12 C23,12 18.5,4 12,4 Z M12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 Z" />
                                                                <TextBlock Text="{Binding ViewerCount}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </Border>
                                <StackPanel Grid.Row="5" Margin="2,8,0,0">
                                    <TextBlock Text="{Binding ChannelSearchStatus}"
                                               Foreground="{DynamicResource MutedTextBrush}"
                                               TextWrapping="Wrap"
                                               IsVisible="{Binding HasChannelSearchStatus}" />
                                    <TextBlock
                                           Text="{Binding ConnectPanelError}"
                                           Foreground="{DynamicResource DangerBrush}"
                                           TextWrapping="Wrap" />
                                </StackPanel>
                                </Grid>

                                <Grid Grid.Row="4"
                                      RowDefinitions="Auto,12,Auto,10,Auto,*"
                                      IsVisible="{Binding IsFollowedChannelsTabSelected}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts.FollowedChannelsTitle}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Texts.FollowedChannelsDescription}"
                                                   Margin="0,5,0,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>

                                    <Border Grid.Row="2"
                                            AutomationProperties.AutomationId="FollowedChannelsSignInCard"
                                            Classes="subtle-card"
                                            Padding="14"
                                            IsVisible="{Binding ShowFollowedChannelsSignInRequest}">
                                        <TextBlock Text="{Binding Texts.FollowedChannelsSignInRequired}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Border>

                                    <Border Grid.Row="2"
                                            AutomationProperties.AutomationId="FollowedChannelsPermissionCard"
                                            Classes="subtle-card"
                                            Padding="14"
                                            IsVisible="{Binding ShowFollowedChannelsPermissionRequest}">
                                        <Grid x:Name="ConnectFollowedPermissionRow" ColumnDefinitions="*,12,Auto">
                                            <TextBlock Text="{Binding Texts.FollowedChannelsPermissionRequired}"
                                                       VerticalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                            <Button x:Name="ConnectFollowedPermissionButton" Grid.Column="2"
                                                    Classes="primary"
                                                    VerticalAlignment="Center"
                                                    IsEnabled="{Binding CanReauthorizeFollowedChannels}"
                                                    Command="{Binding ReauthorizeFollowedChannelsCommand}">
                                                <TextBlock Text="{Binding Texts.GrantFollowedChannelsAccess}"
                                                           TextWrapping="Wrap" TextAlignment="Center" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Grid Grid.Row="2"
                                          RowDefinitions="Auto,Auto,Auto,*"
                                          IsVisible="{Binding ShowFollowedChannelsContent}">
                                        <Grid x:Name="ConnectFollowedInputRow" ColumnDefinitions="*,10,Auto">
                                            <TextBox Height="42"
                                                     AutomationProperties.AutomationId="FollowedChannelsSearchInput"
                                                     AutomationProperties.Name="{Binding Texts.FollowedChannelsSearchPlaceholder}"
                                                     MinHeight="42"
                                                     Text="{Binding FollowedChannelsSearch}"
                                                     PlaceholderText="{Binding Texts.FollowedChannelsSearchPlaceholder}" />
                                            <Button x:Name="ConnectFollowedRefreshButton" Grid.Column="2"
                                                    AutomationProperties.AutomationId="FollowedChannelsRefreshButton"
                                                    Height="42"
                                                    MinHeight="42"
                                                    Content="{Binding Texts.Refresh}"
                                                    Command="{Binding RefreshFollowedChannelsCommand}" />
                                        </Grid>
                                        <ProgressBar Grid.Row="1"
                                                     Margin="2,8,2,0"
                                                     Height="2"
                                                     IsIndeterminate="True"
                                                     IsVisible="{Binding IsFollowedChannelsLoading}" />
                                        <TextBlock Grid.Row="2"
                                                   Margin="2,8,0,0"
                                                   Text="{Binding FollowedChannelsStatus}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   IsVisible="{Binding HasFollowedChannelsStatus}" />
                                        <Border Grid.Row="3"
                                                Margin="0,8,0,0"
                                                Padding="6"
                                                Classes="subtle-card"
                                                IsVisible="{Binding HasFollowedChannels}">
                                                <ItemsControl ItemsSource="{Binding FollowedChannels}">
                                                    <ItemsControl.Styles>
                                                        <Style Selector="ContentPresenter">
                                                            <Setter Property="HorizontalAlignment" Value="Stretch" />
                                                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        </Style>
                                                    </ItemsControl.Styles>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate x:DataType="models:ChannelSearchResultViewModel">
                                                            <Button Background="Transparent"
                                                                    BorderBrush="Transparent"
                                                                    HorizontalAlignment="Stretch"
                                                                    HorizontalContentAlignment="Stretch"
                                                                    MinHeight="58"
                                                                    Padding="10,8"
                                                                    Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).SelectFollowedChannelCommand}"
                                                                    CommandParameter="{Binding}">
                                                                <Grid ColumnDefinitions="40,12,*,16,112"
                                                                      SizeChanged="ChannelResultRow_OnSizeChanged">
                                                                    <Border Width="40" Height="40" CornerRadius="20"
                                                                            Background="{DynamicResource ButtonBrush}"
                                                                            ClipToBounds="True">
                                                                        <Image Source="{Binding Thumbnail.Image}"
                                                                               Stretch="UniformToFill"
                                                                               IsVisible="{Binding Thumbnail.HasImage}" />
                                                                    </Border>
                                                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                                        <TextBlock Text="{Binding DisplayName}" ToolTip.Tip="{Binding DisplayName}"
                                                                                   FontWeight="SemiBold"
                                                                                   TextTrimming="CharacterEllipsis" />
                                                                        <Grid ColumnDefinitions="Auto,7,*">
                                                                            <TextBlock Text="{Binding LoginLabel}" MaxWidth="180"
                                                                       TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding LoginLabel}"
                                                                                       FontSize="10"
                                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                                            <TextBlock Grid.Column="2" Text="{Binding GameName}" ToolTip.Tip="{Binding GameName}"
                                                                                       FontSize="10"
                                                                                       TextTrimming="CharacterEllipsis"
                                                                                       Foreground="{DynamicResource SecondaryTextBrush}" />
                                                                        </Grid>
                                                                    </StackPanel>
                                                                    <Grid Grid.Column="4" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                                                                        <StackPanel Orientation="Horizontal"
                                                                                    Spacing="5"
                                                                                    HorizontalAlignment="Right">
                                                                            <Ellipse Width="7" Height="7"
                                                                                     Fill="{DynamicResource DangerBrush}"
                                                                                     IsVisible="{Binding IsLive}" />
                                                                            <Ellipse Width="7" Height="7"
                                                                                     Fill="{DynamicResource MutedTextBrush}"
                                                                                     IsVisible="{Binding !IsLive}" />
                                                                            <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Live}"
                                                                                       FontSize="10"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource DangerBrush}"
                                                                                       IsVisible="{Binding IsLive}" />
                                                                            <TextBlock Text="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).Texts.Offline}"
                                                                                       FontSize="10"
                                                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                                                       IsVisible="{Binding !IsLive}" />
                                                                        </StackPanel>
                                                                        <StackPanel Grid.Row="1"
                                                                                    Orientation="Horizontal"
                                                                                    Spacing="4"
                                                                                    Margin="0,3,0,0"
                                                                                    HorizontalAlignment="Right"
                                                                                    IsVisible="{Binding HasViewerCount}">
                                                                            <Path Width="11" Height="8"
                                                                                  Stretch="Uniform"
                                                                                  Fill="{DynamicResource MutedTextBrush}"
                                                                                  Data="F0 M12,4 C5.5,4 1,12 1,12 C1,12 5.5,20 12,20 C18.5,20 23,12 23,12 C23,12 18.5,4 12,4 Z M12,7 C14.76,7 17,9.24 17,12 C17,14.76 14.76,17 12,17 C9.24,17 7,14.76 7,12 C7,9.24 9.24,7 12,7 Z" />
                                                                            <TextBlock Text="{Binding ViewerCount}"
                                                                                       FontSize="10"
                                                                                       Foreground="{DynamicResource MutedTextBrush}" />
                                                                        </StackPanel>
                                                                    </Grid>
                                                                </Grid>
                                                            </Button>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                        </Border>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="SettingsOverlay"
                Background="#88000000"
                IsVisible="False"
                PointerPressed="SettingsScrim_OnPointerPressed">
            <Border x:Name="SettingsCard" Width="940"
                    KeyboardNavigation.TabNavigation="Cycle"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Margin="18"
                    Classes="card" Padding="24"
                    Background="{DynamicResource PopupBrush}">
                <Grid RowDefinitions="Auto,16,*,14,Auto">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel>
                            <TextBlock Text="{Binding Texts.Settings}"
                                       FontSize="24" FontWeight="SemiBold" />
                            <TextBlock x:Name="SettingsIntroLabel" Text="{Binding Texts.SettingsIntro}"
                                       Margin="1,6,0,0" FontSize="12" TextWrapping="Wrap"
                                       Foreground="{DynamicResource MutedTextBrush}" />
                        </StackPanel>
                        <Button x:Name="SettingsHelpButton" Grid.Column="1" Classes="context-help"
                                Content="?" Command="{Binding StartContextTutorialCommand}"
                                CommandParameter="Settings"
                                ToolTip.Tip="{Binding Texts.OpenSettingsTutorial}"
                                AutomationProperties.Name="{Binding Texts.OpenSettingsTutorial}"
                                AutomationProperties.AutomationId="SettingsHelpButton" />
                    </Grid>

                    <Grid x:Name="SettingsBodyGrid" Grid.Row="2" ColumnDefinitions="210,18,*">
                        <ComboBox x:Name="CompactSettingsSectionSelector" Grid.ColumnSpan="3"
                                  IsVisible="False" HorizontalAlignment="Stretch"
                                  AutomationProperties.Name="{Binding Texts.Settings}"
                                  SelectedIndex="{Binding SelectedSettingsSectionIndex}">
                            <ComboBoxItem Content="{Binding Texts.Program}" />
                            <ComboBoxItem Content="{Binding Texts.Chat}" />
                            <ComboBoxItem Content="{Binding Texts.ChatLogs}" />
                            <ComboBoxItem Content="{Binding Texts.ObsOverlay}" />
                            <ComboBoxItem Content="{Binding Texts.Account}" />
                            <ComboBoxItem Content="{Binding Texts.Donate}" />
                            <ComboBoxItem Content="{Binding Texts.Advanced}" />
                        </ComboBox>
                        <Border x:Name="SettingsNavigationCard"
                                Classes="subtle-card" Padding="10">
                            <StackPanel>
                                <Button Classes.settings-nav="True"
                                        Classes.selected="{Binding IsProgramSettingsSelected}"
                                        AutomationProperties.AutomationId="ProgramSettingsNav"
                                        Command="{Binding ShowProgramSettingsCommand}">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                Margin="0,7" IsVisible="{Binding IsProgramSettingsSelected}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Texts.Program}" Margin="13,8" />
                                    </Grid>
                                </Button>
                                <Button Classes.settings-nav="True"
                                        Classes.selected="{Binding IsChatSettingsSelected}"
                                        AutomationProperties.AutomationId="ChatSettingsNav"
                                        Command="{Binding ShowChatSettingsCommand}">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                Margin="0,7" IsVisible="{Binding IsChatSettingsSelected}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Texts.Chat}" Margin="13,8" />
                                    </Grid>
                                </Button>
                                <Button Classes.settings-nav="True"
                                        Classes.selected="{Binding IsChatLogsSettingsSelected}"
                                        AutomationProperties.AutomationId="ChatLogsSettingsNav"
                                        Command="{Binding ShowChatLogsSettingsCommand}">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                Margin="0,7" IsVisible="{Binding IsChatLogsSettingsSelected}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Texts.ChatLogs}" Margin="13,8" />
                                    </Grid>
                                </Button>
                                <Button Classes.settings-nav="True"
                                        Classes.selected="{Binding IsOverlaySettingsSelected}"
                                        AutomationProperties.AutomationId="OverlaySettingsNav"
                                        Command="{Binding ShowOverlaySettingsCommand}">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                Margin="0,7" IsVisible="{Binding IsOverlaySettingsSelected}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Texts.ObsOverlay}" Margin="13,8" />
                                    </Grid>
                                </Button>
                                <Button Classes.settings-nav="True"
                                        Classes.selected="{Binding IsAccountSettingsSelected}"
                                        AutomationProperties.AutomationId="AccountSettingsNav"
                                        Command="{Binding ShowAccountSettingsCommand}">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                Margin="0,7" IsVisible="{Binding IsAccountSettingsSelected}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Texts.Account}" Margin="13,8" />
                                    </Grid>
                                </Button>
                                <Button Classes.settings-nav="True"
                                        Classes.selected="{Binding IsDonateSettingsSelected}"
                                        AutomationProperties.AutomationId="DonateSettingsNav"
                                        Command="{Binding ShowDonateSettingsCommand}">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                Margin="0,7" IsVisible="{Binding IsDonateSettingsSelected}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Texts.Donate}" Margin="13,8" />
                                    </Grid>
                                </Button>
                                <Button Classes.settings-nav="True"
                                        Classes.selected="{Binding IsAdvancedSettingsSelected}"
                                        AutomationProperties.AutomationId="AdvancedSettingsNav"
                                        Command="{Binding ShowAdvancedSettingsCommand}">
                                    <Grid ColumnDefinitions="3,*">
                                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="2"
                                                Margin="0,7" IsVisible="{Binding IsAdvancedSettingsSelected}" />
                                        <TextBlock Grid.Column="1" Text="{Binding Texts.Advanced}" Margin="13,8" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Border>

                        <ScrollViewer x:Name="SettingsContentScrollViewer"
                                      AutomationProperties.AutomationId="SettingsContentScrollViewer"
                                      Grid.Column="2"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,0,8,0">
                                <Border x:Name="ProgramSettingsCard" Classes="subtle-card" Padding="22"
                                        IsVisible="{Binding IsProgramSettingsSelected}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Texts.Program}"
                                                   FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Texts.Language}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                         <ComboBox Width="220" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                                   AutomationProperties.AutomationId="LanguageComboBox"
                                                   AutomationProperties.Name="{Binding Texts.Language}"
                                                   ItemsSource="{Binding LanguageOptions}"
                                                   SelectedItem="{Binding SelectedLanguageOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SelectionOptionViewModel">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Texts.Theme}"
                                                   Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                         <ComboBox Width="220" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                                   AutomationProperties.AutomationId="ThemeComboBox"
                                                   AutomationProperties.Name="{Binding Texts.Theme}"
                                                   ItemsSource="{Binding ThemeOptions}"
                                                   SelectedItem="{Binding SelectedThemeOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SelectionOptionViewModel">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Texts.UiFontFamily}"
                                                   Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <ComboBox Width="220" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                                  AutomationProperties.AutomationId="FontComboBox"
                                                  AutomationProperties.Name="{Binding Texts.UiFontFamily}"
                                                  ItemsSource="{Binding FontOptions}"
                                                  SelectedItem="{Binding SelectedFontOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SelectionOptionViewModel">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Texts.WindowControlsPosition}"
                                                   Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <ComboBox Width="220" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                                  AutomationProperties.AutomationId="WindowControlsComboBox"
                                                  AutomationProperties.Name="{Binding Texts.WindowControlsPosition}"
                                                  ItemsSource="{Binding WindowControlsPositionOptions}"
                                                  SelectedItem="{Binding SelectedWindowControlsPositionOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SelectionOptionViewModel">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Texts.WindowControlsStyle}"
                                                   Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <ComboBox Width="220" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                                  AutomationProperties.AutomationId="WindowControlsStyleComboBox"
                                                  AutomationProperties.Name="{Binding Texts.WindowControlsStyle}"
                                                  ItemsSource="{Binding WindowControlsStyleOptions}"
                                                  SelectedItem="{Binding SelectedWindowControlsStyleOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SelectionOptionViewModel">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <CheckBox Classes="settings-check"

                                                  IsChecked="True" IsEnabled="False"
                                                  Margin="0,6,0,0">
                                            <TextBlock Text="{Binding Texts.SoundsDisabled}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding Texts.SoundsHelp}"
                                                   Margin="30,-6,0,0" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <CheckBox Classes="settings-check"

                                                  IsChecked="{Binding ToastNotifications}">
                                            <TextBlock Text="{Binding Texts.ToastNotifications}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"

                                                  IsChecked="{Binding AlwaysOnTop}">
                                            <TextBlock Text="{Binding Texts.AlwaysOnTop}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding Texts.AlwaysOnTopHelp}"
                                                   Margin="30,-6,0,0" FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <CheckBox Classes="settings-check"

                                                  IsChecked="{Binding ReduceMotion}">
                                            <TextBlock Text="{Binding Texts.ReduceMotion}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <Border Height="1" Margin="0,8,0,4"
                                                Background="{DynamicResource BorderBrush}" />
                                        <TextBlock Text="{Binding Texts.OnboardingSection}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Texts.OnboardingRepeatDescription}"
                                                   MaxWidth="520"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <Button Classes="primary"
                                                Width="210" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}"
                                                HorizontalAlignment="Left"
                                                AutomationProperties.AutomationId="ReplayOnboardingButton"

                                                Command="{Binding StartOnboardingCommand}">
                                            <TextBlock Text="{Binding Texts.OnboardingRepeat}" TextWrapping="Wrap" />
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="ChatSettingsCard" Classes="subtle-card" Padding="22"
                                        IsVisible="{Binding IsChatSettingsSelected}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Texts.Chat}"
                                                   FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Texts.ChatViewMode}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="18">
                                            <RadioButton AutomationProperties.AutomationId="SettingsCombinedChatViewButton"
                                                         GroupName="SettingsChatViewMode"

                                                         IsChecked="{Binding IsCombinedChatView, Mode=OneWay}"
                                                         Command="{Binding ShowCombinedChatViewCommand}">
                                                <TextBlock Text="{Binding Texts.CombinedChat}" TextWrapping="Wrap" />
                                            </RadioButton>
                                            <RadioButton AutomationProperties.AutomationId="SettingsSplitChatViewButton"
                                                         GroupName="SettingsChatViewMode"

                                                         IsChecked="{Binding IsSplitChatView, Mode=OneWay}"
                                                         Command="{Binding ShowSplitChatViewCommand}">
                                                <TextBlock Text="{Binding Texts.SplitChat}" TextWrapping="Wrap" />
                                            </RadioButton>
                                        </StackPanel>
                                        <TextBlock Text="{Binding Texts.ChatViewModeHelp}"
                                                   MaxWidth="560"
                                                   TextWrapping="Wrap"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <Border Height="1" Margin="0,2,0,2"
                                                Background="{DynamicResource BorderBrush}" />
                                        <TextBlock Text="{Binding Texts.FontSize}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <Grid Width="188" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                              ColumnDefinitions="38,6,*,6,38">
                                            <Button Grid.Column="0" Classes="numeric-step" Content="-"
                                                    Command="{Binding DecreaseChatFontSizeCommand}" />
                                            <TextBox Grid.Column="2"
                                                     Classes="numeric-setting-input"
                                                     MaxLength="5"
                                                     Text="{Binding ChatFontSizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{Binding Texts.FontSize}"
                                                     AutomationProperties.AutomationId="ChatFontSizeTextBox" />
                                            <Button Grid.Column="4" Classes="numeric-step" Content="+"
                                                    Command="{Binding IncreaseChatFontSizeCommand}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Texts.MessageLimit}"
                                                   Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <Grid Width="188" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                              ColumnDefinitions="38,6,*,6,38">
                                            <Button Grid.Column="0" Classes="numeric-step" Content="-"
                                                    Command="{Binding DecreaseMessageLimitCommand}" />
                                            <TextBox Grid.Column="2"
                                                     Classes="numeric-setting-input"
                                                     MaxLength="5"
                                                     Text="{Binding MessageLimitText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{Binding Texts.MessageLimit}"
                                                     AutomationProperties.AutomationId="MessageLimitTextBox" />
                                            <Button Grid.Column="4" Classes="numeric-step" Content="+"
                                                    Command="{Binding IncreaseMessageLimitCommand}" />
                                        </Grid>
                                        <TextBlock Text="{Binding Texts.ViewerRefreshInterval}"
                                                   Margin="0,6,0,0" FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <Grid Width="188" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                              ColumnDefinitions="38,6,*,6,38">
                                            <Button Grid.Column="0" Classes="numeric-step" Content="-"
                                                    Command="{Binding DecreaseViewerCountRefreshIntervalCommand}" />
                                            <TextBox Grid.Column="2"
                                                     Classes="numeric-setting-input"
                                                     MaxLength="3"
                                                     Text="{Binding ViewerCountRefreshIntervalText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{Binding Texts.ViewerRefreshInterval}"
                                                     AutomationProperties.AutomationId="ViewerRefreshTextBox" />
                                            <Button Grid.Column="4" Classes="numeric-step" Content="+"
                                                    Command="{Binding IncreaseViewerCountRefreshIntervalCommand}" />
                                        </Grid>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding ShowTimestamps}">
                                            <TextBlock Text="{Binding Texts.TimeShort}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding ShowBadges}">
                                            <TextBlock Text="{Binding Texts.ShowBadges}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding EnableTwitchEmotes}">
                                            <TextBlock Text="{Binding Texts.TwitchEmotes}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding EnableBttvEmotes}">
                                            <TextBlock Text="{Binding Texts.BttvEmotes}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding EnableSevenTvEmotes}">
                                            <TextBlock Text="{Binding Texts.SevenTvEmotes}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding ShowChannelPointRedemptions}">
                                            <TextBlock Text="{Binding Texts.ShowChannelPointRedemptions}" TextWrapping="Wrap" />
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border x:Name="AccountSettingsCard" Classes="subtle-card" Padding="22"
                                        IsVisible="{Binding IsAccountSettingsSelected}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Texts.Account}"
                                                   FontSize="18" FontWeight="SemiBold" />
                                        <Grid ColumnDefinitions="52,12,*"
                                              IsVisible="{Binding IsAccountConnected}">
                                            <Border Grid.Column="0"
                                                    Name="AccountSettingsAvatar"
                                                    AutomationProperties.AutomationId="AccountSettingsAvatar"
                                                    Width="52" Height="52"
                                                    CornerRadius="26"
                                                    Background="{DynamicResource ButtonBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    ClipToBounds="True">
                                                <Grid>
                                                    <TextBlock Text="{Binding AvatarInitial}"
                                                               FontSize="18"
                                                               FontWeight="SemiBold"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Image Name="AccountSettingsAvatarImage"
                                                           AutomationProperties.AutomationId="AccountSettingsAvatarImage"
                                                           Source="{Binding AccountProfileImageResource.Image}"
                                                           IsVisible="{Binding AccountProfileImageResource.HasImage}"
                                                           Stretch="UniformToFill" />
                                                </Grid>
                                            </Border>
                                            <StackPanel Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        Spacing="2">
                                                <TextBlock Text="{Binding HeaderTitle}"
                                                           FontSize="15"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding AccountLabel}"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                                <Button Name="AccountChannelLink"
                                                        AutomationProperties.AutomationId="AccountChannelLink"

                                                        Command="{Binding OpenSupportLinkCommand}"
                                                        CommandParameter="{Binding AccountChannelUrl}"
                                                        HorizontalAlignment="Left"
                                                        HorizontalContentAlignment="Left"
                                                        Padding="0"
                                                        MinHeight="0"
                                                        Background="Transparent"
                                                        BorderThickness="0"
                                                        Foreground="{DynamicResource AccentBrush}">
                                                    <TextBlock Text="{Binding AccountChannelUrl}" TextWrapping="Wrap" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding AccountLabel}"
                                                   IsVisible="{Binding !IsAccountConnected}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding AuthStatus}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                             <Button Classes="primary"

                                                     IsVisible="{Binding CanAuthorize}"
                                                     Command="{Binding StartAuthorizationCommand}">
                                                 <TextBlock Text="{Binding Texts.ConnectAccount}" TextWrapping="Wrap" />
                                             </Button>
                                             <Button
                                                     Command="{Binding CancelAuthorizationCommand}"
                                                     IsVisible="{Binding IsAuthorizing}">
                                                 <TextBlock Text="{Binding Texts.CancelSignIn}" TextWrapping="Wrap" />
                                             </Button>
                                             <Button
                                                     IsVisible="{Binding IsAccountConnected}"
                                                     Command="{Binding SignOutCommand}">
                                                 <TextBlock Text="{Binding Texts.SignOut}" TextWrapping="Wrap" />
                                             </Button>
                                        </StackPanel>
                                        <Border Height="1" Margin="0,10"
                                                Background="{DynamicResource BorderBrush}" />
                                        <Grid ColumnDefinitions="42,12,*">
                                            <Border Grid.Column="0" Width="42" Height="42"
                                                    CornerRadius="12"
                                                    Background="#FF0F0F"
                                                    VerticalAlignment="Top">
                                                <Image Source="/Assets/Brands/youtube.png"
                                                       Width="26" Height="26"
                                                       Stretch="Uniform"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <TextBlock Text="{Binding Texts.YouTubeAccount}"
                                                           FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Texts.YouTubeReadOnlyIntro}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Text="{Binding YouTubeAccountLabel}"
                                                   IsVisible="{Binding IsYouTubeConnected}"
                                                   FontWeight="SemiBold"
                                                   AutomationProperties.AutomationId="YouTubeAccountLabel" />
                                        <TextBlock Text="{Binding YouTubeStatus}"
                                                   TextWrapping="Wrap" FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBlock Text="{Binding Texts.YouTubeModerationReady}"
                                                   IsVisible="{Binding HasYouTubeModerationPermission}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SuccessBrush}" />
                                        <TextBlock Text="{Binding Texts.YouTubeModerationPermissionRequired}"
                                                   IsVisible="{Binding RequiresYouTubeModerationReconnect}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource WarningBrush}" />
                                        <Button
                                                IsVisible="{Binding IsYouTubeConnected}"
                                                Command="{Binding OpenSupportLinkCommand}"
                                                CommandParameter="{Binding YouTubeChannelUrl}"
                                                HorizontalAlignment="Left"
                                                HorizontalContentAlignment="Left"
                                                Padding="0" MinHeight="0"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                Foreground="{DynamicResource AccentBrush}">
                                            <TextBlock Text="{Binding YouTubeChannelUrl}" TextWrapping="Wrap" />
                                        </Button>
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <Button Classes="primary"

                                                    IsEnabled="{Binding CanConnectYouTube}"
                                                    IsVisible="{Binding !IsYouTubeConnected}"
                                                    Command="{Binding ConnectYouTubeCommand}"
                                                    AutomationProperties.AutomationId="ConnectYouTubeButton">
                                                <TextBlock Text="{Binding Texts.ConnectYouTube}" TextWrapping="Wrap" />
                                            </Button>
                                            <Button
                                                    IsVisible="{Binding IsYouTubeAuthorizing}"
                                                    Command="{Binding CancelYouTubeAuthorizationCommand}">
                                                <TextBlock Text="{Binding Texts.CancelSignIn}" TextWrapping="Wrap" />
                                            </Button>
                                            <Button Classes="primary"

                                                    IsVisible="{Binding RequiresYouTubeModerationReconnect}"
                                                    Command="{Binding EnableYouTubeModerationCommand}"
                                                    AutomationProperties.AutomationId="EnableYouTubeModerationButton">
                                                <TextBlock Text="{Binding Texts.EnableYouTubeModeration}" TextWrapping="Wrap" />
                                            </Button>
                                            <Button
                                                    IsVisible="{Binding IsYouTubeConnected}"
                                                    Command="{Binding DisconnectYouTubeCommand}">
                                                <TextBlock Text="{Binding Texts.DisconnectYouTube}" TextWrapping="Wrap" />
                                            </Button>
                                        </StackPanel>
                                        <Border Height="1" Margin="0,10"
                                                Background="{DynamicResource BorderBrush}" />
                                        <Grid ColumnDefinitions="42,12,*">
                                            <Border Grid.Column="0" Width="42" Height="42"
                                                    CornerRadius="21"
                                                    Background="{DynamicResource ButtonBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    VerticalAlignment="Top">
                                                <controls:DonationAlertsLogo Width="25" Height="25"
                                                                             HorizontalAlignment="Center"
                                                                             VerticalAlignment="Center"
                                                                             RenderTransform="translate(1px, 0px)" />
                                            </Border>
                                            <StackPanel Grid.Column="2" Spacing="3">
                                                <TextBlock Text="{Binding Texts.DonationAlertsAccount}"
                                                           FontSize="17" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Texts.DonationAlertsIntegrationIntro}"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox Classes="settings-check"

                                                  IsChecked="{Binding DonationAlertsAutoOpenWindow}">
                                            <TextBlock Text="{Binding Texts.AutoOpenDonationWindow}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Ellipse Width="8" Height="8" Fill="{Binding DonationAlertsStatusBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DonationAlertsAccountLabel}" TextWrapping="Wrap"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding DonationAlertsStatus}"
                                                   IsVisible="{Binding ShowDonationAlertsStatusDetail}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                            <Ellipse Width="8" Height="8"
                                                     Fill="{Binding DonationAlertsObsControlBrush}"
                                                     VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{Binding DonationAlertsObsControlStatus}"
                                                       FontSize="12" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource MutedTextBrush}"
                                                       VerticalAlignment="Center" />
                                        </Grid>
                                        <TextBlock Text="{Binding DonationControlError}"
                                                   IsVisible="{Binding HasDonationControlError}"
                                                   FontSize="12" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource DangerBrush}" />
                                        <WrapPanel>
                                            <Button Classes="primary" Margin="0,0,8,8"

                                                    IsVisible="{Binding !IsDonationAlertsConnected}"
                                                    IsEnabled="{Binding CanConnectDonationAlerts}"
                                                    Command="{Binding ConnectDonationAlertsCommand}"
                                                    AutomationProperties.AutomationId="ConnectDonationAlertsButton">
                                                <TextBlock Text="{Binding Texts.ConnectDonationAlerts}" TextWrapping="Wrap" />
                                            </Button>
                                            <Button Margin="0,0,8,8"
                                                    IsVisible="{Binding IsDonationAlertsAuthorizing}"
                                                    Command="{Binding CancelDonationAlertsAuthorizationCommand}">
                                                <TextBlock Text="{Binding Texts.CancelSignIn}" TextWrapping="Wrap" />
                                            </Button>
                                            <Button Margin="0,0,8,8"
                                                    IsVisible="{Binding IsDonationAlertsConnected}"
                                                    Command="{Binding DisconnectDonationAlertsCommand}">
                                                <TextBlock Text="{Binding Texts.DisconnectDonationAlerts}" TextWrapping="Wrap" />
                                            </Button>
                                            <Button Margin="0,0,8,8"
                                                    Command="{Binding OpenDonationWindowCommand}">
                                                <TextBlock Text="{Binding Texts.OpenDonationWindow}" TextWrapping="Wrap" />
                                            </Button>
                                            <Button Margin="0,0,0,8"
                                                    Command="{Binding TestDonationCommand}">
                                                <TextBlock Text="{Binding Texts.TestDonation}" TextWrapping="Wrap" />
                                            </Button>
                                            <Button Margin="8,0,0,8"

                                                    Command="{Binding RefreshDonationAlertsObsControlCommand}">
                                                <TextBlock Text="{Binding Texts.FindDonationAlertsObsSource}" TextWrapping="Wrap" />
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="ChatLogsSettingsCard" Classes="subtle-card" Padding="22"
                                        IsVisible="{Binding IsChatLogsSettingsSelected}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Texts.ChatLogs}"
                                                   FontSize="18" FontWeight="SemiBold" />
                                        <Button Width="230" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"

                                                Command="{Binding OpenLogDirectoryCommand}">
                                            <TextBlock Text="{Binding Texts.OpenLogFolder}" TextWrapping="Wrap" />
                                        </Button>
                                        <Button Width="230" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"

                                                Command="{Binding ClearMessagesCommand}">
                                            <TextBlock Text="{Binding Texts.ClearMessages}" TextWrapping="Wrap" />
                                        </Button>
                                        <Border Height="1" Margin="0,8"
                                                Background="{DynamicResource BorderBrush}" />
                                        <TextBlock Text="{Binding Texts.ChatLogging}"
                                                   FontSize="17" FontWeight="SemiBold" />
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding EnableChatLogging}">
                                            <TextBlock Text="{Binding Texts.EnableChatLogging}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding SaveChatLogTxt}">
                                            <TextBlock Text="{Binding Texts.SaveChatLogTxt}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding LogChatBadges}">
                                            <TextBlock Text="{Binding Texts.LogChatBadges}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding LogChannelPointRedemptions}">
                                            <TextBlock Text="{Binding Texts.LogChannelPointRedemptions}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding Texts.ChatLogsFolder}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <TextBox Text="{Binding ChatLogsFolderDisplay, Mode=TwoWay}"
                                                     AutomationProperties.Name="{Binding Texts.ChatLogsFolder}" />
                                            <Button Grid.Column="1"
                                                    Click="BrowseChatLogsFolder_OnClick">
                                                <TextBlock Text="{Binding Texts.Browse}" TextWrapping="Wrap" />
                                            </Button>
                                        </Grid>
                                        <Grid ColumnDefinitions="*,Auto,8,Auto,Auto" ColumnSpacing="7">
                                            <TextBlock Text="{Binding Texts.LogViewerLimit}"
                                                       VerticalAlignment="Center" />
                                            <Button Grid.Column="1" Classes="numeric-step" Content="-"
                                                    Command="{Binding DecreaseLogViewerLimitCommand}" />
                                            <TextBox Grid.Column="3"
                                                     Width="96"
                                                     MaxLength="5"
                                                     Classes="numeric-setting-input"
                                                     Text="{Binding MaxLogViewerMessages, Mode=TwoWay, UpdateSourceTrigger=LostFocus}"
                                                     AutomationProperties.Name="{Binding Texts.LogViewerLimit}"
                                                     AutomationProperties.AutomationId="LogViewerLimitTextBox" />
                                            <Button Grid.Column="4" Classes="numeric-step" Content="+"
                                                    Command="{Binding IncreaseLogViewerLimitCommand}" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="OverlaySettingsCard"
                                        Classes="subtle-card" Padding="22"
                                        IsVisible="{Binding IsOverlaySettingsSelected}">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Texts.ObsOverlay}"
                                                   FontSize="18" FontWeight="SemiBold"
                                                   Margin="0,0,0,12" />
                                        <Border Name="ObsPluginSettingsCard" Classes="subtle-card" Padding="14" Margin="0,0,0,18">
                                            <StackPanel Spacing="8">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Texts.ObsPluginTitle}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                    <Button Name="ObsPluginHelpButton" Grid.Column="1" Classes="context-help" Content="?"
                                                            Command="{Binding StartContextTutorialCommand}" CommandParameter="ObsPlugin"
                                                            AutomationProperties.Name="{Binding Texts.OpenSettingsTutorial}" />
                                                </Grid>
                                                <TextBlock Name="ObsPluginStatusText" Text="{Binding ObsPluginStatus}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding ObsPluginDirectory}" TextWrapping="Wrap" FontSize="11"
                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                <WrapPanel>
                                                    <Button Name="InstallObsPluginButton" Classes="primary"
                                                            Content="{Binding ObsPluginInstallLabel}" Command="{Binding InstallObsPluginCommand}"
                                                            Margin="0,0,8,8" />
                                                    <Button Content="{Binding Texts.ObsPluginCheck}" Command="{Binding RefreshObsPluginCommand}"
                                                            Margin="0,0,8,8" />
                                                    <Button Name="RemoveObsPluginButton" Content="{Binding Texts.ObsPluginRemove}"
                                                            Command="{Binding BeginRemoveObsPluginCommand}" Margin="0,0,8,8" />
                                                    <Button Content="{Binding Texts.ObsPluginChooseFolder}" Click="BrowseObsPluginFolder_OnClick"
                                                            IsEnabled="{Binding CanManageObsPlugin}" Margin="0,0,0,8" />
                                                </WrapPanel>
                                                <Border Classes="subtle-card" Padding="10" IsVisible="{Binding IsObsPluginRemovalConfirmationOpen}">
                                                    <StackPanel Spacing="8">
                                                        <TextBlock Text="{Binding Texts.ObsPluginRemovalConfirm}" TextWrapping="Wrap" FontSize="12" />
                                                        <WrapPanel>
                                                            <Button Name="ConfirmRemoveObsPluginButton" Content="{Binding Texts.ObsPluginConfirmRemove}"
                                                                    Command="{Binding ConfirmRemoveObsPluginCommand}" Margin="0,0,8,8" />
                                                            <Button Content="{Binding Texts.ObsPluginCancelRemove}"
                                                                    Command="{Binding CancelRemoveObsPluginCommand}" Margin="0,0,0,8" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </Border>
                                                <TextBlock Name="ObsPluginNoticeText" Text="{Binding ObsPluginNotice}" TextWrapping="Wrap"
                                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                                            </StackPanel>
                                        </Border>
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding EnableObsOverlay}">
                                            <TextBlock Text="{Binding Texts.EnableObsOverlay}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding Texts.MessageVisualTheme}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,16,0,7" />
                                        <ComboBox Width="200" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                                  CornerRadius="14"
                                                  HorizontalContentAlignment="Left"
                                                  VerticalContentAlignment="Center"
                                                  AutomationProperties.AutomationId="MessageVisualThemeComboBox"
                                                  AutomationProperties.Name="{Binding Texts.MessageVisualTheme}"
                                                  ItemsSource="{Binding MessageVisualThemeOptions}"
                                                  SelectedItem="{Binding SelectedMessageVisualThemeOption}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:SelectionOptionViewModel">
                                                    <TextBlock Text="{Binding Label}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="{Binding Texts.MessageVisualThemeHelp}"
                                                   FontSize="11" TextWrapping="Wrap"
                                                   Foreground="{DynamicResource MutedTextBrush}"
                                                   Margin="0,6,0,0" />
                                        <TextBlock Text="{Binding Texts.OverlayUrl}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   Margin="0,18,0,5" />
                                        <Grid ColumnDefinitions="*,10,Auto">
                                            <TextBox Grid.Column="0"
                                                     AutomationProperties.AutomationId="OverlayUrlTextBox"
                                                     AutomationProperties.Name="{Binding Texts.OverlayUrl}"
                                                     Height="38" CornerRadius="14"
                                                     TextAlignment="Left"
                                                     VerticalContentAlignment="Center"
                                                     Text="{Binding OverlayUrl}" IsReadOnly="True" />
                                            <Button x:Name="CopyOverlayUrlButton" Grid.Column="2"
                                                    AutomationProperties.AutomationId="CopyOverlayUrlButton"
                                                    Height="38" CornerRadius="14"
                                                    Command="{Binding CopyOverlayUrlCommand}">
                                                <TextBlock Text="{Binding Texts.CopyUrl}" TextWrapping="Wrap" />
                                            </Button>
                                        </Grid>

                                        <UniformGrid Columns="2" Margin="0,18,0,0">
                                            <StackPanel Margin="0,0,10,12">
                                                <TextBlock Text="{Binding Texts.OverlayPort}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,7" />
                                                <TextBox AutomationProperties.AutomationId="OverlayPortTextBox"
                                                         AutomationProperties.Name="{Binding Texts.OverlayPort}"
                                                         Width="88" HorizontalAlignment="Left"
                                                         Height="38" CornerRadius="14"
                                                         MaxLength="5"
                                                         TextAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding OverlayPortText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                <TextBlock Text="{Binding Texts.OverlayPortRange}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="10.5" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,12">
                                                <TextBlock Text="{Binding Texts.OverlayMessages}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,7" />
                                                <TextBox AutomationProperties.AutomationId="OverlayMaxMessagesTextBox"
                                                         AutomationProperties.Name="{Binding Texts.OverlayMessages}"
                                                         Width="88" HorizontalAlignment="Left"
                                                         Height="38" CornerRadius="14"
                                                         MaxLength="3"
                                                         TextAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding OverlayMaxMessagesText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                <TextBlock Text="{Binding Texts.OverlayMessagesRange}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="10.5" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,12">
                                                <TextBlock Text="{Binding Texts.OverlayFontSize}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,7" />
                                                <TextBox AutomationProperties.AutomationId="OverlayFontSizeTextBox"
                                                         AutomationProperties.Name="{Binding Texts.OverlayFontSize}"
                                                         Width="88" HorizontalAlignment="Left"
                                                         Height="38" CornerRadius="14"
                                                         MaxLength="5"
                                                         TextAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding OverlayFontSizeText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                <TextBlock Text="{Binding Texts.OverlayFontSizeRange}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="10.5" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,12">
                                                <TextBlock Text="{Binding Texts.OverlayFade}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,7" />
                                                <TextBox AutomationProperties.AutomationId="OverlayFadeTextBox"
                                                         AutomationProperties.Name="{Binding Texts.OverlayFade}"
                                                         Width="88" HorizontalAlignment="Left"
                                                         Height="38" CornerRadius="14"
                                                         MaxLength="3"
                                                         TextAlignment="Left"
                                                         VerticalContentAlignment="Center"
                                                         Text="{Binding OverlayFadeOutSecondsText, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" />
                                                <TextBlock Text="{Binding Texts.OverlayFadeHint}"
                                                           Foreground="{DynamicResource MutedTextBrush}"
                                                           FontSize="11" Margin="0,5,0,0" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,12">
                                                <Grid Width="240" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                                      ColumnDefinitions="*,Auto"
                                                      Margin="0,0,0,5">
                                                    <TextBlock Text="{Binding Texts.OverlayOpacity}"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    <TextBlock Grid.Column="1"
                                                               AutomationProperties.AutomationId="OverlayOpacityValue"
                                                               Text="{Binding OverlayBackgroundOpacityPercent}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource AccentBrush}" />
                                                </Grid>
                                                <Grid Width="240" MaxWidth="{Binding $parent[StackPanel].Bounds.Width}" HorizontalAlignment="Left"
                                                      ColumnDefinitions="Auto,8,*,8,Auto">
                                                    <TextBlock Text="0%"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="10.5" />
                                                    <Slider Grid.Column="2"
                                                            AutomationProperties.AutomationId="OverlayOpacitySlider"
                                                            AutomationProperties.Name="{Binding Texts.OverlayOpacity}"
                                                            Minimum="0" Maximum="1"
                                                            SmallChange="0.05" LargeChange="0.1"
                                                            TickFrequency="0.05"
                                                            IsSnapToTickEnabled="True"
                                                            VerticalAlignment="Center"
                                                            Value="{Binding OverlayBackgroundOpacity, Mode=TwoWay}" />
                                                    <TextBlock Grid.Column="4"
                                                               Text="100%"
                                                               VerticalAlignment="Center"
                                                               Foreground="{DynamicResource MutedTextBrush}"
                                                               FontSize="10.5" />
                                                </Grid>
                                            </StackPanel>
                                            <StackPanel Margin="10,0,0,12">
                                                <TextBlock Text="{Binding Texts.OverlayAlignment}"
                                                           FontSize="12"
                                                           Foreground="{DynamicResource SecondaryTextBrush}"
                                                           Margin="0,0,0,7" />
                                                <ComboBox AutomationProperties.AutomationId="OverlayAlignmentComboBox"
                                                          AutomationProperties.Name="{Binding Texts.OverlayAlignment}"
                                                          Width="140"
                                                          Height="38" CornerRadius="14"
                                                          HorizontalAlignment="Left"
                                                          HorizontalContentAlignment="Left"
                                                          VerticalContentAlignment="Center"
                                                          ItemsSource="{Binding OverlayAlignmentOptions}"
                                                          SelectedItem="{Binding SelectedOverlayAlignmentOption}">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SelectionOptionViewModel">
                                                            <TextBlock Text="{Binding Label}" />
                                                        </DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                            </StackPanel>
                                        </UniformGrid>

                                        <UniformGrid Columns="3" Margin="0,4,0,16">
                                            <CheckBox Classes="settings-check"

                                                      IsChecked="{Binding OverlayShowTimestamps}"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Texts.OverlayShowTime}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox Classes="settings-check"

                                                      IsChecked="{Binding OverlayShowBadges}"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Texts.OverlayShowBadges}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox Classes="settings-check"

                                                      IsChecked="{Binding OverlayShowEmotes}"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Texts.OverlayShowEmotes}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox Classes="settings-check"

                                                      IsChecked="{Binding OverlayTextShadow}"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Texts.OverlayTextShadow}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox Classes="settings-check"

                                                      IsChecked="{Binding OverlayTextOutline}"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Texts.OverlayTextOutline}" TextWrapping="Wrap" />
                                            </CheckBox>
                                            <CheckBox Classes="settings-check"

                                                      IsChecked="{Binding OverlayDarkBackground}"
                                                      HorizontalAlignment="Left"
                                                      Margin="0,0,0,10">
                                                <TextBlock Text="{Binding Texts.OverlayDarkBackground}" TextWrapping="Wrap" />
                                            </CheckBox>
                                        </UniformGrid>

                                        <Button Classes="primary" HorizontalAlignment="Left"

                                                Command="{Binding TestOverlayMessageCommand}">
                                            <TextBlock Text="{Binding Texts.TestOverlayMessage}" TextWrapping="Wrap" />
                                        </Button>
                                        <TextBlock Text="{Binding OverlayStatusText}"
                                                   Foreground="{DynamicResource SecondaryTextBrush}"
                                                   FontSize="12"
                                                   Margin="0,10,0,0"
                                                   TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="DonateSettingsCard" Classes="subtle-card" Padding="22"
                                        IsVisible="{Binding IsDonateSettingsSelected}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Texts.SupportDeveloper}"
                                                   FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Texts.SupportDeveloperDescription}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <TextBlock Text="{Binding Texts.SupportPlatforms}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Margin="0,3,0,-2"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <Grid ColumnDefinitions="*,10,*"
                                              RowDefinitions="Auto,8,Auto,8,Auto">
                                            <Button Grid.Row="0" Grid.Column="0"
                                                    Classes="support-brand boosty"
                                                    AutomationProperties.AutomationId="BoostySupportButton"
                                                    Command="{Binding OpenSupportLinkCommand}"
                                                    CommandParameter="{Binding BoostyUrl}">
                                                <Grid ColumnDefinitions="38,*,Auto">
                                                    <Border Width="30" Height="30"
                                                            CornerRadius="15"
                                                            Background="#F15F2C">
                                                        <Image Width="19" Height="19"
                                                               Stretch="Uniform"
                                                               Source="/Assets/Brands/boosty-white.png" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Texts.Boosty}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding BoostyUrl}"
                                                                   FontSize="9.5"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                    <Path Grid.Column="2" Width="13" Height="13"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          Data="M4,12 L12,4 M7,4 H12 V9" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Row="0" Grid.Column="2"
                                                    Classes="support-brand donation-alerts"
                                                    AutomationProperties.AutomationId="DonationAlertsSupportButton"
                                                    Command="{Binding OpenSupportLinkCommand}"
                                                    CommandParameter="{Binding DonationAlertsUrl}">
                                                <Grid ColumnDefinitions="38,*,Auto">
                                                    <Border Width="30" Height="30"
                                                            CornerRadius="15"
                                                            Background="#F57D07">
                                                        <controls:DonationAlertsLogo Width="18" Height="20"
                                                                                     Fill="White"
                                                                                     RenderTransform="translate(1px, 0px)" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Texts.DonationAlerts}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding DonationAlertsUrl}"
                                                                   FontSize="9.5"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                    <Path Grid.Column="2" Width="13" Height="13"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          Data="M4,12 L12,4 M7,4 H12 V9" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Row="2" Grid.Column="0"
                                                    Classes="support-brand twitch"
                                                    AutomationProperties.AutomationId="TwitchSupportButton"
                                                    Command="{Binding OpenSupportLinkCommand}"
                                                    CommandParameter="{Binding TwitchSupportUrl}">
                                                <Grid ColumnDefinitions="38,*,Auto">
                                                    <Border Width="30" Height="30"
                                                            CornerRadius="15"
                                                            Background="#9146FF">
                                                        <Image Width="19" Height="19"
                                                               Stretch="Uniform"
                                                               Source="/Assets/Brands/twitch-white.png" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Texts.Twitch}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding TwitchSupportUrl}"
                                                                   FontSize="9.5"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                    <Path Grid.Column="2" Width="13" Height="13"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          Data="M4,12 L12,4 M7,4 H12 V9" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Row="2" Grid.Column="2"
                                                    Classes="support-brand youtube"
                                                    AutomationProperties.AutomationId="YouTubeSupportButton"
                                                    Command="{Binding OpenSupportLinkCommand}"
                                                    CommandParameter="{Binding YouTubeUrl}">
                                                <Grid ColumnDefinitions="38,*,Auto">
                                                    <Image Width="32" Height="32"
                                                           Stretch="Uniform"
                                                           Source="/Assets/Brands/youtube.png" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Texts.YouTube}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding YouTubeUrl}"
                                                                   FontSize="9.5"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                    <Path Grid.Column="2" Width="13" Height="13"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          Data="M4,12 L12,4 M7,4 H12 V9" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Row="4" Grid.Column="0"
                                                    Classes="support-brand steam"
                                                    AutomationProperties.AutomationId="SteamSupportButton"
                                                    Command="{Binding OpenSupportLinkCommand}"
                                                    CommandParameter="{Binding SteamUrl}">
                                                <Grid ColumnDefinitions="38,*,Auto">
                                                    <Border Width="32" Height="32" CornerRadius="16"
                                                            Background="#171A21">
                                                        <Image Width="25" Height="25"
                                                               Stretch="Uniform"
                                                               Source="/Assets/Brands/steam.png" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Texts.Steam}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding SteamUrl}"
                                                                   FontSize="9.5"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                    <Path Grid.Column="2" Width="13" Height="13"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          Data="M4,12 L12,4 M7,4 H12 V9" />
                                                </Grid>
                                            </Button>

                                            <Button Grid.Row="4" Grid.Column="2"
                                                    Classes="support-brand telegram"
                                                    AutomationProperties.AutomationId="TelegramSupportButton"
                                                    Command="{Binding OpenSupportLinkCommand}"
                                                    CommandParameter="{Binding TelegramUrl}">
                                                <Grid ColumnDefinitions="38,*,Auto">
                                                    <Image Width="32" Height="32"
                                                           Stretch="Uniform"
                                                           Source="/Assets/Brands/telegram.png" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Texts.Telegram}"
                                                                   FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding TelegramUrl}"
                                                                   FontSize="9.5"
                                                                   TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                                    </StackPanel>
                                                    <Path Grid.Column="2" Width="13" Height="13"
                                                          VerticalAlignment="Center"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.5"
                                                          StrokeLineCap="Round"
                                                          Data="M4,12 L12,4 M7,4 H12 V9" />
                                                </Grid>
                                            </Button>
                                        </Grid>

                                        <Border Height="1" Margin="0,2"
                                                Background="{DynamicResource BorderBrush}" />
                                        <TextBlock Text="{Binding Texts.CryptoWallets}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />

                                        <Button Classes="support-wallet tron"
                                                AutomationProperties.AutomationId="TronWalletButton"
                                                Command="{Binding CopySupportAddressCommand}"
                                                CommandParameter="{Binding UsdtTrc20Address}">
                                            <Grid ColumnDefinitions="42,*,Auto">
                                                <Image Width="34" Height="34"
                                                       Stretch="Uniform"
                                                       Source="/Assets/Brands/tron.png" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Texts.UsdtTrc20}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding UsdtTrc20Address}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding UsdtTrc20Address}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <Path Width="13" Height="14"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.4"
                                                          Data="M5,4 H15 V17 H5 Z M2,14 V1 H12" />
                                                    <TextBlock Text="{Binding Texts.Copy}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Classes="support-wallet ton"
                                                AutomationProperties.AutomationId="TonWalletButton"
                                                Command="{Binding CopySupportAddressCommand}"
                                                CommandParameter="{Binding UsdtTonAddress}">
                                            <Grid ColumnDefinitions="42,*,Auto">
                                                <Image Width="34" Height="34"
                                                       Stretch="Uniform"
                                                       Source="/Assets/Brands/ton.png" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Texts.UsdtTon}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding UsdtTonAddress}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding UsdtTonAddress}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <Path Width="13" Height="14"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.4"
                                                          Data="M5,4 H15 V17 H5 Z M2,14 V1 H12" />
                                                    <TextBlock Text="{Binding Texts.Copy}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>

                                        <Button Classes="support-wallet bsc"
                                                AutomationProperties.AutomationId="BscWalletButton"
                                                Command="{Binding CopySupportAddressCommand}"
                                                CommandParameter="{Binding UsdtBscAddress}">
                                            <Grid ColumnDefinitions="42,*,Auto">
                                                <Image Width="34" Height="34"
                                                       Stretch="Uniform"
                                                       Source="/Assets/Brands/bsc.png" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Texts.UsdtBsc}"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding UsdtBscAddress}" FontSize="11"
                                                               TextTrimming="CharacterEllipsis"
                                                               ToolTip.Tip="{Binding UsdtBscAddress}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal"
                                                            Spacing="6" VerticalAlignment="Center">
                                                    <Path Width="13" Height="14"
                                                          Stroke="{DynamicResource SecondaryTextBrush}"
                                                          StrokeThickness="1.4"
                                                          Data="M5,4 H15 V17 H5 Z M2,14 V1 H12" />
                                                    <TextBlock Text="{Binding Texts.Copy}"
                                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                                </StackPanel>
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <Border x:Name="AdvancedSettingsCard" Classes="subtle-card" Padding="22"
                                        IsVisible="{Binding IsAdvancedSettingsSelected}">
                                    <StackPanel Spacing="12">
                                        <TextBlock Text="{Binding Texts.Advanced}"
                                                   FontSize="18" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Texts.AdvancedIntro}"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                        <CheckBox Classes="settings-check"
                                                  IsChecked="{Binding UseCustomClientId}">
                                            <TextBlock Text="{Binding Texts.UseCustomClientId}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Text="{Binding Texts.TwitchClientId}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBox Text="{Binding ClientId}"
                                                 AutomationProperties.Name="{Binding Texts.TwitchClientId}"
                                                 IsEnabled="{Binding UseCustomClientId}" />
                                        <TextBlock Text="{Binding Texts.OAuthRedirectUri}"
                                                   FontSize="12"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                        <TextBox Text="{Binding RedirectUri}"
                                                 AutomationProperties.Name="{Binding Texts.OAuthRedirectUri}" />
                                         <TextBlock Text="{Binding Texts.OAuthSettingsHelp}"
                                                    FontSize="12" TextWrapping="Wrap"
                                                    Foreground="{DynamicResource MutedTextBrush}" />
                                         <Border Height="1" Margin="0,4"
                                                 Background="{DynamicResource BorderBrush}" />
                                         <Button Classes="danger"
                                                 HorizontalAlignment="Left"
                                                 AutomationProperties.AutomationId="ExitApplicationButton"

                                                 Command="{Binding ExitApplicationCommand}">
                                             <TextBlock Text="{Binding Texts.ExitWitherChat}" TextWrapping="Wrap" />
                                         </Button>
                                     </StackPanel>
                                 </Border>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <Grid x:Name="SettingsActionsGrid" Grid.Row="4" ColumnDefinitions="*,Auto,Auto">
                        <TextBlock x:Name="SettingsVersionLabel" Text="{Binding VersionLabel}" TextTrimming="CharacterEllipsis"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource MutedTextBrush}"
                                   FontSize="11" />
                        <Button x:Name="CancelSettingsButton" Grid.Column="1" Margin="0,0,8,0"
                                AutomationProperties.AutomationId="CancelSettingsButton"

                                Command="{Binding CancelSettingsCommand}">
                            <TextBlock Text="{Binding Texts.Cancel}" TextWrapping="Wrap" />
                        </Button>
                        <Button Grid.Column="2" Classes="primary"
                                AutomationProperties.AutomationId="SaveSettingsButton"

                                Command="{Binding SaveSettingsPanelCommand}">
                            <TextBlock Text="{Binding Texts.Save}" TextWrapping="Wrap" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <Border x:Name="OnboardingOverlay"
                AutomationProperties.AutomationId="OnboardingOverlay"
                ZIndex="100"
                Background="Transparent"
                IsVisible="False"
                IsHitTestVisible="False"
                Opacity="0">
            <Grid ClipToBounds="True">
                <Ellipse Width="680" Height="680"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="-315,-350,0,0"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#9AD45CFF" Offset="0" />
                            <GradientStop Color="#30B860FF" Offset="0.58" />
                            <GradientStop Color="#00B860FF" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse Width="620" Height="620"
                         HorizontalAlignment="Right"
                         VerticalAlignment="Bottom"
                         Margin="0,0,-280,-315"
                         IsHitTestVisible="False">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#7848EFD3" Offset="0" />
                            <GradientStop Color="#2548EFD3" Offset="0.62" />
                            <GradientStop Color="#0048EFD3" Offset="1" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>

                <Canvas x:Name="OnboardingFocusCanvas"
                        ClipToBounds="True"
                        IsHitTestVisible="False">
                    <Path x:Name="OnboardingDimmingMask"
                          Fill="#DE00050D" />
                    <Border x:Name="OnboardingTargetHighlight"
                            Classes="onboarding-target"
                            IsVisible="{Binding !IsOnboardingWelcomeStep}" />
                </Canvas>

                <Border x:Name="OnboardingInputBlocker"
                        AutomationProperties.AutomationId="OnboardingInputBlocker"
                        ZIndex="10"
                        Background="#01000000"
                        Focusable="True"
                        PointerPressed="OnboardingInputBlocker_OnPointerPressed"
                        PointerWheelChanged="OnboardingInputBlocker_OnPointerWheelChanged" />

                <Border x:Name="OnboardingWindowDragArea"
                        AutomationProperties.AutomationId="OnboardingWindowDragArea"
                        ZIndex="15"
                        Height="42"
                        VerticalAlignment="Top"
                        Background="#01000000"
                        PointerPressed="TitleBar_OnPointerPressed" />

                <Border x:Name="OnboardingCard"
                        AutomationProperties.AutomationId="OnboardingCard"
                        ZIndex="20"
                        Width="440"
                        MaxWidth="440"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Background="{DynamicResource OnboardingGlassBrush}"
                        BorderBrush="#709A8CFF"
                        BorderThickness="1.5"
                        CornerRadius="26"
                        ClipToBounds="True"
                        BoxShadow="0 24 64 5 #B0000000, 0 0 28 0 #2868E7D1"
                        KeyboardNavigation.TabNavigation="Cycle"
                        RenderTransformOrigin="50%,50%">
                    <Grid RowDefinitions="5,*">
                        <Ellipse Grid.RowSpan="2"
                                 Width="290" Height="290"
                                 HorizontalAlignment="Right"
                                 VerticalAlignment="Top"
                                 Margin="0,-175,-150,0"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#3568E7D1" Offset="0" />
                                    <GradientStop Color="#0068E7D1" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse Grid.RowSpan="2"
                                 Width="250" Height="250"
                                 HorizontalAlignment="Left"
                                 VerticalAlignment="Bottom"
                                 Margin="-145,0,0,-165"
                                 IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#2ED45CFF" Offset="0" />
                                    <GradientStop Color="#00D45CFF" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Border Grid.RowSpan="2"
                                Margin="1"
                                CornerRadius="25"
                                BorderThickness="1"
                                BorderBrush="#22FFFFFF"
                                IsHitTestVisible="False" />
                        <Border x:Name="OnboardingAccentStrip"
                                Grid.Row="0"
                                IsHitTestVisible="False">
                            <Border.RenderTransform>
                                <TranslateTransform Y="-2" />
                            </Border.RenderTransform>
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,50%" EndPoint="100%,50%">
                                    <GradientStop Color="#9A8CFF" Offset="0" />
                                    <GradientStop Color="#63D5FF" Offset="0.52" />
                                    <GradientStop Color="#68E7C3" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Grid Grid.Row="1" RowDefinitions="*,Auto">
                        <ScrollViewer x:Name="OnboardingContentScrollViewer"
                                      Grid.Row="0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OnboardingScrollableBody" Margin="26,22,26,0" Spacing="17">
                            <Grid x:Name="OnboardingGuideHeader" ColumnDefinitions="52,*,Auto">
                                <Border Width="44" Height="44"
                                        CornerRadius="15"
                                        Background="{DynamicResource AccentGradientBrush}"
                                        VerticalAlignment="Top">
                                    <Path Width="21" Height="21"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Fill="#FF081020"
                                          Stretch="Uniform"
                                          Data="M12,1 L14.2,7.8 L21,10 L14.2,12.2 L12,19 L9.8,12.2 L3,10 L9.8,7.8 Z M20,17 L21,20 L24,21 L21,22 L20,25 L19,22 L16,21 L19,20 Z" />
                                </Border>
                                <StackPanel Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Spacing="3">
                                    <TextBlock Text="{Binding TutorialEyebrow}"
                                               FontSize="10"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AccentBrush}" />
                                    <TextBlock Text="WitherChat"
                                               FontSize="13"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>
                                <Border Grid.Column="2"
                                        Padding="10,5"
                                        CornerRadius="12"
                                        Background="#18FFFFFF"
                                        BorderBrush="#30FFFFFF"
                                        BorderThickness="1"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OnboardingProgressText}"
                                               FontSize="11"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </Border>
                            </Grid>

                            <StackPanel x:Name="OnboardingAnimatedContent"
                                        Spacing="17"
                                        RenderTransformOrigin="50%,50%">
                                <StackPanel Spacing="9">
                                    <TextBlock x:Name="OnboardingTitleText" Text="{Binding OnboardingTitle}"
                                               FontSize="25"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap"
                                               LineHeight="30" />
                                    <TextBlock Text="{Binding OnboardingDescription}"
                                               FontSize="13"
                                               LineHeight="20"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource SecondaryTextBrush}" />
                                </StackPanel>

                                <Border Padding="13,11"
                                        CornerRadius="14"
                                        Background="#149A8CFF"
                                        BorderBrush="#389A8CFF"
                                        BorderThickness="1">
                                    <Grid ColumnDefinitions="18,*">
                                        <Ellipse Width="7" Height="7"
                                                 Fill="{DynamicResource AccentBrush}"
                                                 VerticalAlignment="Center"
                                                 HorizontalAlignment="Center" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding OnboardingHint}"
                                                   FontSize="11.5"
                                                   LineHeight="17"
                                                   TextWrapping="Wrap"
                                                   Foreground="{DynamicResource SecondaryTextBrush}" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                        </ScrollViewer>
                        <StackPanel x:Name="OnboardingFixedFooter" Grid.Row="1" Margin="26,17,26,24" Spacing="17">
                            <ProgressBar Classes="onboarding-progress"
                                         Minimum="0"
                                         Maximum="{Binding OnboardingTotalSteps}"
                                         Value="{Binding OnboardingStepNumber}" />

                            <Grid x:Name="OnboardingActionsPanel"
                                  ColumnDefinitions="Auto,*,Auto,10,Auto">
                                <Button x:Name="OnboardingSkipButton"
                                        Grid.Column="0"
                                        AutomationProperties.AutomationId="OnboardingSkipButton"
                                        Classes="ghost"
                                        MinHeight="38"
                                        Padding="8,7"
                                        Content="{Binding TutorialCloseLabel}"
                                        Command="{Binding SkipOnboardingCommand}" />
                                <Button x:Name="OnboardingBackButton"
                                        Grid.Column="2"
                                        AutomationProperties.AutomationId="OnboardingBackButton"
                                        Classes="onboarding-secondary"
                                        IsVisible="{Binding CanGoBackInOnboarding}"
                                        Content="{Binding Texts.OnboardingBack}"
                                        Command="{Binding PreviousOnboardingCommand}" />
                                <Button x:Name="OnboardingNextButton"
                                        Grid.Column="4"
                                        AutomationProperties.AutomationId="OnboardingNextButton"
                                        Classes="primary"
                                        MinWidth="132"
                                        MinHeight="38"
                                        Command="{Binding NextOnboardingCommand}">
                                    <TextBlock Text="{Binding OnboardingNextLabel}"
                                               TextWrapping="Wrap"
                                               TextAlignment="Center" />
                                </Button>
                                <TextBlock x:Name="OnboardingShortProgress"
                                           Grid.Row="2" Grid.Column="2"
                                           Text="{Binding OnboardingProgressText}"
                                           IsVisible="False" IsHitTestVisible="False"
                                           HorizontalAlignment="Right" VerticalAlignment="Center"
                                           FontSize="11" Foreground="{DynamicResource SecondaryTextBrush}" />
                            </Grid>
                        </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

    </Grid>
</Window>
