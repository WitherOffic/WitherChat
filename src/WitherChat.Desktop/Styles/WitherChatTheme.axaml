    </Style>
    <Style Selector="Button.support-wallet.ton:pointerover">
        <Setter Property="Background" Value="#300092FF" />
        <Setter Property="BorderBrush" Value="#A00092FF" />
    </Style>
    <Style Selector="Button.support-wallet.bsc">
        <Setter Property="Background" Value="#18F0B90B" />
        <Setter Property="BorderBrush" Value="#60F0B90B" />
