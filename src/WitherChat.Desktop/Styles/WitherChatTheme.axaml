    <Style Selector="Button.moderation-tab.selected">
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0B0D12" />
    </Style>

    <Style Selector="Button.connect-channel-tab">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="Button.connect-channel-tab.selected">
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="#0B0D12" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="15,8" />
