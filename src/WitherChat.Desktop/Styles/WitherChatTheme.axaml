<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#07090F" Offset="0" />
                        <GradientStop Color="#0B0E17" Offset="0.52" />
                        <GradientStop Color="#05070C" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#D0101420</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceRaisedBrush">#B8131824</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceHoverBrush">#5A2A3347</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderBrush">#2BFFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderStrongBrush">#55FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryTextBrush">#F7F8FF</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryTextBrush">#AEB4C4</SolidColorBrush>
                    <SolidColorBrush x:Key="MutedTextBrush">#7F879A</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentBrush">#9F8CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentHoverBrush">#A88CFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SelectionBrush">#5A2A3347</SolidColorBrush>
                    <SolidColorBrush x:Key="ComposerBrush">#B8131824</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonBrush">#2AFFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonHoverBrush">#42FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonPressedBrush">#24FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDisabledBrush">#12FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="JumpLatestGlassBrush">#14FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="JumpLatestGlassHoverBrush">#24FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="JumpLatestGlassBorderBrush">#45FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="InputBrush">#22FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="InputFocusedBrush">#33FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessBrush">#6FE7B4</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBrush">#FF6B7A</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBrush">#F6C85F</SolidColorBrush>
                    <SolidColorBrush x:Key="DonationAccentBrush">#FF9D45</SolidColorBrush>
                    <SolidColorBrush x:Key="DonationAccentSoftBrush">#FFAA65</SolidColorBrush>
                    <SolidColorBrush x:Key="PopupBrush">#F00C101A</SolidColorBrush>
                    <LinearGradientBrush x:Key="OnboardingGlassBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FA151929" Offset="0" />
                        <GradientStop Color="#F7121524" Offset="0.52" />
                        <GradientStop Color="#FA101725" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#A88CFF" Offset="0" />
                        <GradientStop Color="#6CB6FF" Offset="0.58" />
                        <GradientStop Color="#7AF0D2" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <LinearGradientBrush x:Key="AppBackgroundBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#F4F5FA" Offset="0" />
                        <GradientStop Color="#ECEFF6" Offset="0.52" />
                        <GradientStop Color="#F7F8FC" Offset="1" />
                    </LinearGradientBrush>
                    <SolidColorBrush x:Key="SurfaceBrush">#EFFFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceRaisedBrush">#DDF7F8FC</SolidColorBrush>
                    <SolidColorBrush x:Key="SurfaceHoverBrush">#BFDDE2ED</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderBrush">#2B111827</SolidColorBrush>
                    <SolidColorBrush x:Key="BorderStrongBrush">#55111827</SolidColorBrush>
                    <SolidColorBrush x:Key="PrimaryTextBrush">#10131B</SolidColorBrush>
                    <SolidColorBrush x:Key="SecondaryTextBrush">#4F586B</SolidColorBrush>
                    <SolidColorBrush x:Key="MutedTextBrush">#596275</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentBrush">#745DE8</SolidColorBrush>
                    <SolidColorBrush x:Key="AccentHoverBrush">#654DD5</SolidColorBrush>
                    <SolidColorBrush x:Key="SelectionBrush">#D7DDF0</SolidColorBrush>
                    <SolidColorBrush x:Key="ComposerBrush">#E8FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonBrush">#18111827</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonHoverBrush">#26111827</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonPressedBrush">#12111827</SolidColorBrush>
                    <SolidColorBrush x:Key="ButtonDisabledBrush">#12111827</SolidColorBrush>
                    <SolidColorBrush x:Key="JumpLatestGlassBrush">#10111827</SolidColorBrush>
                    <SolidColorBrush x:Key="JumpLatestGlassHoverBrush">#20111827</SolidColorBrush>
                    <SolidColorBrush x:Key="JumpLatestGlassBorderBrush">#40111827</SolidColorBrush>
                    <SolidColorBrush x:Key="InputBrush">#16FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="InputFocusedBrush">#24FFFFFF</SolidColorBrush>
                    <SolidColorBrush x:Key="SuccessBrush">#16805E</SolidColorBrush>
                    <SolidColorBrush x:Key="DangerBrush">#B4233C</SolidColorBrush>
                    <SolidColorBrush x:Key="WarningBrush">#765400</SolidColorBrush>
                    <SolidColorBrush x:Key="DonationAccentBrush">#A43B00</SolidColorBrush>
                    <SolidColorBrush x:Key="DonationAccentSoftBrush">#923100</SolidColorBrush>
                    <SolidColorBrush x:Key="PopupBrush">#F8FFFFFF</SolidColorBrush>
                    <LinearGradientBrush x:Key="OnboardingGlassBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#FAFFFFFF" Offset="0" />
                        <GradientStop Color="#F6F6F8FF" Offset="0.52" />
                        <GradientStop Color="#FAF5FBFF" Offset="1" />
                    </LinearGradientBrush>
                    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#8D73F4" Offset="0" />
                        <GradientStop Color="#5B93E7" Offset="0.58" />
                        <GradientStop Color="#55C9AE" Offset="1" />
                    </LinearGradientBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <Style Selector="Window.wither-window">
        <Setter Property="Background" Value="{DynamicResource AppBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button, TextBox, ComboBox, NumericUpDown, CheckBox, ToggleSwitch">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="CheckBox.settings-check">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="18,8,*" MinHeight="20">
                    <Border Name="CheckIndicator"
                            Width="18" Height="18"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            CornerRadius="5"
                            UseLayoutRounding="True"
                            Background="#22FFFFFF"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Path Name="CheckGlyph"
                              Width="10" Height="8"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              Data="M 1,4.5 L 4.25,7.75 L 11,1"
                              Stroke="#10131C"
                              StrokeThickness="1.7"
                              StrokeLineCap="Round"
                              StrokeJoin="Round"
                              Stretch="Fill"
                              UseLayoutRounding="True"
                              IsVisible="False" />
                    </Border>
                    <ContentPresenter Grid.Column="2"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <Style Selector="CheckBox.settings-check:pointerover /template/ Border#CheckIndicator">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    </Style>

    <Style Selector="CheckBox.settings-check:checked /template/ Border#CheckIndicator">
        <Setter Property="Background" Value="{DynamicResource AccentGradientBrush}" />
        <Setter Property="BorderBrush" Value="#80FFFFFF" />
    </Style>

    <Style Selector="CheckBox.settings-check:checked /template/ Path#CheckGlyph">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <Style Selector="CheckBox.settings-check:disabled">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
    </Style>

    <Style Selector="Border.subtle-card">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <Style Selector="Border.composer-panel">
        <Setter Property="CornerRadius" Value="20" />
    </Style>

    <Style Selector="Border.status-pill">
        <Setter Property="Background" Value="#18FFFFFF" />
        <Setter Property="BorderBrush" Value="#2CFFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="Padding" Value="9,5" />
    </Style>

    <Style Selector="Border.status-strip">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="15" />
        <Setter Property="Padding" Value="9,5" />
    </Style>

    <Style Selector="Border.header-tools-strip">
        <Setter Property="Background" Value="{DynamicResource SurfaceRaisedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="19" />
        <Setter Property="Padding" Value="3" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="15,8" />
        <Setter Property="CornerRadius" Value="17" />
        <Setter Property="Background" Value="{DynamicResource ButtonBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="RenderTransformOrigin" Value="50%,50%" />
        <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
        <Setter Property="RenderTransform" Value="translate(0px, -1px) scale(1)" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
        <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(0.975)" />
    </Style>

    <Style Selector="Button:disabled">
        <Setter Property="Background" Value="{DynamicResource ButtonDisabledBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
        <Setter Property="Opacity" Value="0.56" />
    </Style>

    <Style Selector="Button.icon-button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}" />
        <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.22" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Button.icon-button:pointerover">
        <Setter Property="RenderTransform" Value="translate(0px, -2px) scale(1)" />
    </Style>

    <Style Selector="Button.icon-button:pressed">
        <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(0.975)" />
    </Style>

    <Style Selector="Border.header-tools-strip Button.icon-button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <Style Selector="Border.header-tools-strip Button.icon-button:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>

    <Style Selector="FlyoutPresenter.header-tools-flyout">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style Selector="Button.header-overflow-item">
        <Setter Property="Height" Value="44" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="MinWidth" Value="232" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}" />
    </Style>

    <Style Selector="Button.header-overflow-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource JumpLatestGlassHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JumpLatestGlassBorderBrush}" />
    </Style>

    <Style Selector="Button.header-overflow-item:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
    </Style>

    <Style Selector="Button.context-help">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinWidth" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource JumpLatestGlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JumpLatestGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.context-help:pointerover">
        <Setter Property="Background" Value="{DynamicResource JumpLatestGlassHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <Style Selector="Button.icon-button.log-close">
        <Setter Property="Background" Value="#18FF5C70" />
        <Setter Property="BorderBrush" Value="#55FF5C70" />
        <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.icon-button.log-close:pointerover">
        <Setter Property="Background" Value="#30FF5C70" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>

    <Style Selector="Button.jump-latest">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="MinWidth" Value="40" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.jump-latest.compact">
        <Setter Property="Background" Value="{DynamicResource JumpLatestGlassBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JumpLatestGlassBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <Style Selector="Button.jump-latest.compact:pointerover">
        <Setter Property="Background" Value="{DynamicResource JumpLatestGlassHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JumpLatestGlassBorderBrush}" />
    </Style>

    <Style Selector="Button.jump-latest.compact:pressed">
        <Setter Property="Background" Value="{DynamicResource JumpLatestGlassHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource JumpLatestGlassBorderBrush}" />
    </Style>

    <Style Selector="Window.reduce-motion Button.icon-button">
        <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)" />
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <Style Selector="Window.reduce-motion Button">
        <Setter Property="RenderTransform" Value="translate(0px, 0px) scale(1)" />
        <Setter Property="Transitions">
            <Transitions />
        </Setter>
    </Style>

    <Style Selector="Button.header-account">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="4,3" />
        <Setter Property="Margin" Value="-4,0,10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.settings-nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.settings-nav.selected">
        <Setter Property="Background" Value="#171A24" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Foreground" Value="#F7F8FF" />
    </Style>

    <Style Selector="Button.moderation-tab">
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
