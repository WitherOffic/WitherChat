    <Style Selector="Button.support-brand.twitch">
        <Setter Property="Background" Value="#209146FF" />
        <Setter Property="BorderBrush" Value="#709146FF" />
    </Style>
    <Style Selector="Button.support-brand.twitch:pointerover">
        <Setter Property="Background" Value="#389146FF" />
        <Setter Property="BorderBrush" Value="#B09146FF" />
