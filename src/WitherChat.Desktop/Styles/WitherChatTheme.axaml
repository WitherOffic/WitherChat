    <Style Selector="Button.support-brand.youtube">
        <Setter Property="Background" Value="#20FF0000" />
        <Setter Property="BorderBrush" Value="#70FF0000" />
    </Style>
    <Style Selector="Button.support-brand.youtube:pointerover">
        <Setter Property="Background" Value="#38FF0000" />
        <Setter Property="BorderBrush" Value="#B0FF0000" />
    </Style>

    <Style Selector="Button.support-brand.steam">
        <Setter Property="Background" Value="#202A475E" />
        <Setter Property="BorderBrush" Value="#7090B7D3" />
    </Style>
    <Style Selector="Button.support-brand.steam:pointerover">
        <Setter Property="Background" Value="#38466C87" />
        <Setter Property="BorderBrush" Value="#B090B7D3" />
    </Style>

    <Style Selector="Button.support-brand.telegram">
        <Setter Property="Background" Value="#202AABEE" />
        <Setter Property="BorderBrush" Value="#702AABEE" />
    </Style>
    <Style Selector="Button.support-brand.telegram:pointerover">
        <Setter Property="Background" Value="#382AABEE" />
        <Setter Property="BorderBrush" Value="#B02AABEE" />
    </Style>

    <Style Selector="Button.support-wallet">
        <Setter Property="Height" Value="64" />
        <Setter Property="MinHeight" Value="64" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    </Style>
    <Style Selector="Button.support-wallet.tron">
        <Setter Property="Background" Value="#18DC062B" />
