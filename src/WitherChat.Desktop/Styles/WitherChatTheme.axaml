    <Style Selector="ComboBox:dropdownopen /template/ Border#PopupBorder">
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="ClipToBounds" Value="True" />
        <Setter Property="BoxShadow" Value="0 10 28 0 #80000000" />
