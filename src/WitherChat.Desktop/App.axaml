<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="WitherChat.Desktop.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <FontFamily x:Key="AppFontFamily">avares://WitherChat/Assets/Fonts#Inter</FontFamily>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://WitherChat/Styles/WitherChatTheme.axaml" />
    </Application.Styles>
</Application>
